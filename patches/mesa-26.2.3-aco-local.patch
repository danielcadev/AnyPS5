+
+static nir_variable *
+build_wrapper_loop_with_output_store(nir_builder *bld)
+{
+   nir_variable *out =
+      nir_variable_create(bld->shader, nir_var_shader_out, glsl_int_type(),
+                          "wrapper_loop_output");
+
+   nir_loop *loop = nir_push_loop(bld);
+   nir_store_var(bld, out, nir_imm_int(bld, 42), 1);
+   nir_jump(bld, nir_jump_break);
+   nir_pop_loop(bld, loop);
+
+   return out;
+}
+
+static void
+expect_wrapper_loop_contents(nir_function_impl *impl, nir_variable *out,
+                             bool expect_loop)
+{
+   unsigned store_count = 0;
+   unsigned break_count = 0;
+   bool saw_value = false;
+   bool saw_output_address = false;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic != nir_intrinsic_store_deref)
+               continue;
+
+            nir_deref_instr *deref = nir_src_as_deref(intrin->src[0]);
+            if (nir_deref_instr_get_variable(deref) != out)
+               continue;
+
+            store_count++;
+            saw_output_address = true;
+            saw_value |= nir_src_is_const(intrin->src[1]) &&
+                         nir_src_as_int(intrin->src[1]) == 42;
+         } else if (instr->type == nir_instr_type_jump &&
+                    nir_instr_as_jump(instr)->type == nir_jump_break) {
+            break_count++;
+         }
+      }
+   }
+
+   EXPECT_EQ(store_count, 1);
+   EXPECT_TRUE(saw_output_address);
+   EXPECT_TRUE(saw_value);
+   EXPECT_EQ(break_count, expect_loop ? 1u : 0u);
 }
 

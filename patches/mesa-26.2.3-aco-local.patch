+TEST_F(nir_loop_unroll_test, wrapper_unroll_skipped_above_ssa_alloc_limit)
+{
+   nir_variable *out = build_wrapper_loop_with_output_store(&bld);
+   nir_validate_shader(bld.shader, "before wrapper unroll above SSA limit");
+
+   nir_shader_compiler_options options = *bld.shader->options;
+   options.force_indirect_unrolling = static_cast<nir_variable_mode>(0);
+   options.force_indirect_unrolling_sampler = false;
+   bld.shader->options = &options;
+
+   bld.impl->ssa_alloc = (1u << 20) + 1;
+
+   EXPECT_FALSE(nir_opt_loop_unroll(bld.shader));
+   EXPECT_EQ(count_loops(), 1);
+   expect_wrapper_loop_contents(bld.impl, out, true);
+   nir_validate_shader(bld.shader, "after wrapper unroll above SSA limit");
+}

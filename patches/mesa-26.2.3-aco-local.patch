+TEST_F(nir_loop_unroll_test, wrapper_unroll_at_ssa_alloc_limit)
+{
+   nir_variable *out = build_wrapper_loop_with_output_store(&bld);
+   nir_validate_shader(bld.shader, "before wrapper unroll at SSA limit");
+
+   nir_shader_compiler_options options = *bld.shader->options;
+   options.force_indirect_unrolling = static_cast<nir_variable_mode>(0);
+   options.force_indirect_unrolling_sampler = false;
+   bld.shader->options = &options;
+
+   /* The allocator may have holes; this models a large valid SSA index space
+    * without allocating millions of instructions in a unit test.
+    */
+   bld.impl->ssa_alloc = 1u << 20;
+
+   EXPECT_TRUE(nir_opt_loop_unroll(bld.shader));
+   EXPECT_EQ(count_loops(), 0);
+   expect_wrapper_loop_contents(bld.impl, out, false);
+   nir_validate_shader(bld.shader, "after wrapper unroll at SSA limit");
+}

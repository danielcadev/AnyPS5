+        stencilStorage = std::move(stencil);
+        depthAllocation = depthRange;
+        stencilAllocation = stencilRange;
+        depthVersion = depthStorage->Version();
+        stencilVersion = stencilStorage->Version();
+    }
+
+    void PublishResizedClears(VkImageAspectFlags cleared) {
+        if ((cleared & VK_IMAGE_ASPECT_DEPTH_BIT) != 0) {
+            depthStorage->MarkDirty();
+            depthVersion = depthStorage->Version();
+        }
+        if ((cleared & VK_IMAGE_ASPECT_STENCIL_BIT) != 0) {
+            stencilStorage->MarkDirty();
+            stencilVersion = stencilStorage->Version();
+        }
+    }
+
+    void RetireForResize() {
+        ReleasePlaneExtentStorage(depthExtentStorage);
+        ReleasePlaneExtentStorage(stencilExtentStorage);
+        for (const auto& [key, texture] : textures) texture->MarkReleased();
+        textures.clear();
+        depthStorage.reset();
+        stencilStorage.reset();
+        depthAllocation.reset();
+        stencilAllocation.reset();
+        depthVersion = 0;
+        stencilVersion = 0;
+        ClearColorOwner("depth-resize");
+        retired = true;
+    }

+
+template<typename TMatch>
+bool EitherOrder(const IrValue* value, TMatch&& match) {
+    return match(Resolved(value->Argument(0)), Resolved(value->Argument(1))) || match(Resolved(value->Argument(1)), Resolved(value->Argument(0)));

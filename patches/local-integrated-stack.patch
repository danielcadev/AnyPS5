+template <typename TEmit>
+std::uint32_t RuntimeFormatSwitch(SpirvEmitterState& state, std::uint32_t selector, std::uint32_t type, std::uint32_t zero, const std::vector<std::uint32_t>& keys, const TEmit& emit) {
+    const auto fallback = state.module.AllocateId();
+    const auto merge = state.module.AllocateId();
+    std::vector<std::uint32_t> labels(keys.size());
+    std::vector<std::uint32_t> words{spv::OpSwitch, selector, fallback};
+    for (std::size_t i = 0; i < keys.size(); ++i) {
+        labels[i] = state.module.AllocateId();
+        words.insert(words.end(), {keys[i], labels[i]});
+    }
+    state.module.AddFunction(spv::OpSelectionMerge, merge, spv::SelectionControlMaskNone);
+    state.module.AddFunction(words);
+    const auto result = state.module.AllocateId();
+    std::vector<std::uint32_t> phi{spv::OpPhi, type, result};
+    for (std::size_t i = 0; i < keys.size(); ++i) {
+        EmitLabel(state, labels[i]);
+        const auto value = emit(i);
+        phi.insert(phi.end(), {value, state.currentLabel});
+        state.module.AddFunction(spv::OpBranch, merge);
+    }
+    EmitLabel(state, fallback);
+    phi.insert(phi.end(), {zero, fallback});
+    state.module.AddFunction(spv::OpBranch, merge);
+    EmitLabel(state, merge);
+    state.module.AddFunction(phi);
+    return result;
+}

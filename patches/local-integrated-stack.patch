+#ifndef _WIN32
+namespace {
+constexpr std::size_t scatterPiece = 65536;
+std::byte* scatterBase = nullptr;
+int scatterFile = -1;
+constexpr std::array<std::size_t, 3> scatterOrder{2, 0, 1};
+
+bool resolveScatterRuns(std::uintptr_t address, std::size_t bytes, int* file,
+                        GuestArena::SharedBackingRun* runs, std::size_t capacity, std::size_t* count) {
+    if (scatterBase == nullptr || file == nullptr || runs == nullptr || count == nullptr) return false;
+    *count = 0;
+    const auto base = reinterpret_cast<std::uintptr_t>(scatterBase);
+    if (address < base || bytes == 0 || address - base >= 3 * scatterPiece || bytes > 3 * scatterPiece - (address - base)) return false;
+    auto cursor = address - base;
+    const auto end = cursor + bytes;
+    std::size_t filled = 0;
+    while (cursor < end) {
+        if (filled == capacity) return false;
+        const auto index = cursor / scatterPiece;
+        const auto within = cursor % scatterPiece;
+        const auto length = std::min(end - cursor, scatterPiece - within);
+        runs[filled++] = {scatterOrder[index] * scatterPiece + within, length};
+        cursor += length;
+    }
+    const int duplicate = fcntl(scatterFile, F_DUPFD_CLOEXEC, 0);
+    if (duplicate < 0) return false;
+    *file = duplicate;
+    *count = filled;
+    return true;
+}
+
+bool resolveScatterLinear(std::uintptr_t address, std::size_t bytes, int* file, std::uint64_t* offset) {
+    GuestArena::SharedBackingRun run{};
+    std::size_t count = 0;
+    if (!resolveScatterRuns(address, bytes, file, &run, 1, &count)) return false;
+    *offset = run.offset;
+    return true;
+}

+    for (const auto byte : storedStencil)
+        Require(std::to_integer<std::uint8_t>(byte) == 0xa5,
+                "depth/stencil bridge: surface retirement lost the latest R8 stencil writes");
+    const auto guestStencil = std::span<const std::byte>(guest.data() + (secondStencilAddress - base), stencilBytes);
+    for (const auto byte : guestStencil)
+        Require(std::to_integer<std::uint8_t>(byte) == 0xa5,
+                "depth/stencil bridge: retired latest R8 stencil did not reach guest memory");
+    const auto physicalGuestStencil = std::span<const std::byte>(guest.data() + (firstStencilAddress - base), stencilBytes);
+    // Guest bytes use Z64KBX tiling; the R8 readback above is linear. Their values and written
+    // fragment count must match even though the line occupies different byte positions.
+    Require(std::count(physicalGuestStencil.begin(), physicalGuestStencil.end(), std::byte{3}) == lineFragments &&
+                std::count(physicalGuestStencil.begin(), physicalGuestStencil.end(), std::byte{1}) == stencilBytes - lineFragments,
+            "depth/stencil bridge: physical stencil owner publication did not reach guest memory");
+
+    recorder.Sync();
+    ClearCachedTextures(context.device);
+    ClearCachedPipelines(context.device);
+    outerRecorder.Activate();
+}
+
+void htileClearTests(const Device& device, Recorder& outerRecorder, std::unique_lock<AgcDriver::GuestMemory::GpuMutexType>& gpu) {
+    outerRecorder.Sync();
+    constexpr VkExtent2D extent{256, 256};
+    constexpr std::size_t depthBytes = extent.width * extent.height * sizeof(float);
+    constexpr std::size_t stencilBytes = extent.width * extent.height;
+    constexpr std::uint32_t expanded = 0xffffffffu;
+    constexpr std::uint32_t depthClear = 0x000003f0u; // Zmask=0, SMem=3, SR0=SR1=3, min/max Z=0.
+    const auto metadataBytes = static_cast<std::size_t>(HtileMetadataBytes(extent));
+    Require(metadataBytes != 0 && metadataBytes % sizeof(std::uint32_t) == 0,
+            "HTILE fixture has an invalid full metadata allocation size");
+    Require(HtileFillClears(depthClear, true) == VK_IMAGE_ASPECT_DEPTH_BIT && HtileFillClears(expanded, true) == 0,
+            "HTILE fixture words do not describe depth-only clear and expanded states");
+    const auto align64K = [](std::size_t bytes) { return (bytes + 65535u) & ~std::size_t{65535u}; };
+    const auto stencilOffset = align64K(DepthSliceBytes(extent, sizeof(float)));
+    const auto metadataOffset = align64K(stencilOffset + DepthSliceBytes(extent, 1));
+    const auto surfaceAllocation = align64K(metadataOffset + metadataBytes);
+    DepthStencilGuestBlock guest(surfaceAllocation * 2u);
+    auto context = device.GetContext();
+    DescriptorCache descriptors(context);
+    context.descriptorCache = &descriptors;
+    TextureDetiler detiler(context);
+    context.detiler = &detiler;
+    depthCaptureDeviceProc = context.deviceProc;
+    context.deviceProc = &captureDepthDeviceProc;
+    Recorder recorder(context);
+    recorder.Activate();
+    const auto base = reinterpret_cast<std::uint64_t>(guest.data());
+    const auto targetFor = [&](std::uint64_t address) {
+        DepthTarget target{address, address + stencilOffset, extent, VK_FORMAT_D32_SFLOAT_S8_UINT, 0.875f, 0x35};
+        target.htileAddress = address + metadataOffset;
+        target.htileStencil = true;
+        return target;
+    };
+    const auto fillMetadata = [&](const DepthTarget& target, std::uint32_t fill) {
+        recorder.Sync();
+        std::fill_n(reinterpret_cast<std::uint32_t*>(target.htileAddress), metadataBytes / sizeof(std::uint32_t), fill);
+        AgcDriver::GuestMemory::MarkWritten(target.htileAddress, metadataBytes);
+        AgcDriver::GuestMemory::BumpCollectEpoch();
+    };
+    const auto expectDepth = [&](VkImage image, VkImageAspectFlags aspect, float expected, const char* reason) {
+        const auto bytes = readStencilImage(context, device, recorder, image, aspect, extent, depthBytes);
+        for (std::size_t offset = 0; offset < bytes.size(); offset += sizeof(float)) {
+            float actual = 0;
+            std::memcpy(&actual, bytes.data() + offset, sizeof(actual));
+            Require(actual == expected, reason);
+        }
+    };
+    const auto expectStencil = [&](VkImage image, VkImageAspectFlags aspect, std::uint8_t expected, const char* reason) {
+        const auto bytes = readStencilImage(context, device, recorder, image, aspect, extent, stencilBytes);
+        for (const auto byte : bytes) Require(std::to_integer<std::uint8_t>(byte) == expected, reason);
+    };
+    const auto cleanup = [&] {
+        recorder.Sync();
+        gpu.unlock();
+        try {
+            ClearDepthSurfaces(context.device);
+        } catch (...) {
+            gpu.lock();
+            throw;
+        }
+        gpu.lock();
+        recorder.Sync();
+        ClearCachedTextures(context.device);
+        outerRecorder.Activate();
+    };
+    try {
+        auto target = targetFor(base);
+        fillMetadata(target, expanded);
+        const auto depthResource = depthStorageResource(target.address, extent.width, extent.height);
+        const auto stencil = stencilResource(target.stencilAddress, extent.width, extent.height);
+        const auto depthOwner = CachedStorageSurface(context, depthResource);
+        const auto stencilOwner = CachedStorageSurface(context, stencil);
+        clearDepthStorage(context, recorder, depthOwner, 0.5015f);
+        clearStencilStorage(context, recorder, stencilOwner, 0x5a);
+        capturedDepthImages.clear();
+        const auto view = DepthSurfaceView(context, target);
+        Require(!capturedDepthImages.empty(), "HTILE fixture did not create a native D32S8 image");
+        const auto native = capturedDepthImages.back();
+        Require(DepthSurfaceStorageTexture(context, depthResource, 0) == depthOwner &&
+                    DepthSurfaceStorageTexture(context, stencil, 0) == stencilOwner,
+                "HTILE fixture did not adopt its incoming R32/R8 owners");
+        expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.5015f, "expanded HTILE lost incoming depth data");
+        expectStencil(native, VK_IMAGE_ASPECT_STENCIL_BIT, 0x5a, "expanded HTILE lost incoming stencil data");
+
+        target.clearDepth = 0.0f;
+        for (unsigned attempt = 0; attempt < 2; ++attempt) {
+            if (attempt != 0) {
+                clearDepthStorage(context, recorder, depthOwner, 0.5015f);
+                Require(DepthSurfaceView(context, target) == view, "expanded HTILE replaced its native image");
+                expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.5015f,
+                            "HTILE repeated-clear fixture failed to restore a nonzero native depth");
+            }
+            fillMetadata(target, depthClear);
+            Require(DepthSurfaceView(context, target) == view, "HTILE clear replaced its native image");
+            expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.0f, "uniform HTILE did not clear reused native depth");
+            Require(DepthSurfaceStorageTexture(context, depthResource, 0) == depthOwner,
+                    "HTILE clear replaced its adopted R32 owner");
+            expectDepth(depthOwner->Image(), VK_IMAGE_ASPECT_COLOR_BIT, 0.0f,
+                        "uniform HTILE clear did not publish zero depth to the R32 owner");
+            expectStencil(native, VK_IMAGE_ASPECT_STENCIL_BIT, 0x5a, "depth-only HTILE clear changed native stencil");
+            expectStencil(stencilOwner->Image(), VK_IMAGE_ASPECT_COLOR_BIT, 0x5a, "depth-only HTILE clear changed its R8 owner");
+            const auto* metadata = reinterpret_cast<const std::uint32_t*>(target.htileAddress);
+            for (std::size_t word = 0; word < metadataBytes / sizeof(std::uint32_t); ++word)
+                Require((metadata[word] & 0x30fu) == 0x30fu, "consumed HTILE clear was not stored back expanded");
+            Require(DepthSurfaceView(context, target) == view, "expanded post-clear bind replaced native depth");
+            expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.0f, "post-clear bind reimported stale R32 depth");
+        }
+
+        clearDepthStorage(context, recorder, depthOwner, 0.25f);
+        fillMetadata(target, expanded);
+        static_cast<void>(DepthSurfaceView(context, target));
+        expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.25f, "expanded HTILE incorrectly requested another clear");
+        fillMetadata(target, depthClear);
+        auto* partial = reinterpret_cast<std::uint32_t*>(target.htileAddress);
+        partial[metadataBytes / sizeof(std::uint32_t) - 1u] = expanded;
+        AgcDriver::GuestMemory::MarkWritten(target.htileAddress, metadataBytes);
+        static_cast<void>(DepthSurfaceView(context, target));
+        expectDepth(native, VK_IMAGE_ASPECT_DEPTH_BIT, 0.25f, "mixed HTILE words incorrectly cleared the whole surface");
+
+        // A fresh depth-only clear must preserve the independently adopted R8 aspect too.
+        auto fresh = targetFor(base + surfaceAllocation);
+        fresh.clearDepth = 0.0f;
+        const auto freshDepth = depthStorageResource(fresh.address, extent.width, extent.height);
+        const auto freshStencil = stencilResource(fresh.stencilAddress, extent.width, extent.height);
+        const auto freshDepthOwner = CachedStorageSurface(context, freshDepth);
+        const auto freshOwner = CachedStorageSurface(context, freshStencil);
+        clearDepthStorage(context, recorder, freshDepthOwner, 0.625f);
+        clearStencilStorage(context, recorder, freshOwner, 0xa5);
+        fillMetadata(fresh, depthClear);
+        auto incompatible = context;
+        incompatible.limits.maxFramebufferWidth = extent.width - 1u;
+        bool rejected = false;
+        try {
+            static_cast<void>(DepthSurfaceView(incompatible, fresh));
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("depth target exceeds framebuffer limits") != std::string_view::npos,
+                    "HTILE fixture rejected the incompatible bind for an unexpected reason");
+            rejected = true;
+        }
+        Require(rejected, "HTILE fixture accepted a target beyond the bind context's framebuffer limits");
+        const auto* unconsumed = reinterpret_cast<const std::uint32_t*>(fresh.htileAddress);
+        for (std::size_t word = 0; word < metadataBytes / sizeof(std::uint32_t); ++word)
+            Require(unconsumed[word] == depthClear, "failed depth bind consumed its HTILE clear metadata");
+        Require(StorageImageCached(context, freshDepthOwner.get()) && StorageImageCached(context, freshOwner.get()),
+                "failed depth bind consumed an incoming R32/R8 owner");
+        capturedDepthImages.clear();
+        static_cast<void>(DepthSurfaceView(context, fresh));
+        Require(!capturedDepthImages.empty(), "fresh HTILE fixture did not create native depth");
+        expectDepth(capturedDepthImages.back(), VK_IMAGE_ASPECT_DEPTH_BIT, 0.0f, "fresh HTILE clear did not initialize native depth");
+        expectStencil(capturedDepthImages.back(), VK_IMAGE_ASPECT_STENCIL_BIT, 0xa5,
+                      "fresh depth-only HTILE clear changed an incoming stencil owner");
+        Require(DepthSurfaceStorageTexture(context, freshStencil, 0) == freshOwner,
+                "fresh HTILE clear replaced its incoming R8 owner");
+        Require(DepthSurfaceStorageTexture(context, freshDepth, 0) == freshDepthOwner,
+                "fresh HTILE clear replaced its incoming R32 owner");
+        expectDepth(freshDepthOwner->Image(), VK_IMAGE_ASPECT_COLOR_BIT, 0.0f,
+                    "fresh HTILE clear adopted stale R32 data instead of publishing the clear");
+        static_cast<void>(DepthSurfaceView(context, fresh));
+        expectDepth(capturedDepthImages.back(), VK_IMAGE_ASPECT_DEPTH_BIT, 0.0f,
+                    "fresh HTILE clear reimported its old incoming R32 data on rebind");
+    } catch (...) {
+        cleanup();
+        throw;
+    }
+    cleanup();
+    std::cout << "uniform HTILE clear/repeat, expanded/mixed metadata, and native R32/R8 owner coherence passed\n";
+}
+
+void depthR32BridgeTests(const Device& device, Recorder& outerRecorder, std::unique_lock<AgcDriver::GuestMemory::GpuMutexType>& gpu) {
+    outerRecorder.Sync();
+    const bool large = std::getenv("APS5_TEST_DEPTH_STORAGE_LARGE1") != nullptr;
+    const std::uint32_t width = large ? 3840u : 256u;
+    const std::uint32_t height = large ? 2160u : 256u;
+    const std::size_t planeBytes = static_cast<std::size_t>(width) * height * 4u;
+    const std::size_t stencilBytes = static_cast<std::size_t>(width) * height;
+    DepthStencilGuestBlock guest(large ? 256u * 1024u * 1024u : 2u * 1024u * 1024u);
+    const auto planeOffset = large ? 64u * 1024u * 1024u : 512u * 1024u;
+    auto context = device.GetContext();
+    DescriptorCache descriptors(context);
+    context.descriptorCache = &descriptors;
+    TextureDetiler detiler(context);
+    context.detiler = &detiler;
+    depthCaptureDeviceProc = context.deviceProc;
+    context.deviceProc = &captureDepthDeviceProc;
+    // Fixture-owned descriptor allocations and detiler references must drain before their owners
+    // are destroyed, even when a physical-depth Draw rejects.
+    Recorder recorder(context);
+    recorder.Activate();
+    const auto base = reinterpret_cast<std::uintptr_t>(guest.data());
+    const auto incomingAddress = base;
+    const auto incomingStencilAddress = base + planeOffset;
+    const auto incomingTarget = DepthTarget{incomingAddress, incomingStencilAddress, {width, height}, VK_FORMAT_D32_SFLOAT_S8_UINT, 0.375f, 0x35};
+    const auto incomingDepth = depthStorageResource(incomingAddress, width, height);
+    std::fill_n(guest.data() + (incomingStencilAddress - base), stencilBytes, std::byte{0xc7});
+    auto incoming = CachedStorageSurface(context, incomingDepth);
+    Require(incoming != nullptr && incoming->StorageFormat() == VK_FORMAT_R32_SFLOAT && StorageImageCached(context, incoming.get()),
+            "R32 depth bridge: exact incoming R32_SFLOAT owner was not in the storage cache");
+    clearDepthStorage(context, recorder, incoming, 0.2f);
+    capturedDepthImages.clear();
+    static_cast<void>(DepthSurfaceView(context, incomingTarget));
+    Require(!StorageImageCached(context, incoming.get()), "R32 depth bridge: adopted depth owner remained in the ordinary cache");
+    Require(DepthSurfaceStorageTexture(context, incomingDepth, 0) == incoming,
+            "R32 depth bridge: bind did not retain the exact incoming depth owner");
+    Require(!capturedDepthImages.empty(), "R32 depth bridge: no combined depth/stencil image was captured");
+    ClearCachedTextures(context.device);
+    Require(DepthSurfaceStorageTexture(context, incomingDepth, 0) == incoming,
+            "R32 depth bridge: cache clearing released the adopted depth owner");
+    const auto incomingImage = capturedDepthImages.back();
+    auto readPlane = [&](VkImage image, VkImageAspectFlags aspect, std::size_t bytes) {
+        return readStencilImage(context, device, recorder, image, aspect, {width, height}, bytes);
+    };
+    auto expectFloatValue = [&](std::span<const std::byte> bytes, float expected, const char* reason) {
+        Require(bytes.size() % sizeof(float) == 0, "R32 depth bridge: malformed float readback");
+        for (std::size_t offset = 0; offset < bytes.size(); offset += sizeof(float)) {
+            float actual = 0;
+            std::memcpy(&actual, bytes.data() + offset, sizeof(actual));
+            Require(actual == expected, reason);
+        }
+    };
+    const auto expectTiledGuestFloatPlane = [&](const std::shared_ptr<StorageTexture>& storage, float expected, const char* reason) {
+        const auto& descriptor = storage->Descriptor();
+        const auto mip = ComputeElementMipLayout(descriptor.tileMode, 4, width, height, 1).front();
+        const auto block = ThinBlockLayout(descriptor.tileMode, 4);
+        const auto* equation = FindTextureSwizzleEquation(XorSwizzleMode(descriptor.tileMode), 4);
+        Require(equation != nullptr && !mip.tail, "R32 depth bridge: missing tiled guest layout for R32 writeback");
+        const auto guestTiledBytes = std::span<const std::byte>(guest.data() + (descriptor.baseAddress - base), static_cast<std::size_t>(mip.tiledSize));
+        for (std::uint32_t y = 0; y < height; ++y) for (std::uint32_t x = 0; x < width; ++x) {
+            std::uint64_t inBlock = 0;
+            for (std::uint32_t bit = 0; bit < 16; ++bit) {
+                const auto mask = equation->bits[bit];
+                const auto selected = (x & (mask & 0xfffu)) ^ ((y << 12u) & (mask & 0xfff000u));
+                inBlock |= static_cast<std::uint64_t>(std::popcount(selected) & 1u) << bit;
+            }
+            const auto offset = mip.tiledOffset + (static_cast<std::uint64_t>(y / block[2]) * mip.blocksPerRow + x / block[1]) * block[0] + inBlock;
+            float actual = 0;
+            std::memcpy(&actual, guestTiledBytes.data() + offset, sizeof(actual));
+            if (actual != expected) throw std::runtime_error(std::string(reason) + " at visible pixel (" + std::to_string(x) + ", " + std::to_string(y) + "), tiled byte offset " + std::to_string(offset) + ": " + std::to_string(actual));
+        }
+    };
+    expectFloatValue(readPlane(incomingImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.2f,
+                     "R32 depth bridge: incoming cache was discarded in favor of the target clear depth");
+    auto stencil = readPlane(incomingImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == incomingTarget.clearStencil,
+                "R32 depth bridge: incoming depth transfer changed the S8 aspect");
+
+    clearDepthStorage(context, recorder, incoming, 0.4f);
+    Require(DepthSurfaceStorageTexture(context, incomingDepth, 0) == incoming,
+            "R32 depth bridge: a later storage update replaced the incoming owner");
+    expectFloatValue(readPlane(incomingImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.4f,
+                     "R32 depth bridge: later R32 writes did not reach the physical depth aspect");
+    stencil = readPlane(incomingImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == incomingTarget.clearStencil,
+                "R32 depth bridge: later depth transfer changed the S8 aspect");
+
+    const auto ownedAddress = base + (large ? 128u * 1024u * 1024u : 1024u * 1024u);
+    const auto ownedStencilAddress = base + (large ? 192u * 1024u * 1024u : 1536u * 1024u);
+    const auto ownedTarget = DepthTarget{ownedAddress, ownedStencilAddress, {width, height}, VK_FORMAT_D32_SFLOAT_S8_UINT, 0.7f, 0x72};
+    const auto ownedDepth = depthStorageResource(ownedAddress, width, height);
+    capturedDepthImages.clear();
+    static_cast<void>(DepthSurfaceView(context, ownedTarget));
+    const auto ownedImage = capturedDepthImages.back();
+    std::array<std::uint32_t, 8> depthWords{};
+    depthWords[0] = static_cast<std::uint32_t>(ownedAddress >> 8);
+    const VkComponentMapping components{VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+                                        VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY};
+    const auto ordinarySample = DepthSurfaceTexture(context, depthWords, ownedDepth, components);
+    Require(ordinarySample != nullptr && ordinarySample->ViewFormat() == VK_FORMAT_D32_SFLOAT_S8_UINT &&
+                ordinarySample->SharedStorageSource() == nullptr,
+            "R32 depth bridge: ordinary depth sample before storage ownership stopped using the combined image");
+    const auto owned = DepthSurfaceStorageTexture(context, ownedDepth, 0);
+    Require(owned != nullptr && owned->StorageFormat() == VK_FORMAT_R32_SFLOAT,
+            "R32 depth bridge: depth bind did not create an R32 storage image");
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), ownedTarget.clearDepth,
+                     "R32 depth bridge: initial D32-to-R32 transfer lost the target clear depth");
+    const auto reboundSample = DepthSurfaceTexture(context, depthWords, ownedDepth, components);
+    Require(reboundSample != nullptr && reboundSample != ordinarySample && reboundSample->SharedStorageSource() == owned,
+            "R32 depth bridge: sampled depth did not switch to the owned R32 image after cache invalidation");
+    const auto comparisonSample = DepthSurfaceTexture(context, depthWords, ownedDepth, components, true);
+    Require(comparisonSample != nullptr && comparisonSample->ViewFormat() == VK_FORMAT_D32_SFLOAT_S8_UINT &&
+                comparisonSample->SharedStorageSource() == nullptr,
+            "R32 depth bridge: comparison sampling stopped using the physical D32 view");
+
+    // A readonly BDA lease must coexist with real physical depth writes. The fixture shader has
+    // the table/fault descriptors but performs no BDA read; Draw still builds and binds its lease.
+    constexpr std::array<std::uint32_t, 6> physicalVertexCode{
+        0xe0382000u, 0x80000005u, 0xbf8c3f70u, 0xf80008cfu, 0x03020100u, 0xbf810000u,
+    };
+    constexpr std::array<std::array<float, 4>, 3> physicalVertices{{
+        {-1.0f, -1.0f, 0.25f, 1.0f}, {3.0f, -1.0f, 0.25f, 1.0f}, {-1.0f, 3.0f, 0.25f, 1.0f},
+    }};
+    const auto physicalVertexAddress = base + (large ? 224u * 1024u * 1024u : 1792u * 1024u);
+    std::memcpy(reinterpret_cast<void*>(physicalVertexAddress), physicalVertices.data(), sizeof(physicalVertices));
+    const std::array<std::uint32_t, 4> physicalVertexData{
+        static_cast<std::uint32_t>(physicalVertexAddress),
+        static_cast<std::uint32_t>((physicalVertexAddress >> 32u) & 0xffffu) | (16u << 16u),
+        3u, 0x01016facu,
+    };
+    const std::array<ShaderRecompiler::MemoryRegion, 1> physicalVertexMemory{{
+        {reinterpret_cast<std::uintptr_t>(physicalVertexCode.data()), std::as_bytes(std::span(physicalVertexCode))},
+    }};
+    ShaderRecompiler::SpirvTarget physicalShaderTarget{};
+    physicalShaderTarget.vulkanVersion = VK_API_VERSION_1_1;
+    physicalShaderTarget.spirvVersion = 0x00010300u;
+    physicalShaderTarget.subgroupSize = 32;
+    ShaderRecompiler::RecompileRequest physicalVertexRequest{
+        {ShaderRecompiler::ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(physicalVertexCode.data()), physicalVertexCode, 0, {}},
+        {32, 0, physicalVertexData, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, physicalVertexMemory},
+        physicalShaderTarget, {0, 0, 0, 64},
+    };
+    physicalVertexRequest.useCache = false;
+    auto physicalVertex = ShaderRecompiler::Recompile(physicalVertexRequest);
+    physicalVertex.variantId = 0;
+    addUnusedBdaBindings(physicalVertex);
+    constexpr std::array<std::uint32_t, 1> physicalFragmentCode{0xbf810000u};
+    const std::array<ShaderRecompiler::MemoryRegion, 1> physicalFragmentMemory{{
+        {reinterpret_cast<std::uintptr_t>(physicalFragmentCode.data()), std::as_bytes(std::span(physicalFragmentCode))},
+    }};
+    ShaderRecompiler::ShaderPixelStageInfo physicalPixel{};
+    physicalPixel.wave32 = true;
+    const auto physicalFragmentOffset = static_cast<std::uint32_t>(physicalVertex.pushConstants.size());
+    ShaderRecompiler::RecompileRequest physicalFragmentRequest{
+        {ShaderRecompiler::ShaderStage::Fragment, reinterpret_cast<std::uintptr_t>(physicalFragmentCode.data()), physicalFragmentCode, 0, {}},
+        {32, 0, {}, std::nullopt, physicalPixel, std::nullopt, physicalFragmentMemory},
+        physicalShaderTarget, {0, 0, physicalFragmentOffset, PipelinePushConstantBytes - physicalFragmentOffset},
+    };
+    physicalFragmentRequest.useCache = false;
+    auto physicalFragment = ShaderRecompiler::Recompile(physicalFragmentRequest);
+    physicalFragment.variantId = 0;
+    const std::array<CompiledShader, 2> physicalDepthShaders{{
+        {ShaderRecompiler::ShaderStage::Vertex, &physicalVertex, 0},
+        {ShaderRecompiler::ShaderStage::Fragment, &physicalFragment, physicalFragmentOffset},
+    }};
+    State physicalDepthDraw{};
+    physicalDepthDraw.stages = {ShaderPath::Vertex, 0u, 32u, 32u, std::nullopt, std::nullopt};
+    physicalDepthDraw.depth = ownedTarget;
+    physicalDepthDraw.depthTest = true;
+    physicalDepthDraw.depthWrite = true;
+    physicalDepthDraw.depthCompare = VK_COMPARE_OP_LESS;
+    physicalDepthDraw.renderExtent = ownedTarget.extent;
+    physicalDepthDraw.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    physicalDepthDraw.viewport = {0, static_cast<float>(height), static_cast<float>(width), -static_cast<float>(height), 0, 1};
+    physicalDepthDraw.scissor = {{0, 0}, ownedTarget.extent};
+    physicalDepthDraw.cullMode = VK_CULL_MODE_NONE;
+    physicalDepthDraw.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    if (std::getenv("APS5_TEST_EMPTY_DEPTH_PASS1") != nullptr) {
+        Require(large && !context.pipelineStatisticsQuery,
+                "empty depth fixture requires 4K and native depthcapture query parity (statistics disabled)");
+        const bool guestSamples = std::getenv("APS5_TEST_EMPTY_DEPTH_GUEST_SAMPLES1") != nullptr;
+        auto emptyState = physicalDepthDraw;
+        emptyState.depthCompare = VK_COMPARE_OP_GREATER_OR_EQUAL;
+        clearDepthStorage(context, recorder, owned, 0.0f);
+        CheckDepthSurfaceDepthWrites(context, emptyState);
+        recorder.Sync();
+        {
+            ShaderResources resources(context, physicalDepthShaders, emptyState.color, 0, 0);
+            const auto layout = BuildVertexInputLayout(context, physicalVertex.vertexAttributes);
+            auto pipeline = CachedPipeline(context, emptyState, layout, resources, physicalDepthShaders, VK_IMAGE_LAYOUT_GENERAL);
+            const std::array views{DepthSurfaceView(context, ownedTarget)};
+            auto framebuffer = pipeline->AcquireFramebuffer(views, {}, ownedTarget.extent);
+            const auto destroyQuery = context.Function<PFN_vkDestroyQueryPool>("vkDestroyQueryPool");
+            auto query = std::shared_ptr<VkQueryPool>(new VkQueryPool(VK_NULL_HANDLE), [device=context.device,destroyQuery](VkQueryPool* pool) {
+                if (*pool != VK_NULL_HANDLE) destroyQuery(device, *pool, nullptr);
+                delete pool;
+            });
+            VkQueryPoolCreateInfo queryInfo{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+            queryInfo.queryType = VK_QUERY_TYPE_OCCLUSION;
+            queryInfo.queryCount = 1;
+            Check(context.Function<PFN_vkCreateQueryPool>("vkCreateQueryPool")(context.device, &queryInfo, nullptr, query.get()), "empty depth create query");
+            const auto fence = [&](const char* phase) {
+                std::fprintf(stderr, "[empty-depth] %s fence-BEGIN batch=%llu\n", phase, static_cast<unsigned long long>(recorder.Submissions()+1));
+                recorder.Sync();
+                std::fprintf(stderr, "[empty-depth] %s fence-END\n", phase);
+            };
+            std::fprintf(stderr, "[empty-depth] extent=%ux%u format=%u depthCompare=%u stencilTest=%d pipelineStatistics=%d load=LOAD store=STORE layout=GENERAL\n",
+                         width, height, static_cast<unsigned>(ownedTarget.format), static_cast<unsigned>(emptyState.depthCompare), emptyState.stencilTest, context.pipelineStatisticsQuery);
+            Require(CaptureDepthSurfaceImage(context, recorder, ownedAddress, "empty-depth-before.raw", true), "empty depth before capture missing");
+            fence("before");
+            if (guestSamples) {
+                recorder.CountSamples();
+                const auto commands = recorder.Commands();
+                context.Function<PFN_vkCmdResetQueryPool>("vkCmdResetQueryPool")(commands, *query, 0, 1);
+                recorder.Keep(query);
+                fence("guest-active-diagnostic-reset");
+            }
+            // No shader invocation or publication: progressively isolate pass, query and the
+            // exact native readback used by the failing selected-draw diagnostic.
+            for (unsigned phase = 0; phase != 3; ++phase) {
+                const auto commands = recorder.Commands();
+                if (phase != 0) context.Function<PFN_vkCmdResetQueryPool>("vkCmdResetQueryPool")(commands, *query, 0, 1);
+                RecordMemoryBarrier(context, commands, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                    VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT |
+                    VK_PIPELINE_STAGE_VERTEX_INPUT_BIT | VK_PIPELINE_STAGE_VERTEX_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                    VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT,
+                    VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                    VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT | VK_ACCESS_INDEX_READ_BIT | VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_UNIFORM_READ_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+                pipeline->Begin(commands, *framebuffer, ownedTarget.extent, emptyState);
+                resources.Bind(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline->Layout());
+                pipeline->PushConstants(commands, PushConstantStages(physicalDepthShaders), AssemblePushConstants(physicalDepthShaders));
+                if (phase != 0 && !guestSamples) {
+                    context.Function<PFN_vkCmdBeginQuery>("vkCmdBeginQuery")(commands, *query, 0, 0);
+                    context.Function<PFN_vkCmdEndQuery>("vkCmdEndQuery")(commands, *query, 0);
+                }
+                recorder.LeaveRenderPassOpen(0x454d505459ull, Recorder::NoTiming, false);
+                recorder.Keep(pipeline);
+                recorder.Keep(framebuffer);
+                recorder.Keep(query);
+                if (phase == 2) Require(CaptureDepthSurfaceImage(context, recorder, ownedAddress, "empty-depth-after.raw", true), "empty depth after capture missing");
+                fence(phase == 0 ? "pass-only" : phase == 1 ? "pass-query" : "pass-query-readback");
+                if (phase != 0 && !guestSamples) {
+                    std::uint64_t samples = ~std::uint64_t{0};
+                    Check(context.Function<PFN_vkGetQueryPoolResults>("vkGetQueryPoolResults")(context.device, *query, 0, 1, sizeof(samples), &samples, sizeof(samples), VK_QUERY_RESULT_64_BIT), "empty depth query result");
+                    Require(samples == 0, "empty depth query unexpectedly counted samples");
+                }
+            }
+            if (guestSamples) {
+                if (std::getenv("APS5_TEST_EMPTY_DEPTH_SAMPLE_FOLD1") != nullptr) {
+                    auto sampledContext = context;
+                    sampledContext.recorder = &recorder;
+                    auto sampledState = emptyState;
+                    sampledState.depthWrite = false;
+                    sampledState.scissor.extent = {0, 0};
+                    const auto firstSubmission = recorder.Submissions();
+                    std::fprintf(stderr, "[empty-depth] guest-real-draws-BEGIN count=65 scissor=0x0 depthWrite=0\n");
+                    for (unsigned i = 0; i != 65; ++i) {
+                        Draw(sampledContext, sampledState, {0, 3, 0, 1, 0, false}, physicalDepthShaders);
+                        recorder.Sync();
+                        if (i == 63) std::fprintf(stderr, "[empty-depth] guest-real-draws-64 fence-END auto-fold-threshold=64\n");
+                    }
+                    Require(recorder.Submissions() >= firstSubmission + 65, "sample fold fixture did not submit all real draws");
+                    std::fprintf(stderr, "[empty-depth] guest-real-draws-END count=65 batches=%llu\n", static_cast<unsigned long long>(recorder.Submissions()-firstSubmission));
+                }
+                const auto address = physicalVertexAddress + 65536u;
+                constexpr std::size_t dumpBytes = 16u * 16u;
+                const auto* imported = HostImportFor(context, address, dumpBytes);
+                Require(imported != nullptr && imported->address != 0, "guest sample fixture requires a real imported destination");
+                std::memset(reinterpret_cast<void*>(address), 0xa5, dumpBytes);
+                Require(recorder.DumpSamples(imported->address + address - imported->base), "guest sample fixture GPU dump unavailable");
+                fence("guest-dump-samples");
+                const auto* values = reinterpret_cast<const std::uint64_t*>(address);
+                for (std::size_t db = 0; db != 16; ++db) {
+                    Require(values[db*2] == (1ull << 63u), "empty guest sample counter was not ready and zero");
+                    Require(values[db*2+1] == 0xa5a5a5a5a5a5a5a5ull, "guest sample dump overwrote adjacent bytes");
+                }
+            }
+        }
+        expectFloatValue(readPlane(ownedImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.0f, "empty depth pass changed D32");
+        stencil = readPlane(ownedImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+        for (const auto value : stencil) Require(std::to_integer<std::uint8_t>(value) == ownedTarget.clearStencil, "empty depth pass changed S8");
+        gpu.unlock();
+        ClearDepthSurfaces(context.device);
+        gpu.lock();
+        recorder.Sync();
+        ClearCachedTextures(context.device);
+        ClearCachedPipelines(context.device);
+        outerRecorder.Activate();
+        std::fprintf(stderr, "[empty-depth] isolated fixture PASS\n");
+        return;
+    }
+    Draw(context, physicalDepthDraw, {0, 3, 0, 1, 0, false}, physicalDepthShaders);
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.25f,
+                     "R32 depth bridge: readonly BDA physical depth writes did not reach the R32 owner");
+    static_cast<void>(DepthSurfaceView(context, ownedTarget));
+    Require(DepthSurfaceStorageTexture(context, ownedDepth, 0) == owned,
+            "R32 depth bridge: physical depth resynchronization replaced the storage owner");
+    expectFloatValue(readPlane(ownedImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.25f,
+                     "R32 depth bridge: rebinding did not preserve physical depth writes");
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.25f,
+                     "R32 depth bridge: rebinding changed the latest physical depth owner value");
+    stencil = readPlane(ownedImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == ownedTarget.clearStencil,
+                "R32 depth bridge: physical depth publication changed the S8 aspect");
+
+    // Standalone draws publish only after their local recorder submits. Change the vertex depth
+    // so the readback proves this second path wrote the native D32 plane and refreshed its owner.
+    recorder.Sync();
+    constexpr std::array<std::array<float, 4>, 3> standaloneVertices{{
+        {-1.0f, -1.0f, 0.125f, 1.0f}, {3.0f, -1.0f, 0.125f, 1.0f}, {-1.0f, 3.0f, 0.125f, 1.0f},
+    }};
+    std::memcpy(reinterpret_cast<void*>(physicalVertexAddress), standaloneVertices.data(), sizeof(standaloneVertices));
+    AgcDriver::GuestMemory::MarkWritten(physicalVertexAddress, sizeof(standaloneVertices));
+    { Recorder inactive(context); inactive.Activate(); }
+    Require(Recorder::Active() == nullptr, "R32 depth bridge: standalone depth test still has an active recorder");
+    Draw(context, physicalDepthDraw, {0, 3, 0, 1, 0, false}, physicalDepthShaders);
+    recorder.Activate();
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.125f,
+                     "R32 depth bridge: standalone physical depth writes did not reach the R32 owner");
+    static_cast<void>(DepthSurfaceView(context, ownedTarget));
+    expectFloatValue(readPlane(ownedImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.125f,
+                     "R32 depth bridge: standalone depth publication did not survive rebind");
+    stencil = readPlane(ownedImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == ownedTarget.clearStencil,
+                "R32 depth bridge: standalone depth publication changed the S8 aspect");
+
+    // Two combined views can name the same native D32 plane while carrying distinct S8 planes.
+    // The depth owner must follow the shared D32 address/extent/format without importing or
+    // publishing either view's stencil bytes through the other view.
+    const auto aliasStencilAddress = base + (large ? 208u * 1024u * 1024u : 1664u * 1024u);
+    const auto aliasTarget = DepthTarget{ownedAddress, aliasStencilAddress, {width, height}, VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                         0.875f, 0x33};
+    std::fill_n(guest.data() + (aliasStencilAddress - base), stencilBytes, std::byte{0x33});
+    capturedDepthImages.clear();
+    static_cast<void>(DepthSurfaceView(context, aliasTarget));
+    Require(!capturedDepthImages.empty(), "R32 depth bridge: no aliased combined depth/stencil image was captured");
+    const auto aliasImage = capturedDepthImages.back();
+    Require(DepthSurfaceStorageTexture(context, ownedDepth, 0) == owned,
+            "R32 depth bridge: changing the S8 address replaced the shared R32 depth owner");
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.125f,
+                     "R32 depth bridge: binding an S8 alias changed the shared R32 depth value");
+    expectFloatValue(readPlane(aliasImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.125f,
+                     "R32 depth bridge: S8 alias did not import the shared D32 value");
+    stencil = readPlane(aliasImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == aliasTarget.clearStencil,
+                "R32 depth bridge: binding the S8 alias changed its stencil clear value");
+
+    constexpr std::array<std::array<float, 4>, 3> aliasVertices{{
+        {-1.0f, -1.0f, 0.0625f, 1.0f}, {3.0f, -1.0f, 0.0625f, 1.0f}, {-1.0f, 3.0f, 0.0625f, 1.0f},
+    }};
+    std::memcpy(reinterpret_cast<void*>(physicalVertexAddress), aliasVertices.data(), sizeof(aliasVertices));
+    AgcDriver::GuestMemory::MarkWritten(physicalVertexAddress, sizeof(aliasVertices));
+    physicalDepthDraw.depth = aliasTarget;
+    Draw(context, physicalDepthDraw, {0, 3, 0, 1, 0, false}, physicalDepthShaders);
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.0625f,
+                     "R32 depth bridge: physical writes through the S8 alias did not reach the shared R32 owner");
+    expectFloatValue(readPlane(aliasImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.0625f,
+                     "R32 depth bridge: physical writes through the S8 alias missed its D32 plane");
+    stencil = readPlane(aliasImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == aliasTarget.clearStencil,
+                "R32 depth bridge: physical writes changed the aliased S8 plane");
+
+    static_cast<void>(DepthSurfaceView(context, ownedTarget));
+    physicalDepthDraw.depth = ownedTarget;
+    Require(DepthSurfaceStorageTexture(context, ownedDepth, 0) == owned,
+            "R32 depth bridge: returning from the S8 alias replaced the shared R32 owner");
+    expectFloatValue(readPlane(ownedImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.0625f,
+                     "R32 depth bridge: rebinding the original S8 view lost aliased D32 writes");
+    stencil = readPlane(ownedImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == ownedTarget.clearStencil,
+                "R32 depth bridge: switching S8 aliases changed the original stencil plane");
+    stencil = readPlane(aliasImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == aliasTarget.clearStencil,
+                "R32 depth bridge: switching S8 aliases changed the aliased stencil plane");
+
+    auto bdaDepthWriter = physicalVertex;
+    bdaDepthWriter.bdaWrites = true;
+    const std::array<CompiledShader, 2> bdaDepthWriterShaders{{
+        {ShaderRecompiler::ShaderStage::Vertex, &bdaDepthWriter, 0},
+        {ShaderRecompiler::ShaderStage::Fragment, &physicalFragment, physicalFragmentOffset},
+    }};
+    const auto expectBdaDepthWriterReject = [&] {
+        try {
+            Draw(context, physicalDepthDraw, {0, 3, 0, 1, 0, false}, bdaDepthWriterShaders);
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("simultaneous shader") != std::string_view::npos,
+                    "R32 depth bridge: BDA writer reported the wrong physical depth rejection");
+            return;
+        }
+        throw std::runtime_error("R32 depth bridge: semantic BDA writer was accepted with a physical depth owner");
+    };
+    expectBdaDepthWriterReject();
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.0625f,
+                     "R32 depth bridge: rejected BDA writer changed the R32 owner");
+
+    const auto rejectDepthMixedWriter = [&](ShaderRecompiler::DescriptorBinding binding) {
+        ShaderRecompiler::RecompileResult writer;
+        writer.bindings.push_back(std::move(binding));
+        const CompiledShader writerShader{ShaderRecompiler::ShaderStage::Compute, &writer, 0};
+        ShaderResources writerResources(context, writerShader);
+        bool rejected = false;
+        try {
+            CheckDepthSurfaceDepthWrites(context, physicalDepthDraw, &writerResources);
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("simultaneous shader") != std::string_view::npos,
+                    "R32 depth bridge: mixed writer reported the wrong physical depth rejection");
+            rejected = true;
+        }
+        Require(rejected, "R32 depth bridge: a simultaneous shader writer was accepted");
+        expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.0625f,
+                         "R32 depth bridge: rejected mixed writer changed the R32 owner");
+    };
+    ShaderRecompiler::DescriptorBinding bufferWriter{};
+    bufferWriter.kind = ShaderRecompiler::DescriptorKind::StorageBuffer;
+    bufferWriter.role = ShaderRecompiler::DescriptorRole::GuestBuffers;
+    bufferWriter.count = 1;
+    const auto overlappingBufferAddress = ownedAddress + 64u;
+    bufferWriter.guestDescriptor = {static_cast<std::uint32_t>(overlappingBufferAddress),
+                                    static_cast<std::uint32_t>(overlappingBufferAddress >> 32u) & 0xffffu,
+                                    64u, 0x31000000u};
+    bufferWriter.bufferWritten = {true};
+    rejectDepthMixedWriter(std::move(bufferWriter));
+    ShaderRecompiler::DescriptorBinding imageWriter{};
+    imageWriter.kind = ShaderRecompiler::DescriptorKind::StorageImage;
+    imageWriter.role = ShaderRecompiler::DescriptorRole::GuestImages;
+    imageWriter.count = 1;
+    imageWriter.imageShape = ShaderRecompiler::DescriptorImageShape::Image2D;
+    imageWriter.imageWritten = {true};
+    imageWriter.guestDescriptor = {static_cast<std::uint32_t>(ownedAddress >> 8u),
+                                   static_cast<std::uint32_t>(ownedAddress >> 40u) | 0xc1600000u,
+                                   ((height - 1u) << 14u) | ((width - 1u) >> 2u), 0x91800facu,
+                                   0, 0x00700000u, 0, 0};
+    rejectDepthMixedWriter(std::move(imageWriter));
+
+    auto expectStorageReject = [&](GuestTextureResource descriptor, std::uint32_t mip) {
+        try {
+            static_cast<void>(DepthSurfaceStorageTexture(context, descriptor, mip));
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("format, extent, layers or mip") != std::string_view::npos,
+                    std::string("R32 depth bridge: wrong descriptor rejection: ") + error.what());
+            return;
+        }
+        throw std::runtime_error("R32 depth bridge: invalid storage descriptor was accepted");
+    };
+    auto invalid = ownedDepth;
+    invalid.format = 5;
+    expectStorageReject(invalid, 0);
+    invalid = ownedDepth;
+    invalid.width /= 2;
+    expectStorageReject(invalid, 0);
+    invalid = ownedDepth;
+    invalid.mipCount = 2;
+    invalid.lastLevel = 1;
+    expectStorageReject(invalid, 0);
+    expectStorageReject(ownedDepth, 1);
+
+    State guardedDraw{};
+    guardedDraw.depth = ownedTarget;
+    guardedDraw.depthBoundsTest = true;
+    guardedDraw.minDepthBounds = 0.1f;
+    guardedDraw.maxDepthBounds = 0.9f;
+    CheckDepthSurfaceDepthWrites(context, guardedDraw); // readonly depth bounds remain allowed
+    guardedDraw.depthWrite = true;
+    guardedDraw.depth->extent.width /= 2;
+    const auto expectDepthWriteReject = [&] {
+        try {
+            CheckDepthSurfaceDepthWrites(context, guardedDraw);
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("physical depth writes") != std::string_view::npos,
+                    "R32 depth bridge: wrong physical depth write rejection");
+            return;
+        }
+        throw std::runtime_error("R32 depth bridge: physical depth writes with an R32 owner were accepted");
+    };
+    expectDepthWriteReject();
+    guardedDraw.depth->address += 65536;
+    try {
+        CheckDepthSurfaceDepthWrites(context, guardedDraw);
+    } catch (const std::runtime_error&) {
+        throw std::runtime_error("R32 depth bridge: a different-address depth write was rejected");
+    }
+
+    clearDepthStorage(context, recorder, owned, 0.3f);
+    Require(DepthSurfaceStorageTexture(context, ownedDepth, 0) == owned,
+            "R32 depth bridge: later storage update replaced the owned R32 image");
+    expectFloatValue(readPlane(ownedImage, VK_IMAGE_ASPECT_DEPTH_BIT, planeBytes), 0.3f,
+                     "R32 depth bridge: later R32 writes did not reach the physical depth aspect");
+    stencil = readPlane(ownedImage, VK_IMAGE_ASPECT_STENCIL_BIT, stencilBytes);
+    for (const auto byte : stencil)
+        Require(std::to_integer<std::uint8_t>(byte) == ownedTarget.clearStencil,
+                "R32 depth bridge: R32 update changed the S8 aspect");
+
+    gpu.unlock();
+    ClearDepthSurfaces(context.device);
+    gpu.lock();
+    recorder.Sync();
+    expectFloatValue(readPlane(incoming->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.4f,
+                     "R32 depth bridge: incoming owner lost its latest guest writeback");
+    expectFloatValue(readPlane(owned->Image(), VK_IMAGE_ASPECT_COLOR_BIT, planeBytes), 0.3f,
+                     "R32 depth bridge: created owner lost its latest guest writeback");
+    if (large) {
+        expectTiledGuestFloatPlane(incoming, 0.4f, "R32 depth bridge: incoming R32 data did not reach guest memory");
+        expectTiledGuestFloatPlane(owned, 0.3f, "R32 depth bridge: latest R32 data did not reach guest memory");
+    } else {
+        expectFloatValue(std::span<const std::byte>(guest.data(), planeBytes), 0.4f,
+                         "R32 depth bridge: incoming R32 data did not reach guest memory");
+        expectFloatValue(std::span<const std::byte>(guest.data() + (ownedAddress - base), planeBytes), 0.3f,
+                         "R32 depth bridge: latest R32 data did not reach guest memory");
+    }
+    const auto guestStencil = std::span<const std::byte>(guest.data() + (incomingStencilAddress - base), stencilBytes);
+    for (const auto byte : guestStencil)
+        Require(byte == std::byte{0xc7},
+                "R32 depth bridge: depth writeback changed the preexisting guest S8 bytes");
+    recorder.Sync();
+    ClearCachedTextures(context.device);
+    ClearCachedPipelines(context.device);
+    outerRecorder.Activate();
+}
+
+void readTrackingTests(const Device& device, Recorder& recorder) {
+    Require(Recorder::ReadTracking(), "read tracking is off (APS5_COPY_READ_TRACKING=0 set?)");
+    Require(recorder.Idle() && !recorder.PendingReadOverlaps(0x10000, 16), "a fresh recorder reports a read");
+    recorder.NotePendingRead(0x10000, 0x100, Kind::DispatchElement);
+    Require(recorder.Recording(), "a read note did not open a batch");
+    Require(recorder.PendingReadOverlaps(0x10080, 4) && recorder.PendingReadOverlaps(0xff00, 0x101) && recorder.PendingReadOverlaps(0x100ff, 1), "an open batch's read is not seen");
+    Require(!recorder.PendingReadOverlaps(0x10100, 4) && !recorder.PendingReadOverlaps(0xff00, 0x100) && !recorder.PendingReadOverlaps(0x10000, 0), "a disjoint range is reported as read");
+    const auto open = recorder.DescribePendingRead(0x10000, 4);
+    Require(open.has_value() && open->open && !open->signaled && open->kind == Kind::DispatchElement && open->serial == recorder.Submissions() + 1, "the open batch's read is described wrongly");
+    recorder.Submit();
+    Require(!recorder.Recording() && !recorder.Idle(), "the batch is not in flight after Submit");
+    Require(recorder.PendingReadOverlaps(0x10000, 4, false), "the raw scan does not see the in-flight batch's read");
+    // An empty batch completes at once: once its fence signaled, its read is no reader any more,
+    // although the batch stays in flight until it is reaped.
+    device.WaitQueue();
+    Require(!recorder.PendingReadOverlaps(0x10000, 4), "a signaled batch's read still refuses");
+    Require(!recorder.Idle(), "an overlap query reaped the batch");
+    const auto signaled = recorder.DescribePendingRead(0x10000, 4);
+    Require(signaled.has_value() && !signaled->open && signaled->signaled && signaled->serial == recorder.Submissions(), "the signaled batch's read is described wrongly");
+    const auto counts = Recorder::ReadCounts();
+    Require(counts.noted == 1 && counts.staleIgnored >= 1 && counts.hits[static_cast<std::size_t>(Kind::DispatchElement)] >= 3 && counts.queries >= 6, "read counters are off");
+    recorder.Sync();
+    Require(recorder.Idle() && !recorder.PendingReadOverlaps(0x10000, 4, false) && !recorder.DescribePendingRead(0x10000, 4).has_value(), "a read outlived its batch");
+    const std::vector<std::pair<std::uint64_t, std::uint64_t>> ranges{{0x20000, 0x21000}, {0x30000, 0x30010}, {0x40000, 0x40000}};
+    recorder.NotePendingReads(ranges, Kind::AddressBased);
+    Require(recorder.PendingReadOverlaps(0x20fff, 1) && recorder.PendingReadOverlaps(0x30000, 16) && !recorder.PendingReadOverlaps(0x21000, 16) && !recorder.PendingReadOverlaps(0x40000, 16), "noted ranges are not seen as reads");
+    const auto batch = recorder.DescribePendingRead(0x30008, 4);
+    Require(batch.has_value() && batch->kind == Kind::AddressBased && batch->open, "a noted range has the wrong reader kind");
+    Require(Recorder::ReadCounts().hits[static_cast<std::size_t>(Kind::AddressBased)] >= 2, "address-based hits are not counted");
+    recorder.Sync();
+    Require(recorder.Idle() && !recorder.PendingReadOverlaps(0x20000, 0x1000, false), "noted ranges outlived their batch");
+}
+
+void writeSettledTests(const Device& device, Recorder& recorder) {
+    Require(recorder.PendingWriteSettled(0x50000, 0x100), "an unwritten range is not settled");
+    recorder.NotePendingWrite(0x50000, 0x100);
+    Require(recorder.PendingWriteOverlaps(0x50000, 0x100) && !recorder.PendingWriteSettled(0x50000, 0x100) && recorder.PendingWriteSettled(0x50100, 0x100), "an open batch's write counts as settled");
+    recorder.Submit();
+    device.WaitQueue();
+    Require(recorder.PendingWriteOverlaps(0x50000, 0x100) && recorder.PendingWriteSettled(0x50000, 0x100), "a signaled batch's write is not settled");
+    recorder.NotePendingWrite(0x50080, 0x10);
+    Require(!recorder.PendingWriteSettled(0x50000, 0x100) && recorder.PendingWriteSettled(0x50000, 0x80), "a later open write over the range still counts as settled");
+    recorder.Sync();
+    Require(recorder.Idle() && !recorder.PendingWriteOverlaps(0x50000, 0x100), "writes outlived their batches");
+}
+
+// Completion counting: a write-back completion (OnComplete) is pending until its batch finished;
+// a completion label the GPU also stored (AfterCompletions storedOnGpu) is pending only once a CPU
+// write-back overlapped it (NoteWrittenBack, once per label), one the GPU has no view of from its
+// registration; both counts return to 0 when the batch finishes.
+void completionCountTests(const Device& device, Recorder& recorder) {
+    alignas(64) static std::uint32_t memory[64];
+    const auto base = reinterpret_cast<std::uint64_t>(memory);
+    const std::array<std::byte, 4> value{std::byte{1}, std::byte{0}, std::byte{0}, std::byte{0}};
+    Require(recorder.Idle() && Recorder::PendingCompletionLabels() == 0 && Recorder::PendingWriteBackCompletions() == 0, "a fresh recorder reports pending completions");
+    int ran = 0;
+    recorder.OnComplete([&] { ++ran; });
+    Require(Recorder::PendingWriteBackCompletions() == 1 && recorder.HasCompletions(), "a write-back completion is not pending");
+    // APS5_COUNT_ALL_COMPLETION_LABELS=1 (or APS5_LABEL_STORE_ALWAYS=1) counts the GPU-stored
+    // labels at registration, as before; the write-back then changes nothing.
+    const bool countAll = std::getenv("APS5_COUNT_ALL_COMPLETION_LABELS") != nullptr || std::getenv("APS5_LABEL_STORE_ALWAYS") != nullptr;
+    const std::uint64_t registered = countAll ? 2 : 0;
+    recorder.AfterCompletions(base, value, 3, 0, true);
+    recorder.AfterCompletions(base + 8, value, 4, 0, true);
+    Require(Recorder::PendingCompletionLabels() == registered, "a GPU-stored completion label counts before any write-back");
+    recorder.AfterCompletions(base + 0x40, value, 5, 0, false);
+    Require(Recorder::PendingCompletionLabels() == registered + 1, "a label the GPU has no view of is not pending");
+    // A late lookup (stamp <= afterStamp) of a label whose value reaches memory only through the
+    // batch's completion action is refused as BehindCompletion (a poller reaps for it); a GPU-stored
+    // one keeps the ordinary reason (unclosed group, or trust off) until a write-back overlaps it.
+    using Refusal = Recorder::LabelRefusal;
+    const Refusal ordinary = Recorder::LateTrust() ? Refusal::Unclosed : Refusal::TrustOff;
+    Refusal refusal{};
+    Require(!Recorder::LookupLabel(base + 0x40, 4, 5, &refusal).has_value() && refusal == Refusal::BehindCompletion, "a not-imported completion label is not refused as behind a completion");
+    Require(!Recorder::LookupLabel(base, 4, 3, &refusal).has_value() && refusal == (countAll ? Refusal::BehindCompletion : ordinary), "a GPU-stored label is refused as behind a completion before any write-back");
+    Require(Recorder::LookupLabel(base, 4, 2, &refusal).has_value() && refusal == Refusal::None, "an early lookup of a completion label is refused");
+    Recorder::NoteWrittenBack(base + 0x80, 0x40);
+    Require(Recorder::PendingCompletionLabels() == registered + 1, "a disjoint write-back counted a label");
+    Recorder::NoteWrittenBack(base, 4);
+    Recorder::NoteWrittenBack(base + 2, 4);
+    const std::uint64_t counted = countAll ? 3 : 2;
+    Require(Recorder::PendingCompletionLabels() == counted, "a write-back over a GPU-stored label did not count it exactly once");
+    Require(!Recorder::LookupLabel(base, 4, 3, &refusal).has_value() && refusal == Refusal::BehindCompletion, "a written-back GPU-stored label is not refused as behind a completion");
+    Require(!Recorder::LookupLabel(base + 8, 4, 4, &refusal).has_value() && refusal == (countAll ? Refusal::BehindCompletion : ordinary), "an untouched GPU-stored label became behind a completion");
+    recorder.Submit();
+    device.WaitQueue();
+    Require(Recorder::PendingCompletionLabels() == counted && Recorder::PendingWriteBackCompletions() == 1, "counts dropped before the batch finished");
+    memory[0] = 7;
+    memory[2] = 7;
+    memory[16] = 7;
+    recorder.Sync();
+    Require(ran == 1 && Recorder::PendingCompletionLabels() == 0 && Recorder::PendingWriteBackCompletions() == 0 && recorder.Idle(), "counts did not return to 0 at finish");
+    const bool storeAlways = std::getenv("APS5_LABEL_STORE_ALWAYS") != nullptr;
+    Require(memory[0] == 1 && memory[2] == (storeAlways ? 1u : 7u) && memory[16] == 1, "completion stores ran for the wrong labels (overlapped and not-imported ones store, the untouched GPU-stored one skips)");
+}
+
+void afterRecordedWorkTests(const Device& device, Recorder& recorder) {
+    alignas(64) static std::uint32_t memory[16];
+    const auto base = reinterpret_cast<std::uint64_t>(memory);
+    const std::array<std::byte, 4> value{std::byte{1}, std::byte{0}, std::byte{0}, std::byte{0}};
+    recorder.Sync();
+    std::vector<int> ran;
+    std::uint32_t seen = 0;
+    Require(recorder.Idle() && !recorder.AfterRecordedWork([&] { ran.push_back(0); }) && ran.empty() && Recorder::PendingCompletionLabels() == 0, "an idle recorder kept an action for recorded work");
+    recorder.NotePendingWrite(0x52000, 0x100);
+    Require(!Recorder::PendingLabelSince().has_value(), "a write started the label flush deadline");
+    Require(recorder.AfterRecordedWork([&] { ran.push_back(1); }) && Recorder::PendingCompletionLabels() == 1 && Recorder::PendingLabelSince().has_value(), "an action behind the open batch is not pending under the label flush deadline");
+    recorder.AfterCompletions(base, value, 6, 0, false);
+    Require(recorder.AfterRecordedWork([&] { seen = memory[0]; ran.push_back(2); }) && Recorder::PendingCompletionLabels() == 3, "an action behind a completion label is not pending");
+    recorder.Submit();
+    Require(recorder.AfterRecordedWork([&] { ran.push_back(3); }) && Recorder::PendingCompletionLabels() == 4, "an action behind an in-flight batch is not pending");
+    device.WaitQueue();
+    Require(ran.empty(), "an action ran before its batch was reaped");
+    recorder.Sync();
+    Require(ran == std::vector<int>{1, 2, 3} && Recorder::PendingCompletionLabels() == 0 && recorder.Idle(), "actions behind recorded work did not run once each, in order");
+    Require(seen == 1, "an action ran before the completion label recorded ahead of it");
+}

+    }
+    state.module.AddFunction(spv::OpReturn);
+    state.module.AddFunction(spv::OpFunctionEnd);
+    state.module.AddExecutionMode(main, spv::ExecutionModeLocalSize, 4u, 1u, 1u);
+    const std::vector<std::uint32_t> interfaceVariables{state.subgroupLocalInvocationIdVariable, invocation};
+    state.module.EmitEntryPoint(spv::ExecutionModelGLCompute, main, "main", interfaceVariables);
+    return state.module.Finalize();
+}

+    ~WatchedGuestBlock() {
+        if (registeredAllocation) GuestAllocations::Mutation().Remove(block);
+        if (registeredWatch) GuestWriteWatch::GuestWriteWatchUnregister_nid_postfix(block, bytes);
+        if (mapping != nullptr && mapping != MAP_FAILED) munmap(mapping, mappingBytes);

+    Require(GuestWriteWatch::GuestWriteWatchAvailable_nid_postfix(), "image-mirror write-watch backend is unavailable");
+
+    auto* guest = imageMirrorWatchFixture.data();
+    const auto address = reinterpret_cast<std::uintptr_t>(guest);
+    constexpr std::size_t bytes = 2 * 65536;
+    std::memset(guest, 0x11, bytes);
+    {
+        auto mutation = GuestAllocations::Mutation();
+        mutation.RegisterMainImage();
+    }
+    {
+        const auto lease = GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+        const auto original = std::find_if(lease.begin(), lease.end(), [&](const auto& range) {
+            return range->address <= address && range->address + range->bytes >= address + bytes;
+        });
+        Require(original != lease.end() && !(*original)->releasable, "the aligned BSS fixture is not in a registered main-image range");
+    }
+    {
+        auto mutation = GuestAllocations::Mutation();
+        mutation.Protect(guest, bytes, true, true, [&] {
+            Require(::mprotect(guest, bytes, PROT_READ | PROT_WRITE) == 0, "cannot protect the aligned BSS image-mirror fixture");
+        });
+    }
+    {
+        const auto lease = GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+        const auto split = std::find_if(lease.begin(), lease.end(), [&](const auto& range) { return range->address == address; });
+        Require(split != lease.end() && (*split)->bytes == bytes && (*split)->readable && (*split)->writable && !(*split)->releasable,
+                "the BSS image range was not split into a writable nonheap mirror fixture");
+    }
+
+    auto noImports = context;
+    noImports.hostImportAlignment = 0;
+    std::uint64_t deviceAddress = 0;
+    const auto build = [&] {
+        GuestBufferMemory memory(noImports);
+        memory.AcquireRegistered();
+        memory.Upload(true);
+        const auto ranges = memory.AddressRanges();
+        const auto found = std::find_if(ranges.begin(), ranges.end(), [&](const auto& range) { return range.begin == address && range.end == address + bytes; });
+        Require(found != ranges.end() && found->deviceAddress != 0, "the protected BSS range did not use an image mirror");
+        if (deviceAddress == 0) deviceAddress = found->deviceAddress;
+        Require(deviceAddress == found->deviceAddress, "the image mirror changed across an unchanged registry");
+        const auto mirror = access.addressBytes(found->deviceAddress);
+        Require(mirror.size() >= bytes, "the BSS image mirror is shorter than its registered range");
+        std::vector<std::byte> result(mirror.begin(), mirror.begin() + bytes);
+        memory.WriteBack();
+        return result;
+    };
+
+    auto first = build();
+    Require(first.front() == std::byte{0x11} && first.back() == std::byte{0x11}, "the image mirror missed its initial BSS contents");
+    Require(GuestWriteWatch::GuestWriteWatchCovers_nid_postfix(address, bytes), "the writable image mirror was not registered with GuestWriteWatch");
+    build(); // Establish the per-block baseline after the new registration's fresh-page collect.
+    const auto quiet = build();
+    // RegisterMainImage also covers mutable test, tracker, and mock globals;
+    // global mirror-copy counters therefore cannot attribute quiet copies to
+    // this fixture. Keep this gate focused on its observable mirror bytes.
+    Require(quiet == first, "a quiet full image refresh changed the fixture mirror bytes");
+
+    GuestMemory::BumpCollectEpoch();
+    const auto memoBaseline = GuestMemory::CollectWrites(address, bytes);
+    guest[16] = std::byte{0x22};
+    Require(memoBaseline != 0 && GuestMemory::CollectWrites(address, bytes) == memoBaseline,
+            "the test did not keep the raw CPU write inside one memoized collect epoch");
+    auto cpuUpdated = build();
+    Require(cpuUpdated[16] == std::byte{0x22}, "an uncached full refresh missed a raw CPU store in the same collect epoch");
+
+    // Write a neighboring byte in the same 64 KiB tracked block before the
+    // partial refresh. Advancing that block's generation for a subrange would
+    // then hide this store from the subsequent full refresh.
+    guest[128] = std::byte{0x33};
+    {
+        GuestBufferMemory partial(noImports);
+        partial.AddReadable(address + 64, 16);
+        partial.Upload(true);
+        partial.WriteBack();
+    }
+    auto afterPartial = build();
+    Require(afterPartial[128] == std::byte{0x33}, "a partial refresh advanced the full-block baseline and hid another byte");
+
+    const std::array current{std::byte{0x44}};
+    const std::array originalByte{guest[256]};
+    GuestMemory::MarkWritten(address + 256, current.size());
+    GuestMemory::WriteChanged(address + 256, current, originalByte);
+    auto afterWriteback = build();
+    Require(afterWriteback[256] == std::byte{0x44}, "a driver-stamped WriteChanged result was missed by the image mirror");
+
+    Require(GuestWriteWatch::GuestWriteWatchUnregister_nid_postfix(guest, bytes), "the image-mirror watch could not be removed for fallback coverage");
+    guest[512] = std::byte{0x55};
+    auto fallback = build();
+    Require(fallback[512] == std::byte{0x55}, "a missing write-watch range did not fall back to the complete mirror compare");
+    GuestWriteWatch::GuestWriteWatchRegister_nid_postfix(guest, bytes);
+    Require(GuestWriteWatch::GuestWriteWatchCovers_nid_postfix(address, bytes), "the image-mirror watch could not be restored after fallback");
+
+    // Retire the real cached address space through the registry's pin waiter,
+    // then release the test device's persistent image mirrors so main() can
+    // keep its Vulkan-object leak assertion enabled.
+    {
+        auto mutation = GuestAllocations::Mutation();
+        mutation.Protect(guest, bytes, true, true, [&] {
+            Require(::mprotect(guest, bytes, PROT_READ | PROT_WRITE) == 0, "cannot restore the aligned BSS image-mirror fixture before cleanup");
+        });
+    }
+    ClearImageMirrors(noImports.device);
+}

+    void SyncStencilWrites() {
+        if (stencilStorage == nullptr) return;
+        CheckStencilAllocation();
+        stencilStorage->Refresh();
+        if (stencilStorage->Version() == stencilVersion) return;
+        CopyPlane(stencilStorage, VK_IMAGE_ASPECT_STENCIL_BIT, true);
+        stencilVersion = stencilStorage->Version();
+    }
+
+    void PublishStencilWrites() {
+        const auto stencilBytes = DepthSliceBytes(target.extent, 1u);
+        const auto overlapsStencil = [&](std::uint64_t address, std::uint64_t bytes) {
+            if (bytes == 0 || target.stencilAddress == 0) return false;
+            return address <= target.stencilAddress ? target.stencilAddress - address < bytes : address - target.stencilAddress < stencilBytes;
+        };
+        const auto source = colorOwner.lock();
+        if ((source != nullptr && overlapsStencil(source->Descriptor().baseAddress, source->GuestBytes())) ||
+            (colorDccWitness.has_value() && overlapsStencil(colorDccWitness->address, colorDccWitness->bytes.size())) ||
+            (publishedColor.has_value() && (overlapsStencil(publishedColor->descriptor.baseAddress, publishedColor->guestBytes) ||
+                (publishedColor->dccWitness.has_value() && overlapsStencil(publishedColor->dccWitness->address, publishedColor->dccWitness->bytes.size())))))
+            ClearColorOwner("overlapping-physical-stencil-write");
+        if (stencilStorage == nullptr) return;
+        CheckStencilAllocation();
+        // The draw wrote the combined image after the R8 import. Publish into that same owner
+        // before any later sampler or guest-memory flush can observe its previous contents.
+        CopyPlane(stencilStorage, VK_IMAGE_ASPECT_STENCIL_BIT, false);
+        stencilStorage->MarkDirty();
+        stencilVersion = stencilStorage->Version();
+    }
+
+    void WriteBackStoragePlanes() {
+        if (depthStorage != nullptr) {
+            SyncDepthWrites();
+            depthStorage->WriteBack();
+        }
+        if (stencilStorage != nullptr) {
+            SyncStencilWrites();
+            stencilStorage->WriteBack();
+        }
+    }

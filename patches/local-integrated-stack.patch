+void importSpanPressureTests(const Context& context) {
+    const char* minimum = std::getenv("APS5_IMPORT_SPANS_MIN_ENTRIES");
+    Require(std::getenv("APS5_IMPORT_SPANS") != nullptr && minimum != nullptr && std::string(minimum) == "2", "pressure fixture requires entry threshold two");
+    constexpr std::size_t piece = 65536;
+    constexpr std::size_t mapBytes = 64ull << 20u;
+    std::int64_t physical = 0;
+    Require(DirectMemoryAlloc(0, static_cast<std::int64_t>(DIRECT_MEMORY_SIZE), mapBytes, mapBytes, -1, &physical) == 0, "pressure backing allocation failed");
+    void* block = nullptr;
+    Require(DoReserveVirtual(&block, mapBytes, 0, mapBytes) == 0, "pressure reservation failed");
+    Require(DoMapDirect(&block, mapBytes, 0x33, 0x10, physical, mapBytes) == 0, "pressure mapping failed");
+    auto* guest = static_cast<std::byte*>(block);
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Protect(guest + piece, piece, true, true, [] {}, true);
+        mutation.Protect(guest + 2 * piece, piece, true, true, [] {}, true);
+        mutation.Protect(guest + 3 * piece, mapBytes - 3 * piece, false, false, [] {}, false);
+    }
+    auto importing = context;
+    importing.hostImportAlignment = piece;
+    const auto base = reinterpret_cast<std::uintptr_t>(block);
+    const auto* first = HostImportFor(importing, base, piece);
+    Require(first != nullptr && first->base == base && first->bytes == piece, "grouping activated before import pressure");
+    const auto firstSerial = HostImportSerial(importing, base, piece, false);
+    const auto* second = HostImportFor(importing, base + piece, piece);
+    Require(second != nullptr && second->base == base + piece && second->bytes == piece, "second import grouped below pressure threshold");
+    const auto* combined = HostImportFor(importing, base + 2 * piece, piece);
+    Require(combined != nullptr && combined->base == base && combined->bytes == 3 * piece, "pressure did not merge the existing imports into one span");
+    Require(HostImportSerial(importing, base, piece, false) != firstSerial, "replacement span kept the retired import identity");
+    Require(HostImportCovers(importing, base + piece - 16, 32), "pressure span lost the crossing range");
+    GuestAllocations::Mutation().Protect(guest + 2 * piece, piece, true, false, [] {}, true);
+    const auto* sticky = HostImportFor(importing, base, piece);
+    Require(sticky != nullptr && sticky->base == base && sticky->bytes == 2 * piece, "grouping switched off after pressure reduced the entry count");
+    Require(DoMunmap(block, mapBytes) == 0, "pressure unmap failed");
+    Require(HostImportFor(importing, base, piece) == nullptr, "pressure span survived removal");
+    Require(DirectMemoryCheckedFree(physical, mapBytes), "pressure backing release failed");
+}

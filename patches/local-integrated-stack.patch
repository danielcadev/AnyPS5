+    GuestTextureResource ResizePlaneDescriptor(bool stencil, VkExtent2D extent) const {
+        GuestTextureResource descriptor{};
+        descriptor.baseAddress = stencil ? target.stencilAddress : target.address;
+        descriptor.width = extent.width;
+        descriptor.height = extent.height;
+        descriptor.mipCount = 1;
+        descriptor.tileMode = TextureTileMode::kZ64KBX;
+        descriptor.dimension = TextureDimension::k2D;
+        descriptor.format = stencil ? 5u : 22u;
+        descriptor.dstSelX = 4;
+        descriptor.dstSelY = 5;
+        descriptor.dstSelZ = 6;
+        descriptor.dstSelW = 7;
+        return descriptor;
+    }
+
+    void PublishForResize() {
+        Require(colorOwner.expired() && !publishedColor.has_value(),
+                "depth/stencil resize with a color owner is not implemented");
+        // Missing bridges must first capture the native plane, not upload guest bytes over it.
+        StorageDepth(ResizePlaneDescriptor(false, target.extent), 0);
+        StorageStencil(ResizePlaneDescriptor(true, target.extent), 0);
+        WriteBackStoragePlanes();

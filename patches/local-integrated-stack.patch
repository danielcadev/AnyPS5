+std::uint32_t UsedFormattedOutputs(const IrValue& inst, std::uint32_t components) {
+    const auto all = (1u << components) - 1u;
+    if (components == 1u) return all;
+    std::uint32_t used = 0u;
+    for (const IrValue* user : inst.Uses()) {
+        const auto op = user->Opcode();
+        if (op != IrOpcode::CompositeExtractU32x2 && op != IrOpcode::CompositeExtractU32x3 && op != IrOpcode::CompositeExtractU32x4) return all;
+        const IrValue* index = user->ArgumentCount() > 1u ? user->Argument(1) : nullptr;
+        if (index == nullptr || !index->HasImmediate() || index->ImmediateU32() >= components) return all;

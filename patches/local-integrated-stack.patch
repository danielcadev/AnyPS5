+std::uint32_t RuntimeFormatExtract(SpirvEmitterState& state, std::uint32_t composite, std::uint32_t index, std::uint32_t type = 0u) {
+    const auto value = state.module.AllocateId();
+    state.module.AddFunction(spv::OpCompositeExtract, type == 0u ? TypeU32(state) : type, value, composite, index);
+    return value;
+}

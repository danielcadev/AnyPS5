+void ShaderResources::CaptureBlackComputeImage(Recorder& recorder, std::uint64_t address, const char* filename, std::uint32_t maxExtent) const {
+    std::shared_ptr<StorageTexture> source;
+    const auto* mode = std::getenv("APS5_BLACK_GBUFFER_CAPTURE");
+    const bool colorWriterCapture = mode != nullptr && std::strcmp(mode, "color") == 0;
+    const bool writerCapture = mode != nullptr && (std::strcmp(mode, "writer") == 0 || colorWriterCapture) &&
+        (std::strcmp(filename, "late-final-gbuffer-before.raw") == 0 || std::strcmp(filename, "late-final-gbuffer-after.raw") == 0);
+    for (const auto& texture : textures) {
+        if (writerCapture) break;
+        auto candidate = texture->SharedStorageSource();
+        if (candidate && candidate->Descriptor().baseAddress == address) source = std::move(candidate);
+    }
+    for (std::size_t index = 0; index < storageTextures.size(); ++index) {
+        const auto& candidate = storageTextures[index];
+        if (!candidate || candidate->Descriptor().baseAddress != address) continue;
+        if (writerCapture && (!storageWritten[index] || candidate->StorageFormat() != (colorWriterCapture ? VK_FORMAT_B10G11R11_UFLOAT_PACK32 : VK_FORMAT_R32_UINT) || candidate->Descriptor().width != (colorWriterCapture ? 1920u : 3840u) || candidate->Descriptor().height != (colorWriterCapture ? 1080u : 2160u))) continue;
+        if (writerCapture) Require(!source || source == candidate, "writer capture has ambiguous native output");
+        source = candidate;
+    }
+    Require(source && source->Descriptor().width <= 3840 && source->Descriptor().height <= 2160 && source->ImageLayers() == 1 && source->ImageDepth() == 1, "black compute capture needs the observed native surface");
+    const auto format = source->StorageFormat();
+    const auto elementBytes = format == VK_FORMAT_R16G16B16A16_SFLOAT ? 8u : format == VK_FORMAT_R8G8_UNORM ? 2u : (format == VK_FORMAT_R8_UINT || format == VK_FORMAT_R8_UNORM) ? 1u : (format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_R8G8B8A8_SRGB || format == VK_FORMAT_R16G16_SFLOAT || format == VK_FORMAT_R32_UINT || format == VK_FORMAT_R32_SFLOAT || format == VK_FORMAT_B10G11R11_UFLOAT_PACK32 || format == VK_FORMAT_A2B10G10R10_UNORM_PACK32) ? 4u : 0u;
+    Require(elementBytes != 0,"black compute capture format unsupported");
+    const auto width = maxExtent ? std::min(source->Descriptor().width, maxExtent) : source->Descriptor().width;
+    const auto height = maxExtent ? std::min(source->Descriptor().height, maxExtent) : source->Descriptor().height;
+    const auto size = std::size_t{width} * height * elementBytes;
+    auto output = std::make_shared<Buffer>(context, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    const auto commands = recorder.Commands();
+    VkImageMemoryBarrier image{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    image.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    image.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    image.oldLayout = image.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    image.srcQueueFamilyIndex = image.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    image.image = source->Image();
+    image.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+    const auto barrier = context.Function<PFN_vkCmdPipelineBarrier>("vkCmdPipelineBarrier");
+    barrier(commands,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,1,&image);
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT,0,0,1};
+    if (maxExtent) {
+        copy.imageOffset = {static_cast<std::int32_t>((source->Descriptor().width - width) / 2), static_cast<std::int32_t>((source->Descriptor().height - height) / 2), 0};
+        std::fprintf(stderr, "[black-compute] crop image=%llx sourceExtent=%ux%u offset=%d,%d extent=%ux%u\n", static_cast<unsigned long long>(address), source->Descriptor().width, source->Descriptor().height, copy.imageOffset.x, copy.imageOffset.y, width, height);
+    }
+    copy.imageExtent = {width,height,1};
+    context.Function<PFN_vkCmdCopyImageToBuffer>("vkCmdCopyImageToBuffer")(commands,source->Image(),VK_IMAGE_LAYOUT_GENERAL,output->Handle(),1,&copy);
+    image.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    image.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    VkBufferMemoryBarrier host{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    host.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    host.srcQueueFamilyIndex = host.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    host.buffer = output->Handle(); host.size = size;
+    barrier(commands,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,0,0,nullptr,1,&host,1,&image);
+    recorder.Keep(source); recorder.Keep(output);
+    recorder.OnComplete([source,output,address,width,height,format,path=std::string(filename)] {
+        const std::uint32_t header[]{width,height,static_cast<std::uint32_t>(format)};
+        const auto bytes = output->Bytes();
+        if (auto* file=std::fopen(path.c_str(),"wb")) {
+            std::fwrite(header,sizeof(header),1,file); std::fwrite(bytes.data(),1,bytes.size(),file); std::fclose(file);
+            std::fprintf(stderr,"[black-compute] GPU image=%llx bytes=%zu file=%s\n",static_cast<unsigned long long>(address),bytes.size(),path.c_str());
+        } else throw std::runtime_error("black compute capture file open failed");
+    });
+}

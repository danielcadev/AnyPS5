+class StderrCapture {
+public:
+    StderrCapture() : file(std::tmpfile()) {
+        if (file == nullptr) throw std::runtime_error("flat store: cannot create stderr capture file");
+        std::fflush(stderr);
+#ifdef _WIN32
+        saved = _dup(_fileno(stderr));
+        if (saved < 0 || _dup2(_fileno(file), _fileno(stderr)) != 0) {
+            if (saved >= 0) _close(saved);
+#else
+        saved = dup(fileno(stderr));
+        if (saved < 0 || dup2(fileno(file), fileno(stderr)) < 0) {
+            if (saved >= 0) close(saved);
+#endif
+            std::fclose(file);
+            file = nullptr;
+            throw std::runtime_error("flat store: cannot redirect stderr for BDA fault assertion");
+        }
+    }
+
+    ~StderrCapture() {
+        restore();
+        if (file != nullptr) std::fclose(file);
+    }
+
+    std::string Finish() {
+        restore();
+        if (std::fseek(file, 0, SEEK_END) != 0) throw std::runtime_error("flat store: cannot seek captured stderr");
+        const auto length = std::ftell(file);
+        if (length < 0) throw std::runtime_error("flat store: cannot size captured stderr");
+        std::rewind(file);
+        std::string result(static_cast<std::size_t>(length), '\0');
+        if (std::fread(result.data(), 1, result.size(), file) != result.size())
+            throw std::runtime_error("flat store: cannot read captured stderr");
+        return result;
+    }
+
+private:
+    void restore() noexcept {
+        if (saved < 0) return;
+        std::fflush(stderr);
+#ifdef _WIN32
+        _dup2(saved, _fileno(stderr));
+        _close(saved);
+#else
+        dup2(saved, fileno(stderr));
+        close(saved);
+#endif
+        saved = -1;
+    }
+
+    std::FILE* file = nullptr;
+    int saved = -1;
+};

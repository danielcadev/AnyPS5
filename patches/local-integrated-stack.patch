+    selfWrite[19] = 0x80010000u;
+    reject(selfWrite, "stores to the buffer it loads descriptors from", "nested table: a self-written pointer heap was accepted");
+
+    // Exercise ShaderMemory's pending-known-value route, not only an immutable request view.
+    // The pending pointer selects target 1, whose pending T# differs from its old host bytes.
+    struct alignas(4096) PendingGuest {
+        std::array<std::uint32_t, 16> root{};
+        std::array<std::uint32_t, 2u * Stride / 4u> heap{};
+        std::array<std::uint32_t, 0x410u / 4u> targets[2]{};
+        std::array<std::uint32_t, 2> pointer{};
+        std::array<std::uint32_t, 8> image{};
+        std::array<std::uint32_t, 4> output{};
+    };
+    static PendingGuest pending;
+    pending.root = {};
+    pending.heap = {};
+    pending.targets[0] = first;
+    pending.targets[1] = second;
+    const auto pendingV = TableV(pending.heap.data(), 0u, sizeof(pending.heap));
+    const auto pendingOutput = TableV(pending.output.data(), 0u, sizeof(pending.output));
+    std::copy(pendingV.begin(), pendingV.end(), pending.root.begin());
+    std::copy(pendingOutput.begin(), pendingOutput.end(), pending.root.begin() + 12);
+    const auto target0 = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(pending.targets[0].data()));
+    const auto target1 = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(pending.targets[1].data()));
+    pending.heap[0] = static_cast<std::uint32_t>(target0);
+    pending.heap[1] = static_cast<std::uint32_t>(target0 >> 32u);
+    pending.heap[Stride / 4u] = static_cast<std::uint32_t>(target1);
+    pending.heap[Stride / 4u + 1u] = static_cast<std::uint32_t>(target1 >> 32u);
+    pending.pointer = {static_cast<std::uint32_t>(target1), static_cast<std::uint32_t>(target1 >> 32u)};
+    pending.image = {};
+    std::copy(image2.begin(), image2.end(), pending.image.begin());
+    const auto known = [](std::uint64_t address, std::size_t bytes, std::span<std::byte> output) {
+        const auto patch = [&](const void* location, auto& words) {
+            const auto base = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(location));
+            if (address >= base + sizeof(words) || base >= address + bytes) return false;
+            if (!output.empty()) {
+                require(address >= base && bytes <= sizeof(words) && address - base <= sizeof(words) - bytes, "nested table: pending read crossed a known value");
+                std::memcpy(output.data(), reinterpret_cast<const std::byte*>(words.data()) + (address - base), bytes);
+            }
+            return true;
+        };
+        return patch(pending.heap.data(), pending.pointer) || patch(pending.targets[1].data() + 0x3d0u / 4u, pending.image) ? AgcDriver::ShaderMemory::PendingWrite::KnownValue : AgcDriver::ShaderMemory::PendingWrite::None;
+    };
+    TableRequest pendingTable(code, pending.root.data());
+    AgcDriver::ShaderMemory pendingMemory({}, known);
+    const auto settled = pendingMemory.Capture(pendingTable.request);
+    require(settled->snapshot.tables.images.size() == 1u && settled->snapshot.tables.images[0].words.dwords[0] == image2[0] && ViewCodes(settled->snapshot.tables, 0u)[0] == ViewCodes(settled->snapshot.tables, 0u)[1], "nested table: pending pointer or descriptor bytes were ignored");
+    const auto settledRegions = pendingMemory.Regions();
+    require(TableCovered(settledRegions, pending.heap.data(), 8u) && TableCovered(settledRegions, pending.targets[1].data() + 0x3d0u / 4u, 32u) && !TableTouched(settledRegions, pending.targets[0].data(), sizeof(pending.targets[0])), "nested table: the stale target was captured or a dependency was omitted");
+}

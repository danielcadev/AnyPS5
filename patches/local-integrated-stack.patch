+void RunBdaStoreFixtures(const Context& context) {
+    namespace Abi = ShaderRecompiler::BdaAbi;
+    constexpr std::uint64_t guest = 0x7fff23450000ULL;
+    constexpr std::uint32_t dataBytes = 64u;
+    Buffer data(context, dataBytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT);
+    Buffer fault(context, Abi::FaultBufferBytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    Buffer output(context, 8u * sizeof(std::uint32_t), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    std::uint32_t caseIndex = 0u;
+    const auto hex32 = [](std::uint32_t value) {
+        char text[11]{};
+        std::snprintf(text, sizeof(text), "0x%08x", value);
+        return std::string(text);
+    };
+    const auto run = [&](std::uint64_t base, std::uint32_t descriptorBytes, const std::vector<Abi::Range>& ranges,
+                         const std::vector<BdaStoreOperation>& operations, bool parallelWords,
+                         const std::array<std::byte, dataBytes>& initialData, const std::array<std::byte, dataBytes>& expectedData,
+                         Abi::FaultReason faultReason, std::uint64_t faultAddress, std::uint32_t faultBytes, std::uint32_t faultPc,
+                         const std::vector<std::uint32_t>& initialSlots, const std::vector<std::uint32_t>& expectedSlots,
+                         std::uint32_t expectedOverflow) {
+        std::memcpy(data.Bytes().data(), initialData.data(), initialData.size());
+        const Abi::Header header{Abi::Version, static_cast<std::uint32_t>(ranges.size()), sizeof(Abi::Range), 0u};
+        Buffer table(context, sizeof(header) + ranges.size() * sizeof(Abi::Range), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+        std::memcpy(table.Bytes().data(), &header, sizeof(header));
+        std::memcpy(table.Bytes().data() + sizeof(header), ranges.data(), ranges.size() * sizeof(Abi::Range));
+        std::memset(fault.Bytes().data(), 0, fault.Bytes().size());
+        for (std::uint32_t i = 0; i < initialSlots.size(); ++i) {
+            if (initialSlots[i] == 0u) continue;
+            std::memcpy(fault.Bytes().data() + (Abi::WrittenSlotsWord + i) * sizeof(std::uint32_t), &initialSlots[i], sizeof(std::uint32_t));
+        }
+        const std::uint32_t outputSentinel = 0xdeadbeefu;
+        for (std::uint32_t i = 0; i < 8u; ++i) std::memcpy(output.Bytes().data() + i * sizeof(outputSentinel), &outputSentinel, sizeof(outputSentinel));
+        ++caseIndex;
+        std::fprintf(stderr, "BDA store fixture case=%u\n", caseIndex);
+        const auto code = MakeBdaStoreTestShader({base, descriptorBytes, operations, parallelWords});
+        Pipeline pipeline(context, code, {&table, &fault, &output});
+        pipeline.Run(1u);
+
+
+        Require(std::memcmp(data.Bytes().data(), expectedData.data(), expectedData.size()) == 0, "BDA store fixture changed unexpected bytes");
+        Abi::Fault report{};
+        std::memcpy(&report, fault.Bytes().data(), sizeof(report));
+        if (faultReason == static_cast<Abi::FaultReason>(0u)) {
+            Require(report.state == Abi::FaultState::Empty, "successful BDA store fixture published a fault");
+        } else {
+            Require(report.state == Abi::FaultState::Ready && report.reason == faultReason && report.address == faultAddress &&
+                        report.bytes == faultBytes && report.instruction == faultPc,

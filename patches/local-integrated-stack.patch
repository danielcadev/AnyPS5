+// The runtime descriptor is decoded once, and conversion is shared by (numeric type, bit
+// width), rather than expanding every supported format at each guest load instruction.
+std::vector<SpirvBufferFormatInfo> RuntimeBufferFormats() {
+    std::vector<SpirvBufferFormatInfo> formats;
+    for (std::uint32_t format = 1u; format < 128u; ++format) {
+        try {
+            const auto info = GetFormatInfo(static_cast<IrBufferFormat>(format));
+            if (info.componentCount != 0u) formats.push_back(info);
+        } catch (const std::runtime_error&) {
+        }
+    }
+    return formats;

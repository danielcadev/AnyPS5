+void DrawDepth(AgcDriver::VulkanDevice& device) {
+    constexpr std::array<std::uint32_t, 6> vertexCode{
+        0xe0382000u, 0x80000005u, 0xbf8c3f70u, 0xf80008cfu, 0x03020100u, 0xbf810000u,
+    };
+    constexpr std::array<std::array<float, 4>, 3> vertices{{
+        {-1.0f, -1.0f, 0.375f, 1.0f}, {3.0f, -1.0f, 0.375f, 1.0f}, {-1.0f, 3.0f, 0.375f, 1.0f},
+    }};
+    const auto address = reinterpret_cast<std::uintptr_t>(vertices.data());
+    const std::array<std::uint32_t, 4> vertexData{
+        static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu) | (16u << 16u), 3u, 0x01016facu,
+    };
+    const std::array<ShaderRecompiler::MemoryRegion, 1> vertexMemory{{
+        {reinterpret_cast<std::uintptr_t>(vertexCode.data()), std::as_bytes(std::span(vertexCode))},
+    }};
+    ShaderRecompiler::RecompileRequest vertexRequest{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(vertexCode.data()), vertexCode, 0, {}},
+        {32, 0, vertexData, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, vertexMemory},
+        device.Target(), {0, 0, 0, 64},
+    };
+    vertexRequest.useCache = false;
+    const auto vertex = ShaderRecompiler::Recompile(vertexRequest);
+    constexpr std::array<std::uint32_t, 1> fragmentCode{0xbf810000u};
+    const std::array<ShaderRecompiler::MemoryRegion, 1> fragmentMemory{{
+        {reinterpret_cast<std::uintptr_t>(fragmentCode.data()), std::as_bytes(std::span(fragmentCode))},
+    }};
+    ShaderRecompiler::ShaderPixelStageInfo pixel{};
+    pixel.wave32 = true;
+    const auto offset = static_cast<std::uint32_t>(vertex.pushConstants.size());
+    ShaderRecompiler::RecompileRequest fragmentRequest{
+        {ShaderStage::Fragment, reinterpret_cast<std::uintptr_t>(fragmentCode.data()), fragmentCode, 0, {}},
+        {32, 0, {}, std::nullopt, pixel, std::nullopt, fragmentMemory},
+        device.Target(), {0, 0, offset, 128u - offset},
+    };
+    fragmentRequest.useCache = false;
+    const auto fragment = ShaderRecompiler::Recompile(fragmentRequest);
+    const std::array<AgcDriver::Graphics::CompiledShader, 2> shaders{{
+        {ShaderStage::Vertex, &vertex, 0}, {ShaderStage::Fragment, &fragment, offset},
+    }};
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, 32u, 32u, std::nullopt, std::nullopt};
+    state.depth = AgcDriver::Graphics::DepthTarget{
+        reinterpret_cast<std::uintptr_t>(DepthGuest.data()), 0, {Width * 2u, Height * 2u}, VK_FORMAT_D32_SFLOAT, 1.0f, 0,
+    };
+    state.depthTest = true;
+    state.depthWrite = true;
+    state.depthCompare = VK_COMPARE_OP_ALWAYS;
+    state.renderExtent = state.depth->extent;
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(Height * 2u), static_cast<float>(Width * 2u), -static_cast<float>(Height * 2u), 0, 1};
+    state.scissor = {{0, 0}, state.renderExtent};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    device.Draw(state, {0, 3, 0, 1, 0, false}, shaders);
+    device.WaitIdle();
+}

index 000000000..991fe92af
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/execution/FiniteImageDescriptor.cpp
@@ -0,0 +1,161 @@
+#include "prx/libSceAgcDriver/Execution/include/VulkanDevice.hpp"
+#include "Recompiler.hpp"
+#include "VulkanTestDevice.hpp"
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstdio>
+#include <iostream>
+#include <span>
+#include <string>
+
+namespace {
+
+using AgcDriver::Graphics::Require;
+using ShaderRecompiler::ShaderStage;
+
+constexpr std::uint32_t Threads = 64;
+constexpr std::uint32_t ActiveThreads = 47;
+constexpr std::uint32_t Format32Float = 22;
+constexpr std::uint32_t Type2D = 9;
+constexpr std::uint32_t Sentinel = 0x7fc0deadu;
+constexpr std::array<float, 4> TextureValues{11.25f, 23.5f, 47.75f, 95.125f};
+
+alignas(256) std::array<std::array<float, 64>, 4> Texels{};
+alignas(256) std::array<std::uint32_t, Threads> Output{};
+// Minimal synthetic root used by the GPU fixture: output descriptor, fixed sampler,
+// then four contiguous eight-word image descriptors. The recovered flat-SRT planner
+// slot IDs are not guest-root byte offsets and are intentionally not reused here.
+constexpr std::size_t ImageDescriptorsOffset = 8u;
+constexpr std::size_t SrtWords = ImageDescriptorsOffset + 4u * 8u;
+alignas(256) std::array<std::uint32_t, SrtWords> Srt{};
+
+// clang -target amdgcn-amd-amdhsa -mcpu=gfx1030, assembled from the paired
+// finite-image-descriptor-gfx1030.s fixture note. Keep the source assembly as the
+// readable authority and this .text array as the bytes consumed by Recompile.
+alignas(256) constexpr std::array<std::uint32_t, 137> ShaderCode{{
+    0xbebc0400u, 0xf408001eu, 0xfa000000u, 0xf408021eu, 0xfa000010u, 0xf40c041eu,
+    0xfa000020u, 0xf40c061eu, 0xfa000040u, 0xf40c081eu, 0xfa000060u, 0xf40c0a1eu,
+    0xfa000080u, 0xbf8cc07fu, 0xd7650000u, 0x000100c1u, 0xd7660000u, 0x000200c1u,
+    0x36020083u, 0x342a0082u, 0xbeb8047eu, 0x7e140210u, 0x7e160211u, 0x7e180212u,
+    0x7e1a0213u, 0x7e1c0214u, 0x7e1e0215u, 0x7e200216u, 0x7e220217u, 0xd4c2006au,
+    0x00010301u, 0xd501000au, 0x01a8310au, 0xd501000bu, 0x01a8330bu, 0xd501000cu,
+    0x01a8350cu, 0xd501000du, 0x01a8370du, 0xd501000eu, 0x01a8390eu, 0xd501000fu,
+    0x01a83b0fu, 0xd5010010u, 0x01a83d10u, 0xd5010011u, 0x01a83f11u, 0xd4c2006au,
+    0x00010501u, 0xd501000au, 0x01a8410au, 0xd501000bu, 0x01a8430bu, 0xd501000cu,
+    0x01a8450cu, 0xd501000du, 0x01a8470du, 0xd501000eu, 0x01a8490eu, 0xd501000fu,
+    0x01a84b0fu, 0xd5010010u, 0x01a84d10u, 0xd5010011u, 0x01a84f11u, 0xd4c2006au,
+    0x00010701u, 0xd501000au, 0x01a8510au, 0xd501000bu, 0x01a8530bu, 0xd501000cu,
+    0x01a8550cu, 0xd501000du, 0x01a8570du, 0xd501000eu, 0x01a8590eu, 0xd501000fu,
+    0x01a85b0fu, 0xd5010010u, 0x01a85d10u, 0xd5010011u, 0x01a85f11u, 0xbec22438u,
+    0xbeba047eu, 0xbebe0380u, 0xbefe043au, 0x7e60050au, 0x7e62050bu, 0x7e64050cu,
+    0x7e66050du, 0x7e68050eu, 0x7e6a050fu, 0x7e6c0510u, 0x7e6e0511u, 0xbec0047eu,
+    0xd4c2006au, 0x0000610au, 0x87c06a40u, 0xd4c2006au, 0x0000630bu, 0x87c06a40u,
+    0xd4c2006au, 0x0000650cu, 0x87c06a40u, 0xd4c2006au, 0x0000670du, 0x87c06a40u,
+    0xd4c2006au, 0x0000690eu, 0x87c06a40u, 0xd4c2006au, 0x00006b0fu, 0x87c06a40u,
+    0xd4c2006au, 0x00006d10u, 0x87c06a40u, 0xd4c2006au, 0x00006f11u, 0x87c06a40u,
+    0xbefe0440u, 0x7e0402f0u, 0x7e0602f0u, 0xf09c0108u, 0x004c1402u, 0xbf8c3f70u,
+    0xe0701000u, 0x80001415u, 0xbf8c3f70u, 0xbefe043au, 0x8aba403au, 0x803e813eu,
+    0xbf12803au, 0xbf850002u, 0xbf0a843eu, 0xbf85ffceu, 0xbf810000u
+}};
+
+std::array<std::uint32_t, 4> BufferDescriptor(const void* data, std::uint32_t bytes) {
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    return {static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu), bytes, 0x01016facu};
+}
+
+std::array<std::uint32_t, 8> ImageDescriptor(const float* texels) {
+    const auto address = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(texels));
+    return {
+        static_cast<std::uint32_t>(address >> 8u),
+        static_cast<std::uint32_t>((address >> 40u) & 0xffu) | (Format32Float << 20u),
+        0u,
+        0xfacu | (Type2D << 28u),
+        0u,
+        0u,
+        0u,
+        0u,
+    };
+}
+
+void PrepareResources() {
+    Srt.fill(0u);
+    const auto output = BufferDescriptor(Output.data(), static_cast<std::uint32_t>(sizeof(Output)));
+    std::copy(output.begin(), output.end(), Srt.begin());
+    // Fixed point-clamp sampler used by the reproduced image sample.
+    constexpr std::array<std::uint32_t, 4> Sampler{0x92u, 0x00fff000u, 0x05500000u, 0u};
+    std::copy(Sampler.begin(), Sampler.end(), Srt.begin() + 4);
+
+    for (std::size_t family = 0; family < Texels.size(); ++family) {
+        Texels[family][0] = TextureValues[family];
+        const auto descriptor = ImageDescriptor(Texels[family].data());
+        const auto first = ImageDescriptorsOffset + family * descriptor.size();
+        std::copy(descriptor.begin(), descriptor.end(), Srt.begin() + first);
+    }
+}
+
+ShaderRecompiler::RecompileResult Compile(AgcDriver::VulkanDevice& device) {
+    const std::span<const std::uint32_t> code(ShaderCode);
+    const auto root = reinterpret_cast<std::uintptr_t>(Srt.data());
+    const std::array<std::uint32_t, 2> userData{static_cast<std::uint32_t>(root), static_cast<std::uint32_t>(root >> 32u)};
+    const std::array<ShaderRecompiler::MemoryRegion, 4> memory{{
+        {reinterpret_cast<std::uintptr_t>(code.data()), std::as_bytes(code)},
+        {reinterpret_cast<std::uintptr_t>(Srt.data()), std::as_bytes(std::span(Srt))},
+        {reinterpret_cast<std::uintptr_t>(Texels.data()), std::as_bytes(std::span(Texels))},
+        {reinterpret_cast<std::uintptr_t>(Output.data()), std::as_bytes(std::span(Output))},
+    }};
+    const ShaderRecompiler::ShaderComputeStageInfo compute{{ActiveThreads, 1, 1}, 0u, {true, false, false}, false, 1};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Compute, reinterpret_cast<std::uintptr_t>(code.data()), code, 0, {}},
+        {64, 0, userData, compute, std::nullopt, std::nullopt, memory},
+        device.Target(),
+        {0, 0, 0, 128}
+    };
+    request.useCache = false;
+    return ShaderRecompiler::Recompile(request);
+}
+
+void CheckFiniteImagePlan(const ShaderRecompiler::RecompileResult& shader) {
+    std::uint32_t sampledImages = 0;
+    for (const auto& binding : shader.bindings) {
+        if (binding.kind == ShaderRecompiler::DescriptorKind::SampledImage) sampledImages += binding.count;
+    }
+    Require(sampledImages == TextureValues.size(),
+            "finite image descriptor: the four selected T# families did not produce four sampled images");
+}
+
+void Run(AgcDriver::VulkanDevice& device) {
+    PrepareResources();
+    Output.fill(Sentinel);
+    const auto shader = Compile(device);
+    CheckFiniteImagePlan(shader);
+    device.Dispatch(shader, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(ShaderCode.data()));
+    device.WaitIdle();
+
+    for (std::uint32_t lane = 0; lane < ActiveThreads; ++lane) {
+        const auto expected = std::bit_cast<std::uint32_t>(TextureValues[lane & 3u]);
+        Require(Output[lane] == expected,
+                "finite image descriptor: lane " + std::to_string(lane) + " returned " +
+                    std::to_string(Output[lane]) + ", expected " + std::to_string(expected));
+    }
+    for (std::uint32_t lane = ActiveThreads; lane < Threads; ++lane) {
+        Require(Output[lane] == Sentinel,
+                "finite image descriptor: inactive lane " + std::to_string(lane) + " modified its sentinel");
+    }
+}
+
+} // namespace
+
+int main() {
+    try {
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        Run(*device);
+        std::puts("finite image descriptor tests passed");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}

+        std::memcpy(&overflow, fault.Bytes().data() + Abi::WrittenOverflowWord * sizeof(std::uint32_t), sizeof(overflow));
+        Require(overflow == expectedOverflow, "BDA store fixture published an incorrect written-page overflow flag");
+        for (std::uint32_t slot = 0; slot < Abi::WrittenPageSlots; ++slot) {
+            std::uint32_t actual = 0u;
+            std::memcpy(&actual, fault.Bytes().data() + (Abi::WrittenSlotsWord + slot) * sizeof(std::uint32_t), sizeof(actual));
+            Require(actual == expectedSlots[slot], std::string("BDA store fixture written-page mismatch case=") + std::to_string(caseIndex) +
+                    " slot=" + std::to_string(slot) + " actual=" + hex32(actual) + " expected=" + hex32(expectedSlots[slot]));
+        }
+        if (parallelWords) {
+            for (std::uint32_t lane = 0; lane < 8u; ++lane) {
+                std::uint32_t actual = 0u;
+                std::memcpy(&actual, output.Bytes().data() + lane * sizeof(actual), sizeof(actual));
+                Require(actual == 0xa55a5aa5u, "concurrent BDA store invocation did not reach its output sentinel");
+            }
+        } else {
+            std::uint32_t actual = 0u;
+            std::memcpy(&actual, output.Bytes().data(), sizeof(actual));
+            Require(actual == 0xa55a5aa5u, "BDA store fixture did not reach its output sentinel");
+        }
+    };

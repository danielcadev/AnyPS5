+
+constexpr std::uint32_t ProducerWidth = 128;
+constexpr std::uint32_t ProducerHeight = 256;
+constexpr std::uint32_t TileWidth = 128;
+constexpr std::uint32_t TileHeight = 128;
+constexpr std::uint32_t ConsumerWidth = 192;
+constexpr std::uint32_t ConsumerHeight = 108;
+constexpr std::uint32_t Threads = 32;
+constexpr std::uint32_t Format8888UNorm = 56;
+constexpr std::uint32_t Type2D = 9;
+constexpr std::uint32_t TileR64KBX = 0x1b;
+constexpr std::uint32_t ClampEdge = 2;
+constexpr std::uint32_t FilterPoint = 0;
+constexpr std::uint32_t LessEqual = 3;
+float* Input = nullptr;
+float* Output = nullptr;
+std::uint32_t* Extra = nullptr;
+
+alignas(256) constexpr std::array<std::uint32_t, 6> VertexCode{
+    0xe0382000, 0x80000005, 0xbf8c3f70, 0xf80008cf, 0x03020100, 0xbf810000,
+};
+alignas(256) constexpr std::array<std::uint32_t, 4> PixelCode{
+    0x7e0e02f2, 0xf800180f, 0x07070707, 0xbf810000,
+};
+alignas(256) constexpr std::array<std::uint32_t, 13> SampleCode{
+    0x1614008c, 0xe03c1000, 0x8000010a, 0xbf8c3f70, 0xf0bc0108, 0x00820401, 0xbf8c3f70,
+    0x34160082, 0xe0701000, 0x8001040b, 0xbf810000, 0xbf810000, 0xbf810000,
+};
+
+class GuestBlock {
+public:
+    explicit GuestBlock(std::size_t bytes) : bytes((bytes + 65535u) & ~std::size_t{65535u}) {
+#ifdef _WIN32
+        block = static_cast<std::byte*>(GuestArena::GuestArenaAllocate_nid_postfix(this->bytes, 65536));
+        Require(block != nullptr, "depth/color handoff: cannot reserve guest bytes");
+        GuestArena::GuestArenaCommit_nid_postfix(block, this->bytes, PAGE_READWRITE, this->bytes);
+#else
+        block = static_cast<std::byte*>(std::aligned_alloc(65536, this->bytes));
+#endif
+        Require(block != nullptr, "depth/color handoff: cannot allocate aligned guest bytes");
+        std::fill_n(block, this->bytes, std::byte{0});
+        GuestAllocations::Mutation().Add(block, this->bytes, true, true);
+    }
+    ~GuestBlock() {
+        if (registered) GuestAllocations::Mutation().Remove(block);
+#ifdef _WIN32
+        GuestArena::GuestArenaReset_nid_postfix(block, bytes);
+        GuestArena::GuestArenaRelease_nid_postfix(block, bytes);
+#else
+        std::free(block);
+#endif
+    }
+    std::byte* data() const { return block; }
+    std::size_t size() const { return bytes; }
+    void ReRegisterWithoutDepthRebind() {
+        Require(registered, "depth/color handoff: allocation unexpectedly unregistered");
+        GuestAllocations::Mutation().Remove(block);
+        registered = false;
+        GuestAllocations::Mutation().Add(block, bytes, true, true);
+        registered = true;
+    }
+
+private:
+    std::byte* block = nullptr;
+    std::size_t bytes;
+    bool registered = true;
+};
+
+std::uint64_t EquationOffset(const AgcDriver::Graphics::TextureSwizzleEquation& equation, std::uint32_t x, std::uint32_t y) {
+    std::uint64_t offset = 0;
+    for (std::uint32_t bit = 0; bit < 16; ++bit) {
+        const auto mask = equation.bits[bit];
+        const auto selected = (x & (mask & 0xfffu)) ^ ((y << 12u) & (mask & 0xfff000u));
+        offset |= static_cast<std::uint64_t>(std::popcount(selected) & 1u) << bit;
+    }
+    return offset;
+}
+
+std::uint64_t SurfaceOffset(std::uint32_t width, std::uint32_t height, std::uint32_t x, std::uint32_t y) {
+    AgcDriver::Graphics::GuestTextureResource descriptor{};
+    descriptor.width = width;
+    descriptor.height = height;
+    descriptor.mipCount = 1;
+    descriptor.tileMode = TextureTileMode::kR64KBX;
+    descriptor.dimension = TextureDimension::k2D;
+    descriptor.format = Format8888UNorm;
+    const auto surface = AgcDriver::Graphics::DescribeSurface(descriptor);
+    const auto layout = AgcDriver::Graphics::ComputeMipLayout(TextureTileMode::kR64KBX, Format8888UNorm, width, height, 1);
+    const auto block = AgcDriver::Graphics::ThinBlockLayout(TextureTileMode::kR64KBX, 4);
+    Require(layout.size() == 1 && block[0] == 65536u && block[1] == TileWidth && block[2] == TileHeight,
+            "depth/color handoff: unexpected R64KBX RGBA8 macro-tile layout");
+    Require(x < width && y < height, "depth/color handoff: oracle coordinate outside descriptor");
+    const auto& mip = layout.front();
+    const auto blockX = x / block[1];
+    const auto blockY = y / block[2];
+    const auto blockIndex = static_cast<std::uint64_t>(blockY) * mip.blocksPerRow + blockX;
+    const auto within = EquationOffset(*AgcDriver::Graphics::FindTextureSwizzleEquation(TileR64KBX, 4), x % block[1], y % block[2]);
+    const auto offset = mip.tiledOffset + blockIndex * block[0] + within;
+    Require(offset + 4u <= surface.guestBytes, "depth/color handoff: oracle offset escaped surface bytes");
+    return offset;
+}
+
+std::array<std::uint32_t, 4> BufferDescriptor(const void* data, std::uint32_t bytes) {
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    return {static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu), bytes, 0x01016facu};
+}
+
+std::array<std::uint32_t, 4> VertexDescriptor(const void* data) {
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    return {static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu) | (16u << 16u), 3u, 0x01016facu};
+}
+
+std::array<std::uint32_t, 8> TextureDescriptor(const void* data, std::uint32_t width, std::uint32_t height) {
+    const auto address = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(data));
+    return {
+        static_cast<std::uint32_t>(address >> 8u),
+        static_cast<std::uint32_t>((address >> 40u) & 0xffu) | (Format8888UNorm << 20u) | (((width - 1u) & 3u) << 30u),
+        ((width - 1u) >> 2u) | ((height - 1u) << 14u),
+        0xfacu | (TileR64KBX << 20u) | (Type2D << 28u),
+        0u, 0u, 0u, 0u,
+    };
+}
+
+std::array<std::uint32_t, 4> SamplerDescriptor() {
+    return {ClampEdge | (ClampEdge << 3u) | (ClampEdge << 6u) | (LessEqual << 12u), 0u, (FilterPoint << 20u) | (FilterPoint << 22u), 0u};
+}
+
+ShaderRecompiler::RecompileResult CompileSample(AgcDriver::VulkanDevice& device, const void* guest, std::uint32_t waveSize, std::uint32_t width, std::uint32_t height) {
+    std::vector<std::uint32_t> userData(24, 0u);
+    const auto input = BufferDescriptor(Input, static_cast<std::uint32_t>(sizeof(float) * Threads * 3u));
+    const auto output = BufferDescriptor(Output, static_cast<std::uint32_t>(sizeof(float) * Threads));
+    const auto texture = TextureDescriptor(guest, width, height);
+    const auto sampler = SamplerDescriptor();
+    std::copy(input.begin(), input.end(), userData.begin());
+    std::copy(output.begin(), output.end(), userData.begin() + 4);
+    std::copy(texture.begin(), texture.end(), userData.begin() + 8);
+    std::copy(sampler.begin(), sampler.end(), userData.begin() + 16);
+    const auto extra = BufferDescriptor(Extra, static_cast<std::uint32_t>(sizeof(std::uint32_t) * Threads * 3u));
+    std::copy(extra.begin(), extra.end(), userData.begin() + 20);
+    const std::array<ShaderRecompiler::MemoryRegion, 1> memory{{{reinterpret_cast<std::uintptr_t>(SampleCode.data()), std::as_bytes(std::span(SampleCode))}}};
+    const ShaderRecompiler::ShaderComputeStageInfo compute{{Threads, 1, 1}, 0u, {false, false, false}, false, 1};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Compute, reinterpret_cast<std::uintptr_t>(SampleCode.data()), SampleCode, 0, {}},
+        {waveSize, 0, userData, compute, std::nullopt, std::nullopt, memory},
+        device.Target(),
+        {0, 0, 0, 128}
+    };
+    request.useCache = false;
+    return ShaderRecompiler::Recompile(request);
+}
+
+void DrawPartialColor(AgcDriver::VulkanDevice& device, void* colorGuest, std::uint32_t waveSize, void* depthGuest = nullptr) {
+    const auto target = device.Target();
+    std::vector<std::uint32_t> vertexUserData(4, 0u);
+    constexpr std::array<std::array<float, 4>, 3> triangle{{
+        {-1.0f, -1.0f, 0.5f, 1.0f}, {3.0f, -1.0f, 0.5f, 1.0f}, {-1.0f, 3.0f, 0.5f, 1.0f}
+    }};
+    const auto vertexBuffer = VertexDescriptor(triangle.data());
+    std::copy(vertexBuffer.begin(), vertexBuffer.end(), vertexUserData.begin());
+    const std::array<ShaderRecompiler::MemoryRegion, 1> vertexMemory{{{reinterpret_cast<std::uintptr_t>(VertexCode.data()), std::as_bytes(std::span(VertexCode))}}};
+    ShaderRecompiler::RecompileRequest vertex{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(VertexCode.data()), VertexCode, 0, {}},
+        {waveSize, 0, vertexUserData, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, vertexMemory},
+        target,
+        {0, 0, 0, 64}
+    };
+    vertex.useCache = false;
+    const auto vertexResult = ShaderRecompiler::Recompile(vertex);
+    ShaderRecompiler::ShaderPixelStageInfo pixel{};
+    pixel.wave32 = waveSize == 32u;
+    pixel.inputAddr = ShaderRecompiler::PixelInputBit(ShaderRecompiler::PixelInput::PositionX) | ShaderRecompiler::PixelInputBit(ShaderRecompiler::PixelInput::PositionY);
+    pixel.posX = true;
+    pixel.posY = true;
+    pixel.targetOutputMode[0] = 9;
+    pixel.targetExportMapping.fill(0xe4u);
+    const std::vector<std::uint32_t> pixelUserData(8, 0u);
+    const std::array<ShaderRecompiler::MemoryRegion, 1> pixelMemory{{{reinterpret_cast<std::uintptr_t>(PixelCode.data()), std::as_bytes(std::span(PixelCode))}}};
+    ShaderRecompiler::RecompileRequest fragment{
+        {ShaderStage::Fragment, reinterpret_cast<std::uintptr_t>(PixelCode.data()), PixelCode, 0, {}},
+        {waveSize, 0, pixelUserData, std::nullopt, pixel, std::nullopt, pixelMemory},
+        target,
+        {0, 0, static_cast<std::uint32_t>(vertexResult.pushConstants.size()), 128 - static_cast<std::uint32_t>(vertexResult.pushConstants.size())}
+    };
+    fragment.useCache = false;
+    const auto pixelResult = ShaderRecompiler::Recompile(fragment);
+    const std::array<AgcDriver::Graphics::CompiledShader, 2> shaders{{
+        {ShaderStage::Vertex, &vertexResult, 0},
+        {ShaderStage::Fragment, &pixelResult, static_cast<std::uint32_t>(vertexResult.pushConstants.size())}
+    }};
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, waveSize, waveSize, std::nullopt, std::nullopt};
+    AgcDriver::Graphics::GuestTextureResource producer{};
+    producer.width = ProducerWidth;
+    producer.height = ProducerHeight;
+    producer.mipCount = 1;
+    producer.tileMode = TextureTileMode::kR64KBX;
+    producer.dimension = TextureDimension::k2D;
+    producer.format = Format8888UNorm;
+    const auto producerBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+    state.color = {reinterpret_cast<std::uintptr_t>(colorGuest), {ProducerWidth, ProducerHeight}, VK_FORMAT_R8G8B8A8_UNORM, static_cast<std::size_t>(producerBytes), 0xe4u};
+    state.color.tileMode = AgcDriver::Graphics::ColorTileMode::RenderTarget;
+    state.color.elementBytes = 4;
+    state.colors = {state.color};
+    state.hasColorTarget = true;
+    if (depthGuest != nullptr) state.depth = AgcDriver::Graphics::DepthTarget{reinterpret_cast<std::uintptr_t>(depthGuest), 0, {ProducerWidth, ProducerHeight}, VK_FORMAT_D32_SFLOAT, 1.0f, 0};
+    state.depthWrite = false;
+    state.stencilTest = false;
+    state.renderExtent = {ProducerWidth, ProducerHeight};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(ProducerHeight), static_cast<float>(ProducerWidth), -static_cast<float>(ProducerHeight), 0, 1};
+    state.negativeOneToOne = false;
+    state.scissor = {{0, TileHeight}, {2, 2}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    state.blend.colorWriteMask = 15;
+    state.blends = {state.blend};
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(triangle.size()), 0, 1, 0, false};
+    device.Draw(state, draw, shaders);
+}
+
+void RebindDepthOnly(AgcDriver::VulkanDevice& device, void* guest, std::uint32_t waveSize) {
+    const auto target = device.Target();
+    constexpr std::array<std::array<float, 4>, 3> triangle{{
+        {-1.0f, -1.0f, 0.5f, 1.0f}, {3.0f, -1.0f, 0.5f, 1.0f}, {-1.0f, 3.0f, 0.5f, 1.0f}
+    }};
+    const auto buffer = VertexDescriptor(triangle.data());
+    const std::vector<std::uint32_t> userData(buffer.begin(), buffer.end());
+    const std::array<ShaderRecompiler::MemoryRegion, 1> memory{{{reinterpret_cast<std::uintptr_t>(VertexCode.data()), std::as_bytes(std::span(VertexCode))}}};
+    ShaderRecompiler::RecompileRequest vertex{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(VertexCode.data()), VertexCode, 0, {}},
+        {waveSize, 0, userData, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, memory},
+        target,
+        {0, 0, 0, 64}
+    };
+    vertex.useCache = false;
+    const auto result = ShaderRecompiler::Recompile(vertex);
+    constexpr std::array<std::uint32_t, 1> noExportPixelCode{0xbf810000u};
+    const std::array<ShaderRecompiler::MemoryRegion, 1> pixelMemory{{{reinterpret_cast<std::uintptr_t>(noExportPixelCode.data()), std::as_bytes(std::span(noExportPixelCode))}}};
+    ShaderRecompiler::ShaderPixelStageInfo pixel{};
+    pixel.wave32 = waveSize == 32u;
+    ShaderRecompiler::RecompileRequest fragment{
+        {ShaderStage::Fragment, reinterpret_cast<std::uintptr_t>(noExportPixelCode.data()), noExportPixelCode, 0, {}},
+        {waveSize, 0, {}, std::nullopt, pixel, std::nullopt, pixelMemory},
+        target,
+        {0, 0, static_cast<std::uint32_t>(result.pushConstants.size()), 128 - static_cast<std::uint32_t>(result.pushConstants.size())}
+    };
+    fragment.useCache = false;
+    const auto pixelResult = ShaderRecompiler::Recompile(fragment);
+    const std::array<AgcDriver::Graphics::CompiledShader, 2> shaders{{
+        {ShaderStage::Vertex, &result, 0},
+        {ShaderStage::Fragment, &pixelResult, static_cast<std::uint32_t>(result.pushConstants.size())}
+    }};
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, waveSize, waveSize, std::nullopt, std::nullopt};
+    state.depth = AgcDriver::Graphics::DepthTarget{reinterpret_cast<std::uintptr_t>(guest), 0, {ProducerWidth, ProducerHeight}, VK_FORMAT_D32_SFLOAT, 1.0f, 0};
+    state.renderExtent = {ProducerWidth, ProducerHeight};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(ProducerHeight), static_cast<float>(ProducerWidth), -static_cast<float>(ProducerHeight), 0, 1};
+    state.negativeOneToOne = false;
+    state.scissor = {{0, 0}, {ProducerWidth, ProducerHeight}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(triangle.size()), 0, 1, 0, false};
+    device.Draw(state, draw, shaders);
+}
+
+void SetSamples(std::uint32_t width, std::uint32_t height, bool direct) {
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = direct ? tid % 4u : 126u + tid % 16u;
+        const auto y = direct ? TileHeight + tid / 4u : tid / 16u;
+        Input[tid * 3u] = 0.5f;
+        Input[tid * 3u + 1u] = (static_cast<float>(x) + 0.5f) / static_cast<float>(width);
+        Input[tid * 3u + 2u] = (static_cast<float>(y) + 0.5f) / static_cast<float>(height);
+    }
+}
+
+void DispatchAndWait(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result) {
+    std::fill_n(Output, Threads, -1.0f);
+    device.Dispatch(result, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(SampleCode.data()));
+    device.WaitIdle();
+}
+
+void DispatchThroughResourceProof(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result) {
+    Require(AgcDriver::VulkanDevice::DispatchRecipes(), "depth/color handoff: dispatch recipes are disabled, so the real ShaderResources proof route cannot run");
+    const auto programAddress = reinterpret_cast<std::uintptr_t>(SampleCode.data());
+    std::shared_ptr<const AgcDriver::Recipe> recipe;
+    device.Dispatch(result, 1, 1, 1, {}, programAddress, nullptr, &recipe);
+    device.WaitIdle();
+    Require(recipe != nullptr, "depth/color handoff: compute dispatch did not produce a reusable resource recipe");
+    auto hit = device.PrepareRecipe(recipe, false);
+    Require(hit != nullptr, "depth/color handoff: actual resource recipe failed its precheck");
+    auto verify = device.PrepareDispatch(result, {});
+    AgcDriver::VulkanDevice::IndirectOutcome outcome{};
+    AgcDriver::RecipeOutcome recorded;
+    {
+        std::lock_guard lock(AgcDriver::GuestMemory::GpuMutex());
+        recorded = device.DispatchRecipe(result, 1, 1, 1, 0, programAddress, hit, outcome, verify);
+    }
+    Require(recorded == AgcDriver::RecipeOutcome::Recorded,
+            "depth/color handoff: ShaderResources::ProveCurrent rejected the completed color publication");
+    device.WaitIdle();
+}
+
+void ExpectUnsupported(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result, const char* label) {
+    try {
+        DispatchAndWait(device, result);
+    } catch (const std::exception& error) {
+        Require(std::string_view(error.what()).find("not implemented") != std::string_view::npos,
+                std::string("depth/color handoff: ") + label + " refused for an unrelated reason: " + error.what());
+        return;
+    }
+    Require(false, std::string("depth/color handoff: ") + label + " reused an invalid color owner");
+}
+
+void Run(AgcDriver::VulkanDevice& device, GuestBlock& directGuest, GuestBlock& crossGuest, GuestBlock& guest, GuestBlock& unrelated) {
+    // Synthetic RGBA8 layout deliberately changes macro-tile row stride: producer 128x256 has
+    // one tile per row, consumer 192x108 has two tiles per row. Producer (0,128) occupies physical
+    // tile 1, which the consumer addresses at (128,0). This is a mechanism fixture, not observed
+    // Yotei color geometry; the traced 3840x2160 dimensions were a depth surface.
+    AgcDriver::Graphics::GuestTextureResource producer{};
+    producer.width = ProducerWidth;
+    producer.height = ProducerHeight;
+    producer.mipCount = 1;
+    producer.tileMode = TextureTileMode::kR64KBX;
+    producer.dimension = TextureDimension::k2D;
+    producer.format = Format8888UNorm;
+    const auto producerBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+    AgcDriver::Graphics::GuestTextureResource consumer = producer;
+    consumer.width = ConsumerWidth;
+    consumer.height = ConsumerHeight;
+    const auto consumerBytes = AgcDriver::Graphics::DescribeSurface(consumer).guestBytes;
+    const auto producerLayout = AgcDriver::Graphics::ComputeMipLayout(TextureTileMode::kR64KBX, Format8888UNorm, ProducerWidth, ProducerHeight, 1);
+    const auto consumerLayout = AgcDriver::Graphics::ComputeMipLayout(TextureTileMode::kR64KBX, Format8888UNorm, ConsumerWidth, ConsumerHeight, 1);
+    Require(producerBytes == consumerBytes && producer.width != consumer.width && producerLayout[0].blocksPerRow == 1u && consumerLayout[0].blocksPerRow == 2u,
+            "depth/color handoff: fixture does not produce equal-span, different-stride descriptors with CanCopyFrom-incompatible extents");
+    std::fill_n(directGuest.data(), static_cast<std::size_t>(producerBytes), std::byte{0x20});
+    std::fill(directGuest.data() + producerBytes, directGuest.data() + directGuest.size(), std::byte{0x5a});
+    std::vector<std::byte> directExpected(directGuest.data(), directGuest.data() + directGuest.size());
+    for (std::uint32_t y = TileHeight; y < TileHeight + 2u; ++y) {
+        for (std::uint32_t x = 0; x < 2u; ++x) {
+            const auto offset = SurfaceOffset(ProducerWidth, ProducerHeight, x, y);
+            std::fill_n(directExpected.data() + offset, 4, std::byte{0xff});
+        }
+    }
+    const auto waveSize = device.Target().subgroupSize >= 64u ? 64u : 32u;
+    const auto producerChanged = SurfaceOffset(ProducerWidth, ProducerHeight, 0, TileHeight);
+    // Draw creates the resident color image before it binds depth (Graphics::Draw target setup
+    // precedes DepthSurfaceView). The later depth bind is read-only; synchronous completion then
+    // registers the still-pending resident image as this alias's color owner.
+    DrawPartialColor(device, directGuest.data(), waveSize, directGuest.data());
+    Require(directGuest.data()[producerChanged] == std::byte{0x20}, "depth/color handoff: resident color writeback happened before the pending-owner sample");
+    SetSamples(ProducerWidth, ProducerHeight, true);
+    const auto direct = CompileSample(device, directGuest.data(), waveSize, ProducerWidth, ProducerHeight);
+    DispatchAndWait(device, direct);
+    Require(std::equal(directExpected.begin(), directExpected.end(), directGuest.data()),
+            "depth/color handoff: direct view refresh differs from the complete producer-and-padding byte oracle");
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = tid % 4u;
+        const auto y = TileHeight + tid / 4u;
+        const auto offset = SurfaceOffset(ProducerWidth, ProducerHeight, x, y);
+        const float expectedValue = std::to_integer<unsigned>(directExpected[offset]) >= 128u ? 1.0f : 0.0f;
+        Require(std::fabs(Output[tid] - expectedValue) < 1e-4f, "depth/color handoff: direct-view pixel differs from producer-byte oracle");
+    }
+    SetSamples(ConsumerWidth, ConsumerHeight, false);
+    const auto directFallback = CompileSample(device, directGuest.data(), waveSize, ConsumerWidth, ConsumerHeight);
+    ExpectUnsupported(device, directFallback, "unwatched alias after refresh published the resident image");
+
+    // A fresh base tests cross-geometry sampling while the resident image is still pending.
+    // Do not first sample the producer dimensions: an untracked refresh of that view legitimately
+    // publishes the guest bytes and invalidates the pending-owner proof.
+    std::fill_n(crossGuest.data(), static_cast<std::size_t>(producerBytes), std::byte{0x20});
+    std::fill(crossGuest.data() + producerBytes, crossGuest.data() + crossGuest.size(), std::byte{0x5a});
+    std::vector<std::byte> crossExpected(crossGuest.data(), crossGuest.data() + crossGuest.size());
+    for (std::uint32_t y = TileHeight; y < TileHeight + 2u; ++y) {
+        for (std::uint32_t x = 0; x < 2u; ++x) {
+            std::fill_n(crossExpected.data() + SurfaceOffset(ProducerWidth, ProducerHeight, x, y), 4, std::byte{0xff});
+        }
+    }
+    DrawPartialColor(device, crossGuest.data(), waveSize, crossGuest.data());
+    Require(crossGuest.data()[producerChanged] == std::byte{0x20}, "depth/color handoff: cross-geometry resident writeback happened before the pending-owner sample");
+    SetSamples(ConsumerWidth, ConsumerHeight, false);
+    const auto crossFallback = CompileSample(device, crossGuest.data(), waveSize, ConsumerWidth, ConsumerHeight);
+    DispatchAndWait(device, crossFallback);
+    Require(std::equal(crossExpected.begin(), crossExpected.end(), crossGuest.data()),
+            "depth/color handoff: cross-geometry fallback differs from the complete producer-and-padding byte oracle");
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = 126u + tid % 16u;
+        const auto y = tid / 16u;
+        const auto consumerOffset = SurfaceOffset(ConsumerWidth, ConsumerHeight, x, y);
+        const float expectedValue = std::to_integer<unsigned>(crossExpected[consumerOffset]) >= 128u ? 1.0f : 0.0f;
+        Require(std::fabs(Output[tid] - expectedValue) < 1e-4f, "depth/color handoff: pending cross-geometry fallback differs from physical-byte oracle");
+    }
+
+    // This independent base first becomes a depth surface. A later color-only draw then follows
+    // the completed nonresident writeback path because storage-color caching rejects depth aliases.
+    std::fill_n(guest.data(), static_cast<std::size_t>(producerBytes), std::byte{0x20});
+    std::fill(guest.data() + producerBytes, guest.data() + guest.size(), std::byte{0x5a});
+    std::vector<std::byte> expected(guest.data(), guest.data() + guest.size());
+    for (std::uint32_t y = TileHeight; y < TileHeight + 2u; ++y) {
+        for (std::uint32_t x = 0; x < 2u; ++x) std::fill_n(expected.data() + SurfaceOffset(ProducerWidth, ProducerHeight, x, y), 4, std::byte{0xff});
+    }
+    RebindDepthOnly(device, guest.data(), waveSize);
+    SetSamples(ConsumerWidth, ConsumerHeight, false);
+    const auto fallback = CompileSample(device, guest.data(), waveSize, ConsumerWidth, ConsumerHeight);
+    ExpectUnsupported(device, fallback, "depth alias before completed color publication");
+
+    // Neither an unrelated producer draw nor a CPU-only byte write can publish the depth alias.
+    DrawPartialColor(device, unrelated.data(), waveSize, guest.data());
+    ExpectUnsupported(device, fallback, "unrelated color writer");
+    const auto cpuOnlyOffset = SurfaceOffset(ProducerWidth, ProducerHeight, 10u, 0u);
+    guest.data()[cpuOnlyOffset] = std::byte{0x21};
+    expected[cpuOnlyOffset] = std::byte{0x21};
+    ExpectUnsupported(device, fallback, "CPU-byte-only writer");
+
+    DrawPartialColor(device, guest.data(), waveSize);
+    DispatchAndWait(device, fallback);
+    Require(guest.data()[producerChanged] == std::byte{0xff}, "depth/color handoff: completed nonresident draw failed to publish the producer tile");
+    const auto untouchedProducer = SurfaceOffset(ProducerWidth, ProducerHeight, 4u, TileHeight);
+    Require(guest.data()[untouchedProducer] == std::byte{0x20}, "depth/color handoff: publication changed an untouched nonzero producer texel");
+    Require(guest.data()[producerBytes] == std::byte{0x5a}, "depth/color handoff: publication touched allocation padding");
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = 126u + tid % 16u;
+        const auto y = tid / 16u;
+        const auto consumerOffset = SurfaceOffset(ConsumerWidth, ConsumerHeight, x, y);
+        const float expectedValue = std::to_integer<unsigned>(expected[consumerOffset]) >= 128u ? 1.0f : 0.0f;
+        Require(std::fabs(Output[tid] - expectedValue) < 1e-4f, "depth/color handoff: published content differs from physical-byte oracle at consumer texel " + std::to_string(x) + "," + std::to_string(y));
+    }
+    DispatchThroughResourceProof(device, fallback);
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = 126u + tid % 16u;
+        const auto y = tid / 16u;
+        const auto consumerOffset = SurfaceOffset(ConsumerWidth, ConsumerHeight, x, y);
+        const float expectedValue = std::to_integer<unsigned>(expected[consumerOffset]) >= 128u ? 1.0f : 0.0f;
+        Require(std::fabs(Output[tid] - expectedValue) < 1e-4f, "depth/color handoff: resource-proof reuse changed published content");
+    }
+
+    // Once issued, a one-byte guest change invalidates the exact publication snapshot.
+    guest.data()[cpuOnlyOffset] = std::byte{0x22};
+    ExpectUnsupported(device, fallback, "one-byte CPU mutation after publication");
+    RebindDepthOnly(device, guest.data(), waveSize);
+    ExpectUnsupported(device, fallback, "depth rebind after publication");
+
+    // A new publication must not pin GuestAllocations::Range; unregister/re-register changes identity.
+    DrawPartialColor(device, guest.data(), waveSize);
+    DispatchAndWait(device, fallback);
+    guest.ReRegisterWithoutDepthRebind();
+    ExpectUnsupported(device, fallback, "free/re-register without depth rebind");
+}
+}
+
+int main() {
+    try {
+        GuestBlock inputBuffer(sizeof(float) * Threads * 3u);
+        GuestBlock outputBuffer(sizeof(float) * Threads);
+        GuestBlock extraBuffer(sizeof(std::uint32_t) * Threads * 3u);
+        AgcDriver::Graphics::GuestTextureResource producer{};
+        producer.width = ProducerWidth;
+        producer.height = ProducerHeight;
+        producer.mipCount = 1;
+        producer.tileMode = TextureTileMode::kR64KBX;
+        producer.dimension = TextureDimension::k2D;
+        producer.format = Format8888UNorm;
+        const auto producerBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+        GuestBlock directGuest(static_cast<std::size_t>(producerBytes) + 65536u);
+        GuestBlock crossGuest(static_cast<std::size_t>(producerBytes) + 65536u);
+        GuestBlock guest(static_cast<std::size_t>(producerBytes) + 65536u);
+        GuestBlock unrelated(static_cast<std::size_t>(producerBytes));
+        Input = reinterpret_cast<float*>(inputBuffer.data());
+        Output = reinterpret_cast<float*>(outputBuffer.data());
+        Extra = reinterpret_cast<std::uint32_t*>(extraBuffer.data());
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        if (device->Target().subgroupSize < 32u) {
+            std::printf("skipped, subgroup size %u cannot run a wave32 fixture\n", device->Target().subgroupSize);
+            return VulkanTestSkipped;
+        }
+        Run(*device, directGuest, crossGuest, guest, unrelated);
+        std::puts("depth/color handoff content test passed");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}

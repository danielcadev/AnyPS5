+class GuestBlock {
+public:
+    GuestBlock() {
+#ifdef _WIN32
+        bytes = static_cast<std::byte*>(_aligned_malloc(Size, 65536));
+#else
+        bytes = static_cast<std::byte*>(std::aligned_alloc(65536, Size));
+#endif
+        Require(bytes != nullptr, "resize guest allocation failed");
+        std::memset(bytes, 0x5a, Size);
+        GuestAllocations::Mutation().Add(bytes, Size, true, true);
+    }
+    ~GuestBlock() {
+        GuestAllocations::Mutation().Remove(bytes);
+#ifdef _WIN32
+        _aligned_free(bytes);
+#else
+        std::free(bytes);
+#endif
+    }
+    static constexpr std::size_t Size = 4u << 20u;
+    std::byte* bytes = nullptr;
+};
+
+PFN_vkGetDeviceProcAddr realDeviceProc = nullptr;
+PFN_vkCmdCopyImageToBuffer realCopyImageToBuffer = nullptr;
+VkImage latestDepthImage = VK_NULL_HANDLE;
+VkImage extentAliasImage = VK_NULL_HANDLE;
+VkImage stencilExtentAliasImage = VK_NULL_HANDLE;
+VkImage depthCompareAliasImage = VK_NULL_HANDLE;
+bool failResizeStencilCopy = false;
+bool resizeDepthCopyRecorded = false;
+VKAPI_ATTR void VKAPI_CALL captureCopyImageToBuffer(VkCommandBuffer commands, VkImage image, VkImageLayout layout,
+    VkBuffer buffer, std::uint32_t count, const VkBufferImageCopy* regions) {
+    if (failResizeStencilCopy && count == 1) {
+        if (image == latestDepthImage && regions[0].imageSubresource.aspectMask == VK_IMAGE_ASPECT_DEPTH_BIT)
+            resizeDepthCopyRecorded = true;
+        else if (resizeDepthCopyRecorded && regions[0].imageSubresource.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT) {
+            failResizeStencilCopy = false;
+            throw std::runtime_error("injected resize stencil transfer failure");
+        }
+    }
+    realCopyImageToBuffer(commands, image, layout, buffer, count, regions);
+}
+VKAPI_ATTR VkResult VKAPI_CALL captureCreateImage(VkDevice device, const VkImageCreateInfo* info,
+    const VkAllocationCallbacks* allocator, VkImage* image) {
+    const auto create = reinterpret_cast<PFN_vkCreateImage>(realDeviceProc(device, "vkCreateImage"));
+    auto captured = *info;
+    const bool alias = (info->format == VK_FORMAT_R32_SFLOAT || info->format == VK_FORMAT_R8_UINT || info->format == VK_FORMAT_D32_SFLOAT) &&
+        info->extent.width == 256 && info->extent.height == 256;
+    // Test-only readback of the ordinary sampled snapshot, which normally needs no transfer source.
+    if (alias) captured.usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    const auto result = create(device, &captured, allocator, image);
+    if (result == VK_SUCCESS && info->format == VK_FORMAT_D32_SFLOAT_S8_UINT) latestDepthImage = *image;
+    if (result == VK_SUCCESS && alias) {
+        if (info->format == VK_FORMAT_D32_SFLOAT) depthCompareAliasImage = *image;
+        else if (info->format == VK_FORMAT_R8_UINT) stencilExtentAliasImage = *image;
+        else extentAliasImage = *image;
+    }
+    return result;
+}
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL captureDeviceProc(VkDevice device, const char* name) {
+    if (std::strcmp(name, "vkCreateImage") == 0) return reinterpret_cast<PFN_vkVoidFunction>(captureCreateImage);
+    if (std::strcmp(name, "vkCmdCopyImageToBuffer") == 0) return reinterpret_cast<PFN_vkVoidFunction>(captureCopyImageToBuffer);
+    return realDeviceProc(device, name);
+}
+
+GuestTextureResource plane(const DepthTarget& target, bool stencil) {
+    GuestTextureResource result{};
+    result.baseAddress = stencil ? target.stencilAddress : target.address;
+    result.width = target.extent.width;
+    result.height = target.extent.height;
+    result.mipCount = 1;
+    result.tileMode = TextureTileMode::kZ64KBX;
+    result.dimension = TextureDimension::k2D;
+    result.format = stencil ? 5u : 22u;
+    result.dstSelX = 4; result.dstSelY = 5; result.dstSelZ = 6; result.dstSelW = 7;
+    return result;
+}
+
+struct PlaneOracle {
+    VkExtent2D extent;
+    std::uint32_t element;
+    TileMipLayout mip;
+    std::array<std::uint32_t, 3> block;
+    const TextureSwizzleEquation* equation;
+    PlaneOracle(VkExtent2D extent, std::uint32_t element, TextureTileMode tile=TextureTileMode::kZ64KBX) : extent(extent), element(element),
+        mip(ComputeElementMipLayout(tile, element, extent.width, extent.height, 1).front()),
+        block(ThinBlockLayout(tile, element)),
+        equation(FindTextureSwizzleEquation(XorSwizzleMode(tile), element)) {
+        Require(equation != nullptr && !mip.tail, "resize oracle requires whole XOR-swizzled blocks");
+    }
+    std::size_t offset(std::uint32_t x, std::uint32_t y) const {
+        std::uint64_t inside = 0;
+        for (std::uint32_t bit = 0; bit < 16; ++bit) {
+            const auto mask = equation->bits[bit];
+            const auto selected = (x & (mask & 0xfffu)) ^ ((y << 12u) & (mask & 0xfff000u));
+            inside |= static_cast<std::uint64_t>(std::popcount(selected) & 1u) << bit;
+        }
+        return mip.tiledOffset + (static_cast<std::uint64_t>(y / block[2]) * mip.blocksPerRow + x / block[1]) * block[0] + inside;
+    }
+    std::vector<std::byte> linear(const std::vector<std::byte>& physical) const {
+        std::vector<std::byte> result(static_cast<std::size_t>(extent.width) * extent.height * element);
+        for (std::uint32_t y = 0; y < extent.height; ++y) for (std::uint32_t x = 0; x < extent.width; ++x)
+            std::memcpy(result.data() + (static_cast<std::size_t>(y) * extent.width + x) * element, physical.data() + offset(x,y), element);
+        return result;
+    }
+    void pattern(std::vector<std::byte>& physical, unsigned seed) const {
+        for (std::uint32_t y = 0; y < extent.height; ++y) for (std::uint32_t x = 0; x < extent.width; ++x) {
+            if (element == 4) {
+                const float value = static_cast<float>(1u + (x * 7u + y * 11u + seed) % 127u) / 256.0f;
+                std::memcpy(physical.data() + offset(x,y), &value, 4);
+            } else physical[offset(x,y)] = std::byte{static_cast<unsigned char>((x * 13u + y * 17u + seed) & 255u)};
+        }
+    }
+};
+
+void upload(const Context& context, Recorder& recorder, const std::shared_ptr<StorageTexture>& target,
+            std::span<const std::byte> bytes) {
+    auto staging = std::make_shared<Buffer>(context, bytes.size(), VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+    std::memcpy(staging->Bytes().data(), bytes.data(), bytes.size());
+    const auto commands = recorder.Commands();
+    RecordMemoryBarrier(context, commands, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {target->Descriptor().width, target->Descriptor().height, 1};
+    context.Function<PFN_vkCmdCopyBufferToImage>("vkCmdCopyBufferToImage")(commands, staging->Handle(), target->Image(), VK_IMAGE_LAYOUT_GENERAL, 1, &copy);
+    RecordMemoryBarrier(context, commands, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+    recorder.Keep(staging); recorder.Keep(target);
+    target->MarkDirty();
+}
+
+std::vector<std::byte> readPlane(const Context& context, Recorder& recorder, VkImage image, VkImageAspectFlags aspect,
+                               VkExtent2D extent, std::uint32_t element, VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL) {
+    auto output = std::make_shared<Buffer>(context, static_cast<std::size_t>(extent.width) * extent.height * element, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    const auto commands = recorder.Commands();
+    RecordMemoryBarrier(context, commands, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    const auto transition = [&](VkImageLayout from, VkImageLayout to) {
+        VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        barrier.srcAccessMask=VK_ACCESS_MEMORY_READ_BIT|VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier.dstAccessMask=VK_ACCESS_MEMORY_READ_BIT|VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier.oldLayout=from; barrier.newLayout=to;
+        barrier.srcQueueFamilyIndex=barrier.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+        barrier.image=image; barrier.subresourceRange={aspect,0,1,0,1};
+        context.Function<PFN_vkCmdPipelineBarrier>("vkCmdPipelineBarrier")(commands,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+            VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,0,0,nullptr,0,nullptr,1,&barrier);
+    };
+    if (layout!=VK_IMAGE_LAYOUT_GENERAL) transition(layout,VK_IMAGE_LAYOUT_GENERAL);
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {aspect, 0, 0, 1};
+    copy.imageExtent = {extent.width, extent.height, 1};
+    context.Function<PFN_vkCmdCopyImageToBuffer>("vkCmdCopyImageToBuffer")(commands, image, VK_IMAGE_LAYOUT_GENERAL, output->Handle(), 1, &copy);
+    if (layout!=VK_IMAGE_LAYOUT_GENERAL) transition(VK_IMAGE_LAYOUT_GENERAL,layout);
+    RecordMemoryBarrier(context, commands, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+    recorder.Keep(output);
+    recorder.Sync();
+    const auto bytes = output->Bytes();
+    return {bytes.begin(), bytes.end()};
+}
+
+struct DrawFixture {
+    ShaderRecompiler::RecompileResult vertex, fragment;
+    std::uint32_t offset;
+    explicit DrawFixture(std::byte* memory) {
+        constexpr std::array<std::uint32_t, 6> vertexCode{0xe0382000u,0x80000005u,0xbf8c3f70u,0xf80008cfu,0x03020100u,0xbf810000u};
+        constexpr std::array<std::array<float,4>,3> vertices{{{-1,-1,0.0625f,1},{3,-1,0.0625f,1},{-1,3,0.0625f,1}}};
+        std::memcpy(memory, vertices.data(), sizeof(vertices));
+        const auto address = reinterpret_cast<std::uintptr_t>(memory);
+        const std::array<std::uint32_t,4> userdata{static_cast<std::uint32_t>(address),static_cast<std::uint32_t>(address>>32u)|(16u<<16u),3u,0x01016facu};
+        const std::array<ShaderRecompiler::MemoryRegion,1> codeMemory{{{reinterpret_cast<std::uintptr_t>(vertexCode.data()),std::as_bytes(std::span(vertexCode))}}};
+        ShaderRecompiler::SpirvTarget target{};
+        target.vulkanVersion=VK_API_VERSION_1_1; target.spirvVersion=0x00010300u; target.subgroupSize=32;
+        ShaderRecompiler::RecompileRequest request{
+            {ShaderRecompiler::ShaderStage::Vertex,reinterpret_cast<std::uintptr_t>(vertexCode.data()),vertexCode,0,{}},
+            {32,0,userdata,std::nullopt,std::nullopt,ShaderRecompiler::ShaderVertexStageInfo{},codeMemory},target,{0,0,0,64}};
+        request.useCache=false; vertex=ShaderRecompiler::Recompile(request); vertex.variantId=0;
+        constexpr std::array<std::uint32_t,1> fragmentCode{0xbf810000u};
+        const std::array<ShaderRecompiler::MemoryRegion,1> fragmentMemory{{{reinterpret_cast<std::uintptr_t>(fragmentCode.data()),std::as_bytes(std::span(fragmentCode))}}};
+        ShaderRecompiler::ShaderPixelStageInfo pixel{}; pixel.wave32=true;
+        offset=static_cast<std::uint32_t>(vertex.pushConstants.size());
+        ShaderRecompiler::RecompileRequest fragmentRequest{
+            {ShaderRecompiler::ShaderStage::Fragment,reinterpret_cast<std::uintptr_t>(fragmentCode.data()),fragmentCode,0,{}},
+            {32,0,{},std::nullopt,pixel,std::nullopt,fragmentMemory},target,{0,0,offset,PipelinePushConstantBytes-offset}};
+        fragmentRequest.useCache=false; fragment=ShaderRecompiler::Recompile(fragmentRequest); fragment.variantId=0;
+    }
+    static State state(const DepthTarget& target) {
+        State state{}; state.stages={ShaderPath::Vertex,0u,32u,32u,std::nullopt,std::nullopt};
+        state.depth=target; state.depthTest=true; state.depthWrite=true; state.depthCompare=VK_COMPARE_OP_ALWAYS;
+        state.stencilTest=true;
+        state.stencilFront={VK_STENCIL_OP_KEEP,VK_STENCIL_OP_REPLACE,VK_STENCIL_OP_KEEP,VK_COMPARE_OP_ALWAYS,0xff,0xff,0x7b};
+        state.stencilBack=state.stencilFront;
+        state.renderExtent=target.extent; state.topology=VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        state.viewport={0,static_cast<float>(target.extent.height),static_cast<float>(target.extent.width),-static_cast<float>(target.extent.height),0,1};
+        state.scissor={{0,0},{16,16}}; state.cullMode=VK_CULL_MODE_NONE; state.frontFace=VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        return state;
+    }
+    void draw(const Context& context,const DepthTarget& target) {
+        const std::array<CompiledShader,2> shaders{{{ShaderRecompiler::ShaderStage::Vertex,&vertex,0},{ShaderRecompiler::ShaderStage::Fragment,&fragment,offset}}};
+        Draw(context,state(target),{0,3,0,1,0,false},shaders);
+    }
+};
+
+void expectMixedWriterRejected(const Context& context, const DepthTarget& target, ShaderRecompiler::RecompileResult writer) {
+    const CompiledShader shader{ShaderRecompiler::ShaderStage::Compute,&writer,0};
+    ShaderResources resources(context,shader);
+    const auto state=DrawFixture::state(target);
+    for (bool stencil : {false,true}) {
+        bool rejected=false;
+        try {
+            if (stencil) CheckDepthSurfaceStencilWrites(context,state,&resources);
+            else CheckDepthSurfaceDepthWrites(context,state,&resources);
+        } catch (const std::runtime_error& error) {
+            Require(std::string_view(error.what()).find("simultaneous shader")!=std::string_view::npos,"resize mixed writer failed for unrelated reason");
+            rejected=true;
+        }
+        Require(rejected,"resize admitted a simultaneous shader writer");
+    }
+}
+
+void run(const Device& device) {
+    GuestBlock guest;
+    std::unique_lock gpu(AgcDriver::GuestMemory::GpuMutex());
+    auto context=device.GetContext();
+    DescriptorCache descriptors(context); context.descriptorCache=&descriptors;
+    TextureDetiler detiler(context); context.detiler=&detiler;
+    TextureCache textureCache(context); context.textureCache=&textureCache;
+    realDeviceProc=context.deviceProc;
+    realCopyImageToBuffer=context.Function<PFN_vkCmdCopyImageToBuffer>("vkCmdCopyImageToBuffer");
+    context.deviceProc=&captureDeviceProc;
+    Recorder recorder(context); recorder.Activate();
+    struct Cleanup {
+        const Context& context; Recorder& recorder;
+        ~Cleanup() {
+            try {
+                recorder.Sync(); SharedResourceCache().Clear(); ClearCachedPipelines(context.device);
+                ClearCachedTextures(context.device); ClearDepthSurfaces(context.device); recorder.Sync();
+            } catch (const std::exception& error) { std::fprintf(stderr,"resize cleanup: %s\n",error.what()); }
+        }
+    } cleanup{context,recorder};
+    const auto base=reinterpret_cast<std::uintptr_t>(guest.bytes);
+    const DepthTarget a{base,base+(1u<<20u),{384,384},VK_FORMAT_D32_SFLOAT_S8_UINT,0.5f,0x35};
+    auto b=a; b.extent={256,256};
+    PlaneOracle ad(a.extent,4),as(a.extent,1),bd(b.extent,4),bs(b.extent,1);
+    Require(ad.mip.blocksPerRow!=bd.mip.blocksPerRow && as.mip.blocksPerRow!=bs.mip.blocksPerRow,"resize fixture does not change both tile strides");
+    std::vector<std::byte> expectedDepth(ad.mip.tiledSize,std::byte{0x5a}),expectedStencil(as.mip.tiledSize,std::byte{0x5a});
+    ad.pattern(expectedDepth,3); as.pattern(expectedStencil,7);
+    // A real GPU clear is newer than the guest's 0.25 values. An incompatible extent
+    // must read that producer through physical Z64KBX bytes, never the stale guest.
+    std::vector<std::byte> physicalDepth(ad.mip.tiledSize);
+    const float guestDepth=0.25f,gpuDepth=0.5f;
+    for (std::size_t offset=0;offset<physicalDepth.size();offset+=4)
+        std::memcpy(physicalDepth.data()+offset,&guestDepth,4);
+    AgcDriver::GuestMemory::Write(a.address,physicalDepth,4);
+    const auto aView=DepthSurfaceView(context,a); const auto aImage=latestDepthImage;
+    for (std::uint32_t y=0;y<a.extent.height;++y) for (std::uint32_t x=0;x<a.extent.width;++x)
+        std::memcpy(physicalDepth.data()+ad.offset(x,y),&gpuDepth,4);
+    auto depthExtent=DepthSurfaceStorageTexture(context,plane(b,false),0);
+    Require(depthExtent && readPlane(context,recorder,depthExtent->Image(),VK_IMAGE_ASPECT_COLOR_BIT,b.extent,4)==bd.linear(physicalDepth),
+        "flagless smaller R32 storage read stale guest 0.25 instead of GPU depth 0.5");
+    const auto untouchedStencil=readPlane(context,recorder,aImage,VK_IMAGE_ASPECT_STENCIL_BIT,a.extent,1);
+    Require(std::all_of(untouchedStencil.begin(),untouchedStencil.end(),[](auto value){return value==std::byte{0x35};}),
+        "smaller R32 storage changed the native stencil plane");
+    const float smallerDepth=0.125f;
+    for (std::uint32_t y=0;y<b.extent.height;++y) for (std::uint32_t x=0;x<b.extent.width;++x)
+        std::memcpy(physicalDepth.data()+bd.offset(x,y),&smallerDepth,4);
+    upload(context,recorder,depthExtent,bd.linear(physicalDepth));
+    Require(depthExtent->AnyLayerPending(),"smaller R32 writer did not remain pending");
+    Require(DepthSurfaceView(context,a)==aView,"smaller R32 storage retired the current attachment");
+    Require(readPlane(context,recorder,aImage,VK_IMAGE_ASPECT_DEPTH_BIT,a.extent,4)==ad.linear(physicalDepth),
+        "A/B/A lost smaller R32 writes or depth outside B");
+    Require(DepthSurfaceStorageTexture(context,plane(b,false),0)==depthExtent &&
+        readPlane(context,recorder,depthExtent->Image(),VK_IMAGE_ASPECT_COLOR_BIT,b.extent,4)==bd.linear(physicalDepth),
+        "smaller R32 resample lost the shared storage owner or its latest pixels");
+    Require(readPlane(context,recorder,aImage,VK_IMAGE_ASPECT_STENCIL_BIT,a.extent,1)==untouchedStencil,
+        "A/B/A R32 reconciliation changed stencil");
+    {
+        auto unorm=plane(b,true); unorm.format=1u; unorm.tileMode=TextureTileMode::kR64KBX;
+        PlaneOracle colorStencil(b.extent,1,TextureTileMode::kR64KBX);
+        std::vector<std::byte> physicalStencil(as.mip.tiledSize,std::byte{0x5a});
+        for (std::uint32_t y=0;y<a.extent.height;++y) for (std::uint32_t x=0;x<a.extent.width;++x)
+            physicalStencil[as.offset(x,y)]=std::byte{0x35};
+        auto colorOwner=DepthSurfaceStorageTexture(context,unorm,0);
+        Require(colorOwner && colorOwner->StorageFormat()==VK_FORMAT_R8_UNORM &&
+            readPlane(context,recorder,colorOwner->Image(),VK_IMAGE_ASPECT_COLOR_BIT,b.extent,1)==colorStencil.linear(physicalStencil),
+            "smaller R8 color storage read old guest bytes instead of GPU S8 0x35");
+        const std::array<std::uint32_t,8> colorWords{static_cast<std::uint32_t>(a.stencilAddress>>8u),
+            static_cast<std::uint32_t>(a.stencilAddress>>40u)|0xc0100000u,
+            ((b.extent.height-1u)<<14u)|((b.extent.width-1u)>>2u),0x91b00facu,0,0x00700000u,0,0};
+        auto colorView=CachedSampledTexture(context,colorWords);
+        Require(colorView->SharedStorageSource()==colorOwner,"R8 sampled/storage alias did not share its image");
+        bool attachmentRejected=false;
+        try { static_cast<void>(CachedStorageSurface(context,unorm,true)); }
+        catch (const std::runtime_error&) { attachmentRejected=true; }
+        Require(attachmentRejected,"smaller R8 stencil alias admitted a color attachment");
+        for (bool written : {false,true}) {
+            ShaderRecompiler::RecompileResult program;
+            for (bool sampled : {true,false}) {
+                ShaderRecompiler::DescriptorBinding binding{};
+                binding.kind=sampled ? ShaderRecompiler::DescriptorKind::SampledImage : ShaderRecompiler::DescriptorKind::StorageImage;
+                binding.role=ShaderRecompiler::DescriptorRole::GuestImages;
+                binding.binding=sampled ? 10u : 36u; binding.count=1;
+                binding.imageShape=ShaderRecompiler::DescriptorImageShape::Image2D;
+                binding.guestDescriptor.assign(colorWords.begin(),colorWords.end());
+                if (sampled) binding.imageSamplers={0u};
+                else { binding.imageWritten={written}; binding.imageAtomic={false}; binding.imageAtomic64={false}; }
+                program.bindings.push_back(std::move(binding));
+            }
+            const CompiledShader shader{ShaderRecompiler::ShaderStage::Compute,&program,0};
+            ShaderResources resources(context,shader);
+            const auto images=resources.StorageImages();
+            Require(std::count_if(images.begin(),images.end(),[&](const auto& image){return image.first==colorOwner->Image();})==2 &&
+                resources.ReadsImage(colorOwner.get()),"R8 read/write shader bindings lost the stencil color owner");
+            Require(resources.Revalidate(shader),"smaller R8 color storage failed resource revalidation");
+            for (bool atomic64 : {false,true}) {
+                auto atomicProgram=program;
+                atomicProgram.bindings.back().imageWritten[0]=true;
+                if (atomic64) atomicProgram.bindings.back().imageAtomic64[0]=true;
+                else atomicProgram.bindings.back().imageAtomic[0]=true;
+                const CompiledShader atomicShader{ShaderRecompiler::ShaderStage::Compute,&atomicProgram,0};
+                bool rejected=false;
+                try { ShaderResources unsupported(context,atomicShader); }
+                catch (const std::runtime_error&) { rejected=true; }
+                Require(rejected,"smaller R8 stencil color alias admitted an atomic writer");
+            }
+        }
+        for (std::uint32_t y=0;y<b.extent.height;++y) for (std::uint32_t x=0;x<b.extent.width;++x)
+            if ((x+3u*y)%7u==0) physicalStencil[colorStencil.offset(x,y)]=std::byte{128};
+        Require(bs.linear(physicalStencil)!=colorStencil.linear(physicalStencil),
+            "R8 fixture does not distinguish Z64KBX and R64KBX byte layouts");
+        upload(context,recorder,colorOwner,colorStencil.linear(physicalStencil));
+        Require(colorOwner->AnyLayerPending(),"R8 UNORM byte-128 writer did not remain pending");
+        Require(DepthSurfaceView(context,a)==aView,"R8 stencil color writer retired A");
+        Require(readPlane(context,recorder,aImage,VK_IMAGE_ASPECT_STENCIL_BIT,a.extent,1)==as.linear(physicalStencil),
+            "A lost R64KBX byte-128 writes or S8 bytes outside B");
+        Require(readPlane(context,recorder,aImage,VK_IMAGE_ASPECT_DEPTH_BIT,a.extent,4)==ad.linear(physicalDepth),
+            "R8 stencil color reconciliation changed depth");
+        std::vector<std::byte> storedStencil(physicalStencil.size());
+        AgcDriver::GuestMemory::Read(a.stencilAddress,storedStencil,1);

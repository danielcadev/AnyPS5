+class HeapMirrorShaderProbe {
+public:
+    explicit HeapMirrorShaderProbe(const Context& context) : context(context), result(context, 2 * sizeof(std::uint32_t), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) {
+        try {
+            const std::array<VkDescriptorSetLayoutBinding, 2> bindings{{
+                {0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+                {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            }};
+            VkDescriptorSetLayoutCreateInfo setInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+            setInfo.bindingCount = static_cast<std::uint32_t>(bindings.size());
+            setInfo.pBindings = bindings.data();
+            Check(context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout")(
+                      context.device, &setInfo, nullptr, &setLayout), "heap mirror probe descriptor layout");
+            const VkDescriptorPoolSize poolSize{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2};
+            VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+            poolInfo.maxSets = 1;
+            poolInfo.poolSizeCount = 1;
+            poolInfo.pPoolSizes = &poolSize;
+            Check(context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool")(
+                      context.device, &poolInfo, nullptr, &pool), "heap mirror probe descriptor pool");
+            VkDescriptorSetAllocateInfo setAllocate{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+            setAllocate.descriptorPool = pool;
+            setAllocate.descriptorSetCount = 1;
+            setAllocate.pSetLayouts = &setLayout;
+            Check(context.Function<PFN_vkAllocateDescriptorSets>("vkAllocateDescriptorSets")(
+                      context.device, &setAllocate, &set), "heap mirror probe descriptor set");
+            VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+            layoutInfo.setLayoutCount = 1;
+            layoutInfo.pSetLayouts = &setLayout;
+            Check(context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout")(
+                      context.device, &layoutInfo, nullptr, &layout), "heap mirror probe pipeline layout");
+            const auto code = shader();
+            VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            moduleInfo.codeSize = code.size() * sizeof(std::uint32_t);
+            moduleInfo.pCode = code.data();
+            Check(context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule")(
+                      context.device, &moduleInfo, nullptr, &module), "heap mirror probe shader module");
+            std::array<VkComputePipelineCreateInfo, 2> infos{};
+            const std::array<const char*, 2> entries{"store", "read"};
+            for (std::size_t index = 0; index < infos.size(); ++index) {
+                infos[index].sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+                infos[index].stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                      VK_SHADER_STAGE_COMPUTE_BIT, module, entries[index], nullptr};
+                infos[index].layout = layout;
+                infos[index].basePipelineIndex = -1;
+            }
+            Check(context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(
+                      context.device, VK_NULL_HANDLE, static_cast<std::uint32_t>(infos.size()), infos.data(), nullptr,
+                      pipelines.data()), "heap mirror probe compute pipelines");
+        } catch (...) {
+            release();
+            throw;
+        }
+    }
+
+    ~HeapMirrorShaderProbe() { release(); }
+    HeapMirrorShaderProbe(const HeapMirrorShaderProbe&) = delete;
+    HeapMirrorShaderProbe& operator=(const HeapMirrorShaderProbe&) = delete;
+
+    void Store(const VkDescriptorBufferInfo& source) { run(0, source); }
+
+    std::array<std::uint32_t, 2> Read(const VkDescriptorBufferInfo& source) {
+        run(1, source);
+        std::array<std::uint32_t, 2> values{};
+        std::memcpy(values.data(), result.Bytes().data(), sizeof(values));
+        return values;
+    }
+
+private:
+    static std::vector<std::uint32_t> shader() {
+        std::vector<std::uint32_t> words{0x07230203u, 0x00010300u, 0u, 25u, 0u};
+        const auto emit = [&](std::uint16_t opcode, std::initializer_list<std::uint32_t> operands) {
+            words.push_back((static_cast<std::uint32_t>(operands.size() + 1) << 16u) | opcode);
+            words.insert(words.end(), operands.begin(), operands.end());
+        };
+        emit(17, {1}); // OpCapability Shader
+        emit(14, {0, 1}); // OpMemoryModel Logical GLSL450
+        emit(15, {5, 14, 0x726f7473u, 0x00000065u}); // OpEntryPoint GLCompute %store "store"
+        emit(15, {5, 17, 0x64616572u, 0u}); // OpEntryPoint GLCompute %read "read"
+        emit(16, {14, 17, 1, 1, 1}); // OpExecutionMode %store LocalSize 1 1 1
+        emit(16, {17, 17, 1, 1, 1}); // OpExecutionMode %read LocalSize 1 1 1
+        emit(71, {4, 6, 4}); // OpDecorate runtime array ArrayStride 4
+        emit(71, {5, 2}); // OpDecorate block Block
+        emit(72, {5, 0, 35, 0}); // OpMemberDecorate block 0 Offset 0
+        emit(71, {8, 34, 0}); // OpDecorate target DescriptorSet 0
+        emit(71, {8, 33, 0}); // OpDecorate target Binding 0
+        emit(71, {9, 34, 0}); // OpDecorate output DescriptorSet 0
+        emit(71, {9, 33, 1}); // OpDecorate output Binding 1
+        emit(19, {1}); // OpTypeVoid
+        emit(33, {2, 1}); // OpTypeFunction
+        emit(21, {3, 32, 0}); // OpTypeInt uint32
+        emit(29, {4, 3}); // OpTypeRuntimeArray uint
+        emit(30, {5, 4}); // OpTypeStruct runtime array
+        emit(32, {6, 12, 5}); // OpTypePointer StorageBuffer block
+        emit(32, {7, 12, 3}); // OpTypePointer StorageBuffer uint
+        emit(59, {6, 8, 12}); // OpVariable target StorageBuffer
+        emit(59, {6, 9, 12}); // OpVariable output StorageBuffer
+        emit(43, {3, 10, 0}); // OpConstant uint 0
+        emit(43, {3, 11, 1}); // OpConstant uint 1
+        emit(43, {3, 12, 16384}); // OpConstant uint (64 KiB / sizeof(uint))
+        emit(43, {3, 13, 0x5a69f00du}); // OpConstant uint GPU store pattern
+        emit(54, {1, 14, 0, 2}); // %store = OpFunction
+        emit(248, {15}); // OpLabel
+        emit(65, {7, 16, 8, 10, 10}); // OpAccessChain target[0]
+        emit(62, {16, 13}); // OpStore target[0] = GPU pattern
+        emit(253, {}); // OpReturn
+        emit(56, {}); // OpFunctionEnd
+        emit(54, {1, 17, 0, 2}); // %read = OpFunction
+        emit(248, {18}); // OpLabel
+        emit(65, {7, 19, 8, 10, 10}); // OpAccessChain target[0]
+        emit(61, {3, 20, 19}); // OpLoad target[0]
+        emit(65, {7, 21, 8, 10, 12}); // OpAccessChain target[16384]
+        emit(61, {3, 22, 21}); // OpLoad target[16384]
+        emit(65, {7, 23, 9, 10, 10}); // OpAccessChain output[0]
+        emit(62, {23, 20}); // OpStore output[0]
+        emit(65, {7, 24, 9, 10, 11}); // OpAccessChain output[1]
+        emit(62, {24, 22}); // OpStore output[1]
+        emit(253, {}); // OpReturn
+        emit(56, {}); // OpFunctionEnd
+        return words;
+    }
+
+    void run(std::size_t pipeline, const VkDescriptorBufferInfo& source) {
+        const VkDescriptorBufferInfo output{result.Handle(), 0, result.Bytes().size()};
+        VkWriteDescriptorSet writes[2]{{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET}, {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET}};
+        for (std::uint32_t index = 0; index < 2; ++index) {
+            writes[index].dstSet = set;
+            writes[index].dstBinding = index;
+            writes[index].descriptorCount = 1;
+            writes[index].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        }
+        writes[0].pBufferInfo = &source;
+        writes[1].pBufferInfo = &output;
+        context.Function<PFN_vkUpdateDescriptorSets>("vkUpdateDescriptorSets")(context.device, 2, writes, 0, nullptr);
+        CommandBatch batch(context);
+        RecordMemoryBarrier(context, batch.Handle(), VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                            VK_ACCESS_HOST_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+                            VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+        context.Function<PFN_vkCmdBindPipeline>("vkCmdBindPipeline")(
+            batch.Handle(), VK_PIPELINE_BIND_POINT_COMPUTE, pipelines[pipeline]);
+        context.Function<PFN_vkCmdBindDescriptorSets>("vkCmdBindDescriptorSets")(
+            batch.Handle(), VK_PIPELINE_BIND_POINT_COMPUTE, layout, 0, 1, &set, 0, nullptr);
+        context.Function<PFN_vkCmdDispatch>("vkCmdDispatch")(batch.Handle(), 1, 1, 1);
+        RecordMemoryBarrier(context, batch.Handle(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                            VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+        batch.SubmitAndWait();
+    }
+
+    void release() noexcept {
+        if (pipelines[0] != VK_NULL_HANDLE) context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline")(context.device, pipelines[0], nullptr);
+        if (pipelines[1] != VK_NULL_HANDLE) context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline")(context.device, pipelines[1], nullptr);
+        if (module != VK_NULL_HANDLE) context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule")(context.device, module, nullptr);
+        if (layout != VK_NULL_HANDLE) context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout")(context.device, layout, nullptr);
+        if (pool != VK_NULL_HANDLE) context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool")(context.device, pool, nullptr);
+        if (setLayout != VK_NULL_HANDLE) context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout")(context.device, setLayout, nullptr);
+    }
+
+    const Context& context;
+    Buffer result;
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    VkPipelineLayout layout = VK_NULL_HANDLE;
+    VkShaderModule module = VK_NULL_HANDLE;
+    std::array<VkPipeline, 2> pipelines{};
+};

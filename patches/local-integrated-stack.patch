+std::size_t ReleaseZeroSnapshotPages(std::span<std::byte> bytes) {
+#ifdef __linux__
+    static const auto pageSize = ::sysconf(_SC_PAGESIZE);
+    if (pageSize <= 0 || bytes.empty()) return 0;
+    const auto page = static_cast<std::size_t>(pageSize);
+    static const std::vector<std::byte> zeroPage(page);
+    const auto base = reinterpret_cast<std::uintptr_t>(bytes.data());
+    const auto first = (base + page - 1u) / page * page;
+    const auto end = (base + bytes.size()) / page * page;
+    std::size_t released = 0;
+    auto run = first;
+    const auto discard = [&](std::uintptr_t stop) {
+        if (stop > run && ::madvise(reinterpret_cast<void*>(run), stop - run, MADV_DONTNEED) == 0) released += stop - run;
+    };
+    for (auto cursor = first; cursor < end; cursor += page) {
+        if (std::memcmp(reinterpret_cast<const void*>(cursor), zeroPage.data(), page) == 0) continue;
+        discard(cursor);
+        run = cursor + page;
+    }
+    discard(end);
+    return released;
+#else
+    return 0;
+#endif
+}

+void importCapacityLifetimeTests(const Context& context) {
+    constexpr std::size_t allocationBytes = 4096;
+    const auto maxImportsEnv = std::getenv("APS5_MAX_HOST_IMPORTS");
+    const auto maxImports = static_cast<std::size_t>(maxImportsEnv != nullptr ? std::strtoull(maxImportsEnv, nullptr, 10) : 1024ull);
+    const std::size_t allocationCount = maxImports + 1;
+    constexpr std::size_t stride = 2 * allocationBytes;
+    const std::size_t bytes = stride * allocationCount;
+    auto* block = static_cast<std::uint8_t*>(::operator new(bytes, std::align_val_t{allocationBytes}));
+    const auto base = reinterpret_cast<std::uintptr_t>(block);
+    auto importing = context;
+    importing.hostImportAlignment = allocationBytes;
+    {
+        auto mutation = GuestAllocations::Mutation();
+        for (std::size_t i = 0; i < allocationCount; ++i) {
+            mutation.Add(block + i * stride, allocationBytes, true, false);
+        }
+    }
+
+    const auto* first = HostImportFor(importing, base, allocationBytes);
+    Require(first != nullptr, "the first capacity-test allocation was not imported");
+    const auto firstSerial = HostImportSerial(importing, base, allocationBytes, false);
+    Require(firstSerial != 0, "the first capacity-test import has no identity");
+    for (std::size_t i = 1; i < allocationCount; ++i) {
+        const auto* imported = HostImportFor(importing, base + i * stride, allocationBytes);
+        if (i < maxImports) Require(imported != nullptr, "an import was refused before reaching the capacity limit");
+        else Require(imported == nullptr, "the import capacity limit did not refuse the last allocation");
+    }
+    Require(HostImportSerial(importing, base, allocationBytes, false) == firstSerial, "capacity pressure retired an import still in use");
+    Require(HostImportSerial(importing, base + maxImports * stride, allocationBytes, false) == 0, "a refused import acquired an import identity instead of using the copy/mirror fallback");
+
+    {
+        auto mutation = GuestAllocations::Mutation();
+        for (std::size_t i = 0; i < allocationCount; ++i) {
+            mutation.Remove(block + i * stride);
+        }
+    }
+    Require(HostImportSerial(importing, base, allocationBytes, true) == 0, "capacity-test imports outlived their registrations");
+    ::operator delete(block, std::align_val_t{allocationBytes});
+}

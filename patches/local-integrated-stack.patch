+        supplement.context.memory = regions;
+        const auto text = ShaderRecompiler::RequestSerializer{}.Serialize(supplement);
+        const std::string name = std::string(originalName) + ".tables.req";
+        std::ofstream file;
+        file.exceptions(std::ios::failbit | std::ios::badbit);
+        file.open(name, std::ios::binary);
+        file.write(text.data(), static_cast<std::streamsize>(text.size()));
+        file.close();
+        std::fprintf(stderr, "[shader-table-request] %s root=0x%llx bytes=0x%zx slots=0..31 stride=0x20 read-columns=0x10 write-columns=0x830,0xc30 original=%s\n", name.c_str(), static_cast<unsigned long long>(root), bytes.size(), originalName);
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "[shader-table-request] 0x%llx root=0x%llx capture failed: %s\n", static_cast<unsigned long long>(address), static_cast<unsigned long long>(root), error.what());
+    }
+}

+void zeroSnapshotPageTests() {
+#ifdef __linux__
+    const auto page = static_cast<std::size_t>(::sysconf(_SC_PAGESIZE));
+    std::vector<std::byte> storage(page * 12u, std::byte{0x5a});
+    const auto aligned = (reinterpret_cast<std::uintptr_t>(storage.data()) + page - 1u) / page * page;
+    auto* start = reinterpret_cast<std::byte*>(aligned);
+    std::memset(start + page, 0, page * 8u);
+    start[page * 5u + 17u] = std::byte{0x77};
+    // Unaligned boundaries belong to the snapshot too, but must never be discarded.
+    const auto before = storage;
+    const auto span = std::span(start + 17u, page * 9u);
+    const auto released = ReleaseZeroSnapshotPages(span);
+    Require(released == page * 7u, "zero snapshot pages were not discarded exactly");
+    unsigned char resident[7]{};
+    Require(::mincore(start + page, page * 4u, resident) == 0,
+            "cannot query released snapshot residency");
+    for (unsigned index = 0; index < 4; ++index) Require((resident[index] & 1u) == 0, "zero snapshot page remains resident");
+    Require(storage == before, "releasing zero snapshot pages changed bytes or neighbouring allocation boundaries");
+    start[page * 3u] = std::byte{0x66};
+    Require(start[page * 3u] == std::byte{0x66} && start[page * 5u + 17u] == std::byte{0x77},
+            "a discarded snapshot page could not be written again");
+    std::cout << "zero snapshot pages released physically; nonzero bytes, boundaries and future writes preserved\n";
+#else
+    std::cout << "zero snapshot page release is Linux only\n";
+#endif
+}

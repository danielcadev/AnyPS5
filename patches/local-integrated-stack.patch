+std::vector<std::uint32_t> MakeBdaStoreTestShader(const BdaStoreTestShader& test) {
+    using namespace ShaderRecompiler;
+    AgcDriver::Graphics::Require(!test.operations.empty(), "BDA store fixture has no operations");
+    AgcDriver::Graphics::Require(test.descriptorBytes != 0u, "BDA store fixture has an empty descriptor");
+    IrProgram program;
+    program.Resources().stage = IrShaderStage::Compute;
+    program.Info().usesDma = true;
+    program.Info().bdaWrites = true;
+    for (const auto& operation : test.operations) {
+        AgcDriver::Graphics::Require(operation.bits == 8u || operation.bits == 16u || operation.bits == 32u, "invalid BDA store fixture width");
+        MemoryInfo memory;
+        memory.kind = ResourceKind::Buffer;
+        memory.dataBits = operation.bits;
+        memory.gpuDescriptor = true;
+        memory.coherent = operation.coherent;
+        program.Resources().memoryInfo.push_back(memory);
+    }
+    IrBuilder builder(program);
+    auto& block = program.CreateBlock();
+    builder.SetInsertionPoint(block);
+    const std::array<std::uint32_t, 4> descriptor{
+        static_cast<std::uint32_t>(test.guestAddress),
+        static_cast<std::uint32_t>(test.guestAddress >> 32u) | (test.parallelWords ? (4u << 16u) : 0u),
+        test.descriptorBytes, 0x31016facu};
+    auto& handle = builder.Emit(IrOpcode::GetBufferResource, IrType::BufferResource,
+                                {&builder.Constant(descriptor[0]), &builder.Constant(descriptor[1]), &builder.Constant(descriptor[2]), &builder.Constant(descriptor[3])});
+    std::vector<IrValue*> indices;
+    std::vector<IrValue*> values;
+    std::vector<IrValue*> stores;
+    indices.reserve(test.operations.size());
+    values.reserve(test.operations.size());
+    stores.reserve(test.operations.size());
+    for (std::uint32_t i = 0; i < test.operations.size(); ++i) {
+        const auto& operation = test.operations[i];
+        auto& index = test.parallelWords ? builder.Emit(IrOpcode::UndefU32, IrType::U32, {}) : builder.Constant(0u);
+        auto& value = builder.Emit(operation.bits == 8u ? IrOpcode::UndefU8 : operation.bits == 16u ? IrOpcode::UndefU16 : IrOpcode::UndefU32,
+                                   operation.bits == 8u ? IrType::U8 : operation.bits == 16u ? IrType::U16 : IrType::U32, {});
+        auto& offset = builder.Constant(operation.offset);
+        auto& soffset = builder.Constant(0u);
+        auto& active = builder.ConstantBool(true);
+        const auto opcode = operation.bits == 8u ? IrOpcode::StoreBufferU8 : operation.bits == 16u ? IrOpcode::StoreBufferU16 : IrOpcode::StoreBufferU32;
+        IrValue& store = builder.Emit(opcode, IrType::Void,
+                                      {&handle, &index, &offset, &soffset,
+                                       &value,
+                                       &active});
+        MemoryFlags flags{};
+        flags.index = i;
+        flags.pc = operation.pc;
+        store.SetFlags(flags);
+        indices.push_back(&index);
+        values.push_back(&value);
+        stores.push_back(&store);
+    }
+
+    SpirvEmitterState state(program, {});
+    EmitBaseHeader(state.module, program);
+    state.module.EmitCapability(spv::CapabilityGroupNonUniform);
+    const auto define = [&](std::uint32_t binding) {
+        const auto variable = state.module.DefineGlobalVariable(TypeStorageBufferPointer(state), spv::StorageClassStorageBuffer);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationDescriptorSet, 0u);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationBinding, binding);
+        return variable;
+    };
+    state.bdaPagetableVariable = define(0u);
+    state.faultBufferVariable = define(1u);
+    const auto output = define(2u);
+    state.subgroupLocalInvocationIdVariable = state.module.DefineGlobalVariable(TypePointer(state, spv::StorageClassInput, TypeU32(state)), spv::StorageClassInput);
+    state.module.AddAnnotation(spv::OpDecorate, state.subgroupLocalInvocationIdVariable, spv::DecorationBuiltIn, spv::BuiltInSubgroupLocalInvocationId);
+    const auto invocation = state.module.DefineGlobalVariable(TypePointer(state, spv::StorageClassInput, TypeU32(state)), spv::StorageClassInput);
+    state.module.AddAnnotation(spv::OpDecorate, invocation, spv::DecorationBuiltIn, spv::BuiltInLocalInvocationIndex);
+    DefineGetBdaPointer(state);
+    const auto main = state.module.AllocateId();
+    state.module.AddFunction(spv::OpFunction, TypeVoid(state), main, spv::FunctionControlMaskNone, TypeFunction(state));
+    EmitLabel(state, state.module.AllocateId());
+    SpirvValueEmitContext ctx(state);
+    const auto lane = state.module.AllocateId();
+    state.module.AddFunction(spv::OpLoad, TypeU32(state), lane, invocation);
+    for (std::uint32_t i = 0; i < stores.size(); ++i) {
+        if (test.parallelWords) {
+            ctx.Define(*indices[i], lane);
+        }
+        const auto value = Binary(state, spv::OpIAdd, TypeU32(state), lane, ConstantU32(state, test.operations[i].value));
+        ctx.Define(*values[i], value);
+        if (test.operations[i].directBdaStore) {
+            AgcDriver::Graphics::Require(test.operations[i].bits == 32u && !test.parallelWords, "direct BDA store fixture requires a scalar dword store");
+            EmitBdaStore(ctx, *stores[i], BdaConstant(state, test.guestAddress + test.operations[i].offset), value, test.operations[i].bits);
+            continue;
+        }
+        switch (test.operations[i].bits) {
+            case 8u: EmitStoreBufferU8(ctx, *stores[i]); break;
+            case 16u: EmitStoreBufferU16(ctx, *stores[i]); break;
+            case 32u: EmitStoreBufferU32(ctx, *stores[i]); break;
+        }
+    }
+    state.module.AddFunction(spv::OpStore, BdaWord(state, output, test.parallelWords ? lane : ConstantU32(state, 0u)), ConstantU32(state, 0xa55a5aa5u));
+    state.module.AddFunction(spv::OpReturn);
+    state.module.AddFunction(spv::OpFunctionEnd);
+    state.module.AddExecutionMode(main, spv::ExecutionModeLocalSize, test.parallelWords ? 8u : 1u, 1u, 1u);
+    std::vector<std::uint32_t> interfaceVariables{state.subgroupLocalInvocationIdVariable};
+    interfaceVariables.push_back(invocation);
+    state.module.EmitEntryPoint(spv::ExecutionModelGLCompute, main, "main", interfaceVariables);
+    const auto spirv = state.module.Finalize();
+#if ANYPS5_ENABLE_SPIRV_TOOLS
+    return ValidateAndOptimizeSpirv(spirv, 0x00402000u, 0x00010500u);
+#else
+    return spirv;
+#endif
+}

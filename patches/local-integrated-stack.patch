+void RunGpuBufferFormatStoreTests(const Context& context) {
+    namespace Abi = ShaderRecompiler::BdaAbi;
+    using Format = ShaderRecompiler::IrBufferFormat;
+    constexpr std::uint64_t guest = 0x7fff678a0000ULL;
+    constexpr std::uint32_t sentinel = 0xdeadbeefu;
+    Buffer data(context, 64u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT);
+    Buffer table(context, sizeof(Abi::Header) + sizeof(Abi::Range), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    Buffer fault(context, Abi::FaultBufferBytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    Buffer io(context, 112u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    struct Fixture {
+        const char* name;
+        Format format;
+        std::uint32_t components;
+        std::array<std::uint32_t, 4> input;
+        std::array<std::uint32_t, 4> expected;
+        std::uint32_t bytes;
+    };
+    const std::array tests{
+        Fixture{"xyzw u32", Format::Format32_32_32_32UInt, 4u, {0x12345678u, 0x23456789u, 0x3456789au, 0x456789abu}, {0x12345678u, 0x23456789u, 0x3456789au, 0x456789abu}, 16u},
+        Fixture{"xyz f32 zero W", Format::Format32_32_32_32Float, 3u, {0x3f800000u, 0xbf800000u, 0x7f800000u, 0x1234u}, {0x3f800000u, 0xbf800000u, 0x7f800000u, 0u}, 16u},
+        Fixture{"xy f16", Format::Format16_16Float, 2u, {0x3f800000u, 0xbf000000u}, {0xb8003c00u}, 4u},
+        Fixture{"xyzw unorm8", Format::Format8_8_8_8UNorm, 4u, {0x3f800000u, 0x3f000000u, 0x3e800000u, 0u}, {0x004080ffu}, 4u},
+        Fixture{"xyzw sint8", Format::Format8_8_8_8SInt, 4u, {0x7fffffffu, 0x80000000u, 0xffffffffu, 0x5au}, {0x5aff807fu}, 4u},
+        Fixture{"xyzw unorm1010102", Format::Format10_10_10_2UNorm, 4u, {0x3f800000u, 0x3f000000u, 0x3e800000u, 0x3f800000u}, {0xd00803ffu}, 4u},
+        Fixture{"xy packed zero ZW", Format::Format10_10_10_2UInt, 2u, {1u, 2u}, {0x801u}, 4u},
+        Fixture{"xyzw float111110 ignores W", Format::Format11_11_10Float, 4u, {0x3f800000u, 0x3f800000u, 0x3f800000u, 0xffffffffu}, {0x781e03c0u}, 4u},
+        Fixture{"x zero trailing descriptor channels", Format::Format32_32_32_32UInt, 1u, {0x12345678u}, {0x12345678u, 0u, 0u, 0u}, 16u},
+    };
+    const auto run = [&](const Fixture& test, std::uint32_t records, std::uint32_t stride, std::uint32_t mode, std::uint32_t active, bool written, std::uint32_t permissions = Abi::Read | Abi::Write, bool addTid = false, std::uint32_t swizzle = 0u) {
+        std::array<std::uint32_t, 16> initial;
+        initial.fill(sentinel);
+        std::memcpy(data.Bytes().data(), initial.data(), sizeof(initial));
+        const Abi::Header header{Abi::Version, 1u, sizeof(Abi::Range), 0u};
+        const Abi::Range range{guest, guest + data.Bytes().size(), data.DeviceAddress(), permissions, 0u};
+        std::memcpy(table.Bytes().data(), &header, sizeof(header));
+        std::memcpy(table.Bytes().data() + sizeof(header), &range, sizeof(range));
+        std::memset(fault.Bytes().data(), 0, fault.Bytes().size());
+        std::array<std::uint32_t, 28> words{};
+        words[16] = static_cast<std::uint32_t>(guest);
+        words[17] = static_cast<std::uint32_t>(guest >> 32u) | (stride << 16u) | swizzle;
+        words[18] = records;
+        words[19] = (mode << 28u) | (static_cast<std::uint32_t>(test.format) << 12u) | ShaderRecompiler::DstSel(7, 6, 5, 4) | (addTid ? 1u << 23u : 0u);
+        words[23] = active;
+        std::copy(test.input.begin(), test.input.end(), words.begin() + 24u);
+        std::memcpy(io.Bytes().data(), words.data(), sizeof(words));
+        GpuBufferFormatShader shader;
+        shader.components = test.components;
+        shader.store = true;
+        Pipeline pipeline(context, MakeGpuBufferFormatTestShader(shader), {&table, &fault, &io});
+        pipeline.Run(1u);
+        auto expected = initial;
+        if (written) {
+            std::memcpy(expected.data(), test.expected.data(), test.bytes);
+            if (addTid) std::memcpy(reinterpret_cast<std::byte*>(expected.data()) + stride, test.expected.data(), test.bytes);
+        }
+        Require(std::memcmp(data.Bytes().data(), expected.data(), sizeof(expected)) == 0, std::string("GPU formatted store ") + test.name + " wrote wrong channels or crossed its bounds");
+        Abi::Fault report{};
+        std::memcpy(&report, fault.Bytes().data(), sizeof(report));
+        if (permissions == Abi::Read && active != 0u) {
+            Require(report.state == Abi::FaultState::Ready && report.reason == Abi::FaultReason::Permission && report.instruction == 0x89abu, "GPU formatted store ignored write permission");
+        } else Require(report.state == Abi::FaultState::Empty, "GPU formatted store published an unexpected fault");
+    };
+    for (const auto& test : tests) run(test, test.bytes, 0u, 3u, 1u, true);
+    run(tests[0], 15u, 0u, 3u, 1u, false);
+    run(tests[0], 0u, 0u, 3u, 1u, false);
+    run(tests[0], 16u, 0u, 3u, 0u, false);
+    run(tests[0], 1u, 16u, 0u, 1u, true);
+    run(tests[0], 1u, 15u, 0u, 1u, false);
+    run(tests[0], 16u, 0u, 3u, 1u, false, Abi::Read);
+    run(tests[0], 32u, 16u, 3u, 3u, true, Abi::Read | Abi::Write, true);
+    run(tests[0], 2u, 16u, 0u, 3u, true, Abi::Read | Abi::Write, true);
+}

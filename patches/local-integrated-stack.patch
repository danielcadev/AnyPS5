+    Require(std::getenv("APS5_IMPORT_SPANS") != nullptr && budget != nullptr && std::string(budget) == "255", "window-consolidation refusal fixture requires APS5_HOST_IMPORT_MIB=255");
+    constexpr std::size_t window = 64ull << 20u;
+    constexpr std::size_t rangeBytes = 3 * window;
+    auto* block = static_cast<std::byte*>(::operator new(rangeBytes, std::align_val_t{window}));
+    auto* unrelated = static_cast<std::byte*>(::operator new(window, std::align_val_t{window}));
+    const auto base = reinterpret_cast<std::uintptr_t>(block);
+    const auto unrelatedBase = reinterpret_cast<std::uintptr_t>(unrelated);
+    auto importing = context;
+    importing.hostImportAlignment = 65536;
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Add(block, rangeBytes, true, true);
+        mutation.Add(unrelated, window, true, true);
+    }
+    const auto* original = HostImportFor(importing, base + window - 16, 32);
+    Require(original != nullptr && original->base == base && original->bytes == 2 * window, "the initial import window was not created");
+    const auto originalSerial = HostImportSerial(importing, base, 32, false);
+    Require(HostImportFor(importing, unrelatedBase, window) != nullptr, "the unrelated import needed to fill the budget was refused");
+    Require(HostImportFor(importing, base + 2 * window - 16, 32) == nullptr, "an over-budget window consolidation unexpectedly succeeded");
+    Require(HostImportFor(importing, base, 32) == original && HostImportSerial(importing, base, 32, false) == originalSerial,
+            "a refused window consolidation retired or replaced its original import");
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Remove(block);
+        mutation.Remove(unrelated);
+    }
+    Require(HostImportFor(importing, base, 32) == nullptr && HostImportFor(importing, unrelatedBase, 32) == nullptr,
+            "the budget-refusal imports outlived their registrations");
+    ::operator delete(block, std::align_val_t{window});
+    ::operator delete(unrelated, std::align_val_t{window});
+}

+void ShaderResources::resolveImageTable(TableProgram& table) {
+    if (table.images == nullptr && table.storageImages == nullptr) return;
+    const auto& first = table.images != nullptr ? *table.images : *table.storageImages;
+    const auto elements = first.guestDescriptor.size() / 8u;
+    table.imagePoison.assign(elements, ShaderRecompiler::ImageTableAbi::PoisonFlag);
+    const auto resolve = [&](const ShaderRecompiler::DescriptorBinding& binding, Binding& item, bool storage) {
+        Require(binding.guestDescriptor.size() / 8u == elements, "sampled and storage tables disagree on entry count");
+        for (std::size_t element = 0; element < elements; ++element) {
+            const auto words = std::span<const std::uint32_t>(binding.guestDescriptor).subspan(element * 8u, 8u);
+            // This binding leaves the entries of the other image class unbound.
+            if (std::all_of(words.begin(), words.end(), [](std::uint32_t word) { return word == 0u; })) continue;
+            TableTexture texture;
+            std::shared_ptr<Texture> sampled;
+            try {
+                texture = PrevalidateTableTexture(context, words, binding.imageShapes.at(element), binding.imageDepthCompare.at(element));
+                if (storage) {
+                    const auto& resource = texture.resource;
+                    if (IsBlockCompressed(resource.format) || !StorageFormatAvailable(context, resource.format)) throw DescriptorRejected("guest format has no native storage image view");
+                    if (resource.dimension != TextureDimension::k2D || resource.baseLevel != 0u || resource.lastLevel != 0u || resource.allocatedMipCount != 1u || resource.minLod != 0u || resource.dccAddress != 0u) throw DescriptorRejected("storage image tables require 2D mip-zero textures without DCC or LOD clamps");
+                    if (GuestMemory::CommittedRanges(resource.baseAddress, static_cast<std::size_t>(texture.guestBytes), true).empty()) throw DescriptorRejected("storage table image has no writable committed guest pages");
+                    VkImageFormatProperties supported{};
+                    constexpr auto usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+                    constexpr auto flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT;
+                    const auto result = context.imageFormatProperties(context.physical, StorageFormatForGuest(context, resource.format), VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL, usage, flags, &supported);
+                    if (result != VK_SUCCESS || resource.width > supported.maxExtent.width || resource.height > supported.maxExtent.height || supported.maxMipLevels < 1u || supported.maxArrayLayers < 1u || (supported.sampleCounts & VK_SAMPLE_COUNT_1_BIT) == 0u) throw DescriptorRejected("Vulkan does not support this storage table format, usage or extent");
+                } else {
+                    const auto& resource = texture.resource;
+                    const VkComponentMapping components{ComponentSwizzleFor(resource.dstSelX), ComponentSwizzleFor(resource.dstSelY), ComponentSwizzleFor(resource.dstSelZ), ComponentSwizzleFor(resource.dstSelW)};
+                    sampled = cachedTexture(context, words, resource, components, texture.guestBytes, binding.imageDepthCompare.at(element));
+                }
+            } catch (const DescriptorRejected& error) {
+                table.imagePoison[element] = static_cast<std::uint32_t>(table.poison.size());
+                ShaderRecompiler::ImageTableEntryPoison poison{};
+                std::copy(words.begin(), words.end(), poison.words.begin());
+                poison.dwordCount = 8u;
+                poison.view = std::numeric_limits<std::uint32_t>::max();
+                poison.reason = static_cast<std::uint32_t>(ShaderRecompiler::ImageTableAbi::PoisonReason::DriverRejected);
+                table.poison.push_back(poison);
+                table.messages.push_back(error.what());
+                continue;
+            }
+            const auto& resource = texture.resource;
+            if (storage) {
+                storageTextures.push_back(cachedStorageTexture(context, words, resource, 0u, texture.guestBytes));
+                storageMips.push_back(0u);
+                storageKeys.push_back(resource.dccAddress);
+                storageFirstLayer.push_back(false);
+                storageWritten.push_back(true);
+                storageAtomic.push_back(false);
+                storageAtomic64.push_back(false);
+                describedRanges.push_back({"storage", resource.baseAddress, texture.guestBytes, resource.width, resource.height, resource.format, static_cast<int>(resource.tileMode), resource.dccAddress});
+                item.imageAllocations.push_back(storageTextures.size() - 1u);
+            } else {
+                textures.push_back(std::move(sampled));
+                textureFirstLayer.push_back(texture.firstLayer);
+                describedRanges.push_back({"texture", resource.baseAddress, texture.guestBytes, resource.width, resource.height, resource.format, static_cast<int>(resource.tileMode), resource.dccAddress});
+                item.imageAllocations.push_back(textures.size() - 1u);
+            }
+            item.arrayElements.push_back(static_cast<std::uint32_t>(element));
+        }
+    };
+    // Establish writable owners before sampled table aliases are resolved.
+    if (table.storageImages != nullptr) resolve(*table.storageImages, bindings[table.storageImageBinding], true);
+    if (table.images != nullptr) resolve(*table.images, bindings[table.imageBinding], false);
+    reportTextureCounters();
+}

+    Require(DepthSurfaceStorageTexture(context,plane(groupC,false),0)==sharedDepth,
+        "different S8 aliases did not establish the same exact R32 owner");
+    ad.pattern(groupDepth,67); as.pattern(groupS1,71); as.pattern(groupS2,79);
+    upload(context,recorder,sharedDepth,ad.linear(groupDepth));
+    upload(context,recorder,firstStencil,as.linear(groupS1));
+    upload(context,recorder,secondStencil,as.linear(groupS2));
+    Require(sharedDepth->AnyLayerPending() && firstStencil->AnyLayerPending() && secondStencil->AnyLayerPending(),
+        "shared resize setup did not leave all three GPU producers pending");
+    auto groupFailedContext=context; groupFailedContext.limits.maxFramebufferWidth=groupB.extent.width-1u;
+    failed=false;
+    try { static_cast<void>(DepthSurfaceView(groupFailedContext,groupB)); }
+    catch (const std::runtime_error&) { failed=true; }
+    Require(failed && DepthSurfaceStorageTexture(context,plane(groupA,false),0)==sharedDepth &&
+        DepthSurfaceStorageTexture(context,plane(groupC,true),0)==secondStencil,
+        "failed shared resize changed an existing plane owner");
+    const auto groupBView=DepthSurfaceView(context,groupB); const auto groupBImage=latestDepthImage;
+    Require(!sharedDepth->AnyLayerPending() && !firstStencil->AnyLayerPending() && !secondStencil->AnyLayerPending(),
+        "shared resize retained pending writers in a retired alias");
+    Require(readPlane(context,recorder,groupBImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupB.extent,4)==bd.linear(groupDepth) &&
+        readPlane(context,recorder,groupBImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupB.extent,1)==bs.linear(groupS1),
+        "shared resize imported the wrong R32 or the other alias's S8 plane");
+    std::vector<std::byte> publishedS2(groupS2.size());
+    AgcDriver::GuestMemory::Read(groupC.stencilAddress,publishedS2,1);
+    Require(publishedS2==groupS2,"shared resize discarded the foreign alias's pending S8 producer");
+    auto groupExtra=groupB; groupExtra.stencilAddress=base+(5u<<19u);
+    auto canonicalB=DepthSurfaceStorageTexture(context,plane(groupB,false),0);
+    Require(canonicalB!=precachedDepth && !canonicalB->AnyLayerPending() && !precachedDepth->AnyLayerPending(),
+        "incoming readonly conflict fixture did not create distinct nonpending R32 owners");
+    static_cast<void>(DepthSurfaceView(context,groupExtra));
+    Require(DepthSurfaceStorageTexture(context,plane(groupExtra,false),0)==canonicalB &&
+        StorageImageCached(context,precachedDepth.get()) && precachedDepth->View()==precachedView,
+        "readonly incoming alias replaced the canonical R32 owner or destroyed its older cached views");
+    Require(!precachedResources.Revalidate(precachedShader),"old readonly R32 shader views bypassed canonical-owner revalidation");
+    drawing.draw(context,groupB);
+    for (std::uint32_t y=0;y<16;++y) for (std::uint32_t x=0;x<16;++x) {
+        std::memcpy(groupDepth.data()+bd.offset(x,y),&drawn,4); groupS1[bs.offset(x,y)]=std::byte{0x7b};
+    }
+    sharedDepth->WriteBack(); firstStencil->WriteBack(); secondStencil->WriteBack();
+    Require(DepthSurfaceView(context,groupB)==groupBView &&
+        readPlane(context,recorder,groupBImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupB.extent,4)==bd.linear(groupDepth) &&
+        readPlane(context,recorder,groupBImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupB.extent,1)==bs.linear(groupS1),
+        "an old shared owner republished stale bytes over B");
+    // C is retired: a new ordinary GPU S8 writer must survive its eventual exact
+    // same-geometry rebind, which cannot just revive C's cached native image.
+    auto retiredStencil=CachedStorageSurface(context,plane(groupC,true));
+    as.pattern(groupS2,97); upload(context,recorder,retiredStencil,as.linear(groupS2));
+    Require(retiredStencil->AnyLayerPending(),"retired C stencil writer was not pending");
+    Require(DepthSurfaceView(context,groupA)==groupAView &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupA.extent,4)==ad.linear(groupDepth) &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupA.extent,1)==as.linear(groupS1),
+        "returning A lost B's physical-byte depth or S8 writes");
+    Require(retiredStencil->AnyLayerPending(),"returning A flushed unrelated retired C stencil writes");
+    Require(DepthSurfaceView(context,groupC)==groupCView &&
+        readPlane(context,recorder,groupCImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupC.extent,4)==ad.linear(groupDepth) &&
+        readPlane(context,recorder,groupCImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupC.extent,1)==as.linear(groupS2),
+        "same-geometry retired C rebind resurrected stale depth or stencil pixels");
+    Require(DepthSurfaceStorageTexture(context,plane(groupA,false),0)==DepthSurfaceStorageTexture(context,plane(groupC,false),0),
+        "returning retired aliases created conflicting R32 owners");
+    drawing.draw(context,groupC);
+    for (std::uint32_t y=0;y<16;++y) for (std::uint32_t x=0;x<16;++x) {
+        std::memcpy(groupDepth.data()+ad.offset(x,y),&drawn,4); groupS2[as.offset(x,y)]=std::byte{0x7b};
+    }
+    retiredStencil->WriteBack();
+    Require(DepthSurfaceView(context,groupA)==groupAView &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupA.extent,4)==ad.linear(groupDepth) &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupA.extent,1)==as.linear(groupS1) &&
+        readPlane(context,recorder,groupCImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupC.extent,1)==as.linear(groupS2),
+        "post-resize shared physical draws lost depth or mixed the distinct S8 planes");
+    auto liveDepth=DepthSurfaceStorageTexture(context,plane(groupA,false),0);
+    auto liveS1=DepthSurfaceStorageTexture(context,plane(groupA,true),0);
+    auto liveS2=DepthSurfaceStorageTexture(context,plane(groupC,true),0);
+    ad.pattern(groupDepth,101); as.pattern(groupS1,103); as.pattern(groupS2,107);
+    upload(context,recorder,liveDepth,ad.linear(groupDepth));
+    upload(context,recorder,liveS1,as.linear(groupS1));
+    upload(context,recorder,liveS2,as.linear(groupS2));
+    Require(liveDepth->AnyLayerPending() && liveS1->AnyLayerPending() && liveS2->AnyLayerPending(),
+        "live color transition did not begin with all GPU plane producers pending");
+    auto reusedColor=plane(groupA,false);
+    reusedColor.format=1u; reusedColor.tileMode=TextureTileMode::kStandard256B;
+    reusedColor.width/=2u; reusedColor.height/=2u;
+    const auto colorMip=ComputeElementMipLayout(reusedColor.tileMode,1,reusedColor.width,reusedColor.height,1).front();
+    // R8 SW_256B_S is a row-major 16x16 microtile. This physical-byte
+    // oracle is independent of the GPU detiler and of the depth Z equation.
+    const auto colorOffset=[&](std::uint32_t x,std::uint32_t y) {
+        return (static_cast<std::size_t>(y/16u)*colorMip.blocksPerRow+x/16u)*256u+(y%16u)*16u+x%16u;
+    };
+    std::vector<std::byte> colorSeed(static_cast<std::size_t>(reusedColor.width)*reusedColor.height);
+    for (std::uint32_t y=0;y<reusedColor.height;++y) for (std::uint32_t x=0;x<reusedColor.width;++x)
+        colorSeed[static_cast<std::size_t>(y)*reusedColor.width+x]=groupDepth[colorOffset(x,y)];
+    bool colorHandoff=false;
+    Require(DepthSurfaceStorageTexture(context,reusedColor,0,false,&colorHandoff,true)==nullptr && colorHandoff &&
+        !DepthSurfaceAt(groupA.address) && !DepthSurfaceAt(groupC.stencilAddress),
+        "live R8 color writer did not publish and retire its whole depth alias group");
+    auto colorOwner=CachedStorageSurface(context,reusedColor);
+    Require(readPlane(context,recorder,colorOwner->Image(),VK_IMAGE_ASPECT_COLOR_BIT,{reusedColor.width,reusedColor.height},1)==colorSeed,
+        "live R8 color storage was seeded from stale guest bytes instead of the current GPU depth plane");
+    std::vector<std::byte> colorPixels(colorSeed.size(),std::byte{0x3f});
+    upload(context,recorder,colorOwner,colorPixels);
+    for (std::uint32_t y=0;y<reusedColor.height;++y) for (std::uint32_t x=0;x<reusedColor.width;++x)
+        groupDepth[colorOffset(x,y)]=std::byte{0x3f};
+    Require(colorOwner->AnyLayerPending() && !liveDepth->AnyLayerPending() && !liveS1->AnyLayerPending() && !liveS2->AnyLayerPending(),
+        "color transition left an old plane writer pending");
+    liveDepth->WriteBack(); liveS1->WriteBack(); liveS2->WriteBack();
+    Require(CachedStorageSurface(context,reusedColor)==colorOwner &&
+        readPlane(context,recorder,colorOwner->Image(),VK_IMAGE_ASPECT_COLOR_BIT,{reusedColor.width,reusedColor.height},1)==colorPixels,
+        "old plane owners or a repeated color lookup restored historical depth over the GPU color writer");
+    Require(DepthSurfaceView(context,groupA)==groupAView &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupA.extent,4)==ad.linear(groupDepth) &&
+        readPlane(context,recorder,groupAImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupA.extent,1)==as.linear(groupS1),
+        "depth return lost pending R8 color pixels, depth outside the alias, or the first S8 plane");
+    Require(DepthSurfaceView(context,groupC)==groupCView &&
+        readPlane(context,recorder,groupCImage,VK_IMAGE_ASPECT_DEPTH_BIT,groupC.extent,4)==ad.linear(groupDepth) &&
+        readPlane(context,recorder,groupCImage,VK_IMAGE_ASPECT_STENCIL_BIT,groupC.extent,1)==as.linear(groupS2),
+        "second depth alias did not recover color-written depth and its independent S8 plane");
+    std::vector<std::byte> returnedDepth(groupDepth.size()),returnedS1(groupS1.size()),returnedS2(groupS2.size());
+    AgcDriver::GuestMemory::Read(groupA.address,returnedDepth,4);
+    AgcDriver::GuestMemory::Read(groupA.stencilAddress,returnedS1,1);
+    AgcDriver::GuestMemory::Read(groupC.stencilAddress,returnedS2,1);
+    Require(returnedDepth==groupDepth && returnedS1==groupS1 && returnedS2==groupS2,
+        "color/depth round trip changed physical bytes outside the R8 alias or either S8 producer");
+    std::puts("depth/stencil resize A/B/A: pending writers, physical-byte oracle, outside bytes, physical draws, released views, failed allocation and mixed-writer guards passed");
+}
+}
+
+int main() {
+    try { Device device; run(device); return 0; }
+    catch(const std::exception& error) { std::fprintf(stderr,"depth/stencil resize: %s\n",error.what()); return 1; }
+}
diff --git a/core/libs/prx/libSceAgcDriver/tests/execution/FiniteImageDescriptor.cpp b/core/libs/prx/libSceAgcDriver/tests/execution/FiniteImageDescriptor.cpp

+void verifyGpuFormattedStores() {
+    using namespace ShaderRecompiler;
+    const std::vector<std::uint32_t> code{0xf4080100u, 0xfa000000u, 0x7e200500u,
+        0x9310ff10u, 0x250u, 0xf4280502u, 0x200001c0u,
+        0x7e0202ffu, 0xffffff81u, 0xe0106000u, 0x80050100u, 0xbf810000u};
+    constexpr std::uint64_t Root = 0x10000u;
+    const std::array<std::uint32_t, 4> root{0x20000u, 0u, 0x4a0u, 0x01016facu};
+    const std::array<MemoryRegion, 1> memory{{{Root, std::as_bytes(std::span(root))}}};
+    const std::array<std::uint32_t, 4> capabilities{spv::CapabilityShader, spv::CapabilityInt64,
+        spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityStorageBuffer8BitAccess};
+    const std::array<std::string_view, 2> extensions{"SPV_KHR_physical_storage_buffer", "SPV_KHR_8bit_storage"};
+    for (const auto components : {1u, 2u, 3u, 4u}) {
+        auto storeCode = code;
+        storeCode[9] += (components - 1u) << 18u;
+        for (const auto wave : {32u, 64u}) {
+            TableRequest table(storeCode, reinterpret_cast<const void*>(Root));
+            table.request.context.waveSize = wave;
+            table.request.context.memory = memory;
+            table.request.target.supportedCapabilities = capabilities;
+            table.request.target.supportedExtensions = extensions;
+            const auto plan = GetResourcePlan(table.request);
+            require(plan->info.usesDma && plan->info.bdaWrites, "GPU format store: the write did not take the BDA path");
+            std::uint32_t dynamicStores = 0;
+            for (const auto& access : plan->memoryInfo) {
+                if (access.kind == ResourceKind::Buffer && access.gpuDescriptor && access.formatted && access.coherent && access.dataDwords == components) dynamicStores++;
+            }
+            require(dynamicStores == 1u, "GPU format store: component count was not recognized");
+            const auto compiled = Recompile(table.request);
+#if ANYPS5_ENABLE_SPIRV_TOOLS
+            static_cast<void>(ValidateAndOptimizeSpirv(compiled.spirv, table.request.target.vulkanVersion, table.request.target.spirvVersion));
+#endif
+            const std::string module(reinterpret_cast<const char*>(compiled.spirv.data()), compiled.spirv.size() * sizeof(std::uint32_t));
+            require(module.find("runtime_buffer_encode") != std::string::npos, "GPU format store: runtime conversion was omitted");
+            require(module.find("runtime_buffer_format_info") != std::string::npos, "GPU format store: runtime format decoding was omitted");
+        }
+    }
+    auto d16Code = code;
+    d16Code[9] = 0xe2106000u;
+    TableRequest d16(d16Code, reinterpret_cast<const void*>(Root));
+    expectFailure([&] { static_cast<void>(GetResourcePlan(d16.request)); }, "GetBufferResource dword 0 is not a valid runtime value", "GPU format store: unsupported D16 store was admitted");
+}

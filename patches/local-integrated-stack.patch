+        batch.SubmitAndWait();
+        const auto copied = readback.Bytes();
+        for (std::size_t i = 0; i < bytes; ++i) Require(copied[i] == static_cast<std::byte>((i * 17 + pass * 53 + (i / scatterPiece) * 71) & 255), "scatter GPU read lost virtual-order bytes");
+        for (std::size_t i = 0; i < bytes / sizeof(std::uint32_t); ++i)
+            Require(reinterpret_cast<volatile std::uint32_t*>(scatterBase)[i] == 0x5a3c7e91u + pass + ((i * sizeof(std::uint32_t)) / scatterPiece) * 71, "scatter GPU write is incoherent with CPU mapping");
+        std::cout << "Scattered DMA-BUF CPU/GPU copy pass=" << pass << " bytes=" << bytes << '\n';
+    }
+    {
+        auto mutation = GuestAllocations::Mutation();
+        for (std::size_t i = 0; i < 3; ++i) mutation.Remove(scatterBase + i * scatterPiece);
+    }
+    Require(HostImportFor(context, aligned, scatterPiece) == nullptr, "scatter import survived unmap");
+    GuestArena::GuestArenaSetSharedBacking_nid_postfix(nullptr);
+    GuestArena::GuestArenaSetSharedBackingRuns_nid_postfix(nullptr);
+    munmap(reservation, alignment + bytes);
+    close(scatterFile);
+    scatterBase = nullptr;
+    scatterFile = -1;
+}

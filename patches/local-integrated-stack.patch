+bool ShaderResources::WritesStorageSurface(std::uint64_t address, VkFormat format, std::uint32_t width, std::uint32_t height) const {
+    for (std::size_t index = 0; index < storageTextures.size(); ++index) {
+        const auto& source = storageTextures[index];
+        if (!source || !storageWritten[index]) continue;
+        const auto& descriptor = source->Descriptor();
+        if (descriptor.baseAddress == address && source->StorageFormat() == format && descriptor.width == width && descriptor.height == height && source->ImageLayers() == 1 && source->ImageDepth() == 1 && descriptor.mipCount == 1) return true;
+    }
+    return false;
+}
+
+bool ShaderResources::CaptureSceneConsumer(Recorder& recorder, bool arm) const {
+    static const bool enabled = std::getenv("APS5_SCENE_CONSUMER_CAPTURE") != nullptr;
+    static bool armed = false, captured = false;
+    if (!enabled || captured) return false;
+    if (arm) {
+        if (!armed) std::fprintf(stderr, "[scene-consumer] armed after observed tree writer batch=%llu\n", static_cast<unsigned long long>(recorder.Submissions() + 1));
+        armed = true;
+        return false;
+    }
+    if (!armed) return false;
+    constexpr std::uint64_t address = 0x5052bd0000ull;
+    for (const auto& binding : bindings) {
+        if (binding.layout.descriptorType != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE) continue;
+        for (std::size_t element = 0; element < binding.imageAllocations.size(); ++element) {
+            const auto index = binding.imageAllocations[element];
+            const auto& texture = textures.at(index);
+            const auto source = texture->SharedStorageSource();
+            const auto& guest = validatedTextures.at(index);
+            if ((!source || source->Descriptor().baseAddress != address) && (!guest.valid || guest.resource.baseAddress != address)) continue;
+            captured = true;
+            const auto slot = binding.flags != 0 ? binding.arrayElements[element] : static_cast<std::uint32_t>(element);
+            std::fprintf(stderr, "[scene-consumer] binding=%u element=%u stages=%x native=%d viewFormat=%u layout=%u batch=%llu\n", binding.layout.binding, slot, binding.layout.stageFlags, source != nullptr, static_cast<unsigned>(texture->ViewFormat()), static_cast<unsigned>(texture->Layout()), static_cast<unsigned long long>(recorder.Submissions() + 1));
+            Require(source && guest.valid && guest.resource.baseLevel == 0 && guest.resource.baseArray == 0 && texture->Layout() == VK_IMAGE_LAYOUT_GENERAL && source->Descriptor().width == 3840 && source->Descriptor().height == 2160 && source->StorageFormat() == VK_FORMAT_R8G8B8A8_UNORM, "scene consumer differs from observed native mip0 source");
+            for (const auto& candidate : textures) {
+                const auto native = candidate->SharedStorageSource();
+                if (native && native->Descriptor().baseAddress == address) Require(native == source, "scene consumer has ambiguous sampled source");
+            }
+            for (const auto& candidate : storageTextures) if (candidate && candidate->Descriptor().baseAddress == address) Require(candidate == source, "scene consumer has ambiguous storage source");
+            std::fprintf(stderr, "[scene-consumer] source=%llx generation=%llu version=%llu\n", static_cast<unsigned long long>(address), static_cast<unsigned long long>(source->Generation()), static_cast<unsigned long long>(source->Version()));
+            CaptureBlackComputeImage(recorder, address, "late-final-scene-consumer.raw");
+            return true;
+        }
+    }
+    return false;
+}

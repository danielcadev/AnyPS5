+void importCrossingTests(const Context& context, const BdaTestAccess& access) {
+    constexpr std::size_t half = 65536;
+    void* block = ::operator new(2 * half, std::align_val_t{half});
+    auto* guest = static_cast<std::uint8_t*>(block);
+    std::memset(guest, 0x11, half);
+    std::memset(guest + half, 0x22, half);
+    const auto first = reinterpret_cast<std::uintptr_t>(block);
+    const auto second = first + half;
+    auto importing = context;
+    importing.hostImportAlignment = half;
+    const auto registry = [&](bool add) {
+        auto* mutation = GuestAllocations::GuestAllocationsBegin_nid_postfix();
+        for (auto* range : {guest, guest + half}) {
+            if (add) GuestAllocations::GuestAllocationsAdd_nid_postfix(mutation, range, half, true, range == guest, true);
+            else GuestAllocations::GuestAllocationsRemove_nid_postfix(mutation, range);
+        }
+        GuestAllocations::GuestAllocationsEnd_nid_postfix(mutation);
+    };
+    registry(true);
+    for (int build = 0; build < 2; ++build) {
+        const auto before = AddressSpaceCounters();
+        GuestBufferMemory leased(importing);
+        leased.AcquireRegistered();
+        Require(HostImportCovers(importing, first, half) && HostImportCovers(importing, second, half), "the registered ranges were not imported");
+        const auto secondImport = *HostImportFor(importing, second, half);
+        leased.AddReadable(second - 16, 32);
+        leased.AddReadable(second - 8, 32);
+        leased.Upload(true);
+        std::uint32_t adjustment = 0;
+        const auto crossing = leased.Descriptor(second - 16, 32, adjustment);
+        const auto crossingBytes = access.bytes(crossing.buffer);
+        Require(crossing.offset + crossing.range <= crossingBytes.size(), "a view crossing into the next registered range is bound past its host import");
+        Require(crossingBytes[crossing.offset + adjustment + 15] == std::byte{0x11} && crossingBytes[crossing.offset + adjustment + 16] == std::byte{0x22}, "a view crossing into the next registered range misses its bytes");
+        const auto overlapping = leased.Descriptor(second - 8, 32, adjustment);
+        const auto overlapBytes = access.bytes(overlapping.buffer);
+        Require(overlapping.offset + overlapping.range <= overlapBytes.size() && overlapBytes[overlapping.offset + adjustment] == std::byte{0x11} && overlapBytes[overlapping.offset + adjustment + 8] == std::byte{0x22}, "an overlapping read-only view across imports misses its bytes");
+        const auto ranges = leased.AddressRanges();
+        Require(std::adjacent_find(ranges.begin(), ranges.end(), [](const auto& left, const auto& right) { return right.begin < left.end; }) == ranges.end(), "read-only import overlaps produced a non-disjoint BDA table");
+        const auto firstRange = std::find_if(ranges.begin(), ranges.end(), [&](const auto& range) { return range.begin <= first && first + half <= range.end; });
+        const auto secondRange = std::find_if(ranges.begin(), ranges.end(), [&](const auto& range) { return range.begin <= second && second + half <= range.end; });
+        Require(firstRange != ranges.end() && secondRange != ranges.end(), "a read-only V# removed an imported range from the BDA table");
+        Require((firstRange->permissions & ShaderRecompiler::BdaAbi::Write) != 0u && (secondRange->permissions & ShaderRecompiler::BdaAbi::Write) == 0u, "a read-only V# changed the BDA permissions of an imported range");
+        for (const auto& range : ranges) {
+            if (range.end <= first || range.begin >= second + half) continue;
+            const auto mapped = access.addressBytes(range.deviceAddress);
+            Require(mapped.size() >= range.end - range.begin, "a BDA range runs past the end of its host import");
+            if (range.begin <= second && second < range.end && range.deviceAddress != secondImport.address) Require(mapped[second - range.begin] == std::byte{0x22}, "the BDA range over the second registered range misses its bytes");
+        }
+        leased.WriteBack();
+        const auto after = AddressSpaceCounters();
+        if (after.enabled && build == 1) Require(after.hits == before.hits + 1 && after.dissolvedOverlap == before.dissolvedOverlap, "read-only views across imports dissolved the cached address space");
+    }
+
+    for (const bool writtenFirst : {false, true}) {
+        const auto before = AddressSpaceCounters();
+        GuestBufferMemory leased(importing);
+        leased.AcquireRegistered();
+        if (writtenFirst) leased.AddWritable(second - 8, 16);
+        leased.AddReadable(second - 16, 32);
+        if (!writtenFirst) leased.AddWritable(second - 8, 16);
+        leased.Upload(true);
+        std::uint32_t readAdjustment = 0;
+        std::uint32_t writeAdjustment = 0;
+        const auto read = leased.Descriptor(second - 16, 32, readAdjustment);
+        const auto written = leased.Descriptor(second - 8, 16, writeAdjustment);
+        Require(read.buffer == written.buffer && written.offset + writeAdjustment == read.offset + readAdjustment + 8, "a writable view overlapping a read-only import-crossing view uses a different GPU owner");
+        const auto ranges = leased.AddressRanges();
+        Require(std::adjacent_find(ranges.begin(), ranges.end(), [](const auto& left, const auto& right) { return right.begin < left.end; }) == ranges.end(), "writable/read-only import overlap produced a non-disjoint BDA table");

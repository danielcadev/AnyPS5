+std::uint32_t DefineRuntimeFormatInfo(SpirvEmitterState& state, const std::vector<SpirvBufferFormatInfo>& formats) {
+    const auto vector = TypeU32Vector(state, 4u);
+    const auto function = state.module.AllocateId();
+    state.module.AddName(function, "runtime_buffer_format_info");
+    state.module.AddFunction(spv::OpFunction, vector, function, spv::FunctionControlDontInlineMask, state.module.Type(spv::OpTypeFunction, vector, TypeU32(state)));
+    const auto format = RuntimeFormatParameter(state, TypeU32(state));
+    EmitLabel(state, state.module.AllocateId());
+    std::vector<std::uint32_t> keys;
+    for (const auto& info : formats) keys.push_back(static_cast<std::uint32_t>(info.format));
+    const auto result = RuntimeFormatSwitch(state, format, vector, ConstantU32CompositeZero(state, 4u), keys, [&](std::size_t i) {
+        const auto& info = formats[i];
+        std::uint32_t widths = 0u;
+        std::uint32_t offsets = 0u;
+        for (std::uint32_t component = 0; component < info.componentCount; ++component) {
+            widths |= info.componentBits[component] << (component * 8u);
+            offsets |= info.componentBitOffset[component] << (component * 8u);

+// A diagnostic supplement for the captured 1dfb program, whose analysis rejects table stores
+// before ShaderMemory can materialize the descriptors. It never enters the compiler or caches.
+void dumpImageWriteTables(std::uint64_t address, const ShaderRecompiler::RecompileRequest& request, const char* originalName) {
+    if (address != 0x80001dfb00ull || std::getenv("APS5_DUMP_SHADERS") == nullptr || request.context.userData.size() < 2) return;
+    const auto code = request.shader.code;
+    if (code.size() <= 0x78dcu / 4u || code[0x7a0u / 4u] != 0xf40c0b00u || code[0x7a4u / 4u] != 0x38000830u ||
+        code[0x7a8u / 4u] != 0xf40c0100u || code[0x7acu / 4u] != 0x38000010u ||
+        code[0x7868u / 4u] != 0xf40c0100u || code[0x786cu / 4u] != 0x38000000u ||
+        code[0x7874u / 4u] != 0xf40c0b00u || code[0x7878u / 4u] != 0x04000c30u ||
+        code[0x78b8u / 4u] != 0xf0202108u || code[0x78bcu / 4u] != 0x80012752u ||
+        code[0x78d8u / 4u] != 0xf020270au || code[0x78dcu / 4u] != 0x000b1f79u) return;
+    // SRT IR proves key=(x<<27)>>27, stride=32. Reads use column 0x10;
+    // stores use 0x830 and 0xc30, including the latter SMEM's literal offset.
+    // Each column contains 32 T# descriptors. No heap pointer chasing.
+    constexpr std::size_t rootBytes = 0x1030;
+    const auto root = static_cast<std::uint64_t>(request.context.userData[0]) | (static_cast<std::uint64_t>(request.context.userData[1]) << 32u);
+    try {
+        if (root > std::numeric_limits<std::uint64_t>::max() - rootBytes || !GuestMemory::Accessible(reinterpret_cast<const void*>(root), rootBytes)) {
+            throw std::runtime_error("root prefix is not fully readable");
+        }
+        const auto end = root + rootBytes;
+        for (const auto& region : request.context.memory) {
+            if (region.guestAddress < end && root < region.guestAddress + region.bytes.size()) {
+                throw std::runtime_error("root prefix overlaps an existing capture; supplement was not added");
+            }
+        }
+        // Source analysis failed before the normal capture. Flush only this exact range, then
+        // copy through the mapping-aware helper; an uncommitted page never becomes fabricated data.
+        std::array<std::byte, rootBytes> bytes;
+        GuestMemory::FlushGpuWrites(root, bytes.size());
+        if (GuestMemory::CopyMapped(root, bytes) != GuestMemory::Compare::Equal) throw std::runtime_error("root prefix became unreadable");
+        std::vector<ShaderRecompiler::MemoryRegion> regions(request.context.memory.begin(), request.context.memory.end());
+        regions.push_back({root, bytes});

+
+namespace {
+
+using AgcDriver::Graphics::Require;
+using ShaderRecompiler::ShaderStage;
+
+// These are the two exact extents from the native alias trace. Keeping them small makes the
+// allocation and full-screen draws cheap while preserving the native create-A/create-B/rebind-A
+// order and the incompatible same-base extent lookup.
+constexpr std::uint32_t WidthA = 192;
+constexpr std::uint32_t HeightA = 108;
+constexpr std::uint32_t WidthB = 166;
+constexpr std::uint32_t HeightB = 94;
+constexpr std::uint32_t Threads = 32;
+constexpr std::uint32_t Format32Float = 22;
+constexpr std::uint32_t Type2D = 9;
+constexpr std::uint32_t TileZ64KBX = 0x18;
+constexpr std::uint32_t ClampEdge = 2;
+constexpr std::uint32_t FilterPoint = 0;
+constexpr std::uint32_t LessEqual = 3;
+
+float* Inputs = nullptr;
+float* Outputs = nullptr;
+
+alignas(256) constexpr std::array<std::uint32_t, 6> VertexCode{
+    0xe0382000, 0x80000005, 0xbf8c3f70, 0xf80008cf, 0x03020100, 0xbf810000,
+};
+alignas(256) constexpr std::array<std::uint32_t, 13> SampleCode{
+    // image_sample_lz (opcode 0x27), with v2/v3 as x/y coordinates. The prior v1 is the
+    // comparison reference used only by image_sample_c_lz and must not enter a raw-depth sample.
+    0x1614008c, 0xe03c1000, 0x8000010a, 0xbf8c3f70, 0xf09c0108, 0x00820402, 0xbf8c3f70,
+    0x34160082, 0xe0701000, 0x8001040b, 0xbf810000, 0xbf810000, 0xbf810000,
+};
+
+class GuestBlock {
+public:
+    explicit GuestBlock(std::size_t size) : bytes((size + 65535u) & ~std::size_t{65535u}) {
+        memory = static_cast<std::byte*>(std::aligned_alloc(65536, bytes));
+        Require(memory != nullptr, "depth last-bind: cannot allocate 64 KiB-aligned guest memory");
+        std::fill_n(memory, bytes, std::byte{0});
+        GuestAllocations::Mutation().Add(memory, bytes, true, true);
+    }
+
+    ~GuestBlock() {
+        if (memory != nullptr) {
+            GuestAllocations::Mutation().Remove(memory);
+            std::free(memory);
+        }
+    }
+
+    GuestBlock(const GuestBlock&) = delete;
+    GuestBlock& operator=(const GuestBlock&) = delete;
+    std::byte* data() const { return memory; }
+
+private:
+    std::byte* memory = nullptr;
+    std::size_t bytes;
+};
+
+std::array<std::uint32_t, 4> BufferDescriptor(const void* data, std::uint32_t bytes) {
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    return {static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu), bytes, 0x01016facu};
+}
+
+std::array<std::uint32_t, 4> VertexDescriptor(const void* data) {
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    return {static_cast<std::uint32_t>(address), static_cast<std::uint32_t>((address >> 32u) & 0xffffu) | (16u << 16u), 3u, 0x01016facu};
+}
+
+std::array<std::uint32_t, 8> DepthTextureDescriptor(const void* data, std::uint32_t width, std::uint32_t height) {
+    const auto address = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(data));
+    return {
+        static_cast<std::uint32_t>(address >> 8u),
+        static_cast<std::uint32_t>((address >> 40u) & 0xffu) | (Format32Float << 20u) | (((width - 1u) & 3u) << 30u),
+        ((width - 1u) >> 2u) | ((height - 1u) << 14u),
+        0xfacu | (TileZ64KBX << 20u) | (Type2D << 28u),
+        0u, 0u, 0u, 0u,
+    };
+}
+
+std::array<std::uint32_t, 4> SamplerDescriptor() {
+    return {ClampEdge | (ClampEdge << 3u) | (ClampEdge << 6u) | (LessEqual << 12u), 0u,
+            (FilterPoint << 20u) | (FilterPoint << 22u), 0u};
+}
+
+ShaderRecompiler::RecompileResult CompileSample(AgcDriver::VulkanDevice& device, const void* guest, std::uint32_t width, std::uint32_t height) {
+    std::vector<std::uint32_t> userData(20, 0u);
+    const auto input = BufferDescriptor(Inputs, static_cast<std::uint32_t>(sizeof(float) * Threads * 3u));
+    const auto output = BufferDescriptor(Outputs, static_cast<std::uint32_t>(sizeof(float) * Threads));
+    const auto texture = DepthTextureDescriptor(guest, width, height);
+    const auto sampler = SamplerDescriptor();
+    std::copy(input.begin(), input.end(), userData.begin());
+    std::copy(output.begin(), output.end(), userData.begin() + 4);
+    std::copy(texture.begin(), texture.end(), userData.begin() + 8);
+    std::copy(sampler.begin(), sampler.end(), userData.begin() + 16);
+    const std::array<ShaderRecompiler::MemoryRegion, 1> memory{{
+        {reinterpret_cast<std::uintptr_t>(SampleCode.data()), std::as_bytes(std::span(SampleCode))}
+    }};
+    const ShaderRecompiler::ShaderComputeStageInfo compute{{Threads, 1, 1}, 0u, {false, false, false}, false, 1};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Compute, reinterpret_cast<std::uintptr_t>(SampleCode.data()), SampleCode, 0, {}},
+        {32, 0, userData, compute, std::nullopt, std::nullopt, memory},
+        device.Target(),
+        {0, 0, 0, 128}
+    };
+    request.useCache = false;
+    auto result = ShaderRecompiler::Recompile(request);
+    const auto& spirv = result.spirv.Words();
+    Require(spirv.size() >= 6u && spirv[0] == spv::MagicNumber,
+            "depth last-bind: ordinary sample compiled to malformed SPIR-V");
+    bool rawSample = false;
+    for (std::size_t index = 5; index < spirv.size();) {
+        const auto wordCount = spirv[index] >> 16u;
+        const auto opcode = static_cast<spv::Op>(spirv[index] & 0xffffu);
+        Require(wordCount != 0 && wordCount <= spirv.size() - index,
+                "depth last-bind: malformed SPIR-V instruction length");
+        Require(opcode != spv::OpImageSampleDrefImplicitLod && opcode != spv::OpImageSampleDrefExplicitLod &&
+                    opcode != spv::OpImageDrefGather,
+                "depth last-bind: raw-depth shader unexpectedly compiled a depth comparison");
+        rawSample |= opcode == spv::OpImageSampleImplicitLod || opcode == spv::OpImageSampleExplicitLod;
+        index += wordCount;
+    }
+    Require(rawSample, "depth last-bind: compiled shader contains no ordinary raw-depth sample");
+    return result;
+}
+
+void DrawDepth(AgcDriver::VulkanDevice& device, void* guest, std::uint32_t width, std::uint32_t height, float value) {
+    constexpr std::array<std::array<float, 4>, 3> triangle{{
+        {-1.0f, -1.0f, 0.0f, 1.0f}, {3.0f, -1.0f, 0.0f, 1.0f}, {-1.0f, 3.0f, 0.0f, 1.0f}
+    }};
+    auto vertices = triangle;
+    for (auto& vertex : vertices) vertex[2] = value;
+    const auto vertexBuffer = VertexDescriptor(vertices.data());
+    const std::vector<std::uint32_t> userData(vertexBuffer.begin(), vertexBuffer.end());
+    const std::array<ShaderRecompiler::MemoryRegion, 1> vertexMemory{{
+        {reinterpret_cast<std::uintptr_t>(VertexCode.data()), std::as_bytes(std::span(VertexCode))}
+    }};
+    ShaderRecompiler::RecompileRequest vertexRequest{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(VertexCode.data()), VertexCode, 0, {}},
+        {32, 0, userData, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, vertexMemory},
+        device.Target(),
+        {0, 0, 0, 64}
+    };
+    vertexRequest.useCache = false;
+    const auto vertex = ShaderRecompiler::Recompile(vertexRequest);
+
+    // A valid two-stage graphics pipeline is required even for a depth-only draw.
+    constexpr std::array<std::uint32_t, 1> noExportPixel{0xbf810000u};
+    const std::array<ShaderRecompiler::MemoryRegion, 1> pixelMemory{{
+        {reinterpret_cast<std::uintptr_t>(noExportPixel.data()), std::as_bytes(std::span(noExportPixel))}
+    }};
+    ShaderRecompiler::ShaderPixelStageInfo pixelInfo{};
+    pixelInfo.wave32 = true;
+    ShaderRecompiler::RecompileRequest pixelRequest{
+        {ShaderStage::Fragment, reinterpret_cast<std::uintptr_t>(noExportPixel.data()), noExportPixel, 0, {}},
+        {32, 0, {}, std::nullopt, pixelInfo, std::nullopt, pixelMemory},
+        device.Target(),
+        {0, 0, static_cast<std::uint32_t>(vertex.pushConstants.size()), 128u - static_cast<std::uint32_t>(vertex.pushConstants.size())}
+    };
+    pixelRequest.useCache = false;
+    const auto fragment = ShaderRecompiler::Recompile(pixelRequest);
+    const std::array<AgcDriver::Graphics::CompiledShader, 2> shaders{{
+        {ShaderStage::Vertex, &vertex, 0},
+        {ShaderStage::Fragment, &fragment, static_cast<std::uint32_t>(vertex.pushConstants.size())}
+    }};
+
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, 32u, 32u, std::nullopt, std::nullopt};
+    state.depth = AgcDriver::Graphics::DepthTarget{
+        reinterpret_cast<std::uintptr_t>(guest), 0, {width, height}, VK_FORMAT_D32_SFLOAT, 1.0f, 0
+    };
+    state.depthTest = true;
+    state.depthWrite = true;
+    state.depthCompare = VK_COMPARE_OP_ALWAYS;
+    state.stencilTest = false;
+    state.renderExtent = {width, height};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(height), static_cast<float>(width), -static_cast<float>(height), 0, 1};
+    state.negativeOneToOne = false;
+    state.scissor = {{0, 0}, {width, height}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(vertices.size()), 0, 1, 0, false};
+    device.Draw(state, draw, shaders);
+}
+
+void SetSamples(std::uint32_t width, std::uint32_t height) {
+    constexpr std::array<std::array<std::uint32_t, 2>, Threads> pixels{{
+        {{24, 18}}, {{48, 18}}, {{72, 18}}, {{96, 18}}, {{120, 18}}, {{144, 18}}, {{24, 36}}, {{48, 36}},
+        {{72, 36}}, {{96, 36}}, {{120, 36}}, {{144, 36}}, {{24, 54}}, {{48, 54}}, {{72, 54}}, {{96, 54}},
+        {{120, 54}}, {{144, 54}}, {{24, 72}}, {{48, 72}}, {{72, 72}}, {{96, 72}}, {{120, 72}}, {{144, 72}},
+        {{24, 90}}, {{48, 90}}, {{72, 90}}, {{96, 90}}, {{120, 90}}, {{144, 90}}, {{160, 72}}, {{160, 90}}
+    }};
+    for (std::uint32_t lane = 0; lane < Threads; ++lane) {
+        const auto x = std::min(pixels[lane][0], width - 2u);
+        const auto y = std::min(pixels[lane][1], height - 2u);
+        // v1 is left as a harmless sentinel; the ordinary image_sample_lz starts its two
+        // normalized coordinates at v2 and consumes x/y from these next two floats.
+        Inputs[lane * 3u] = 0.5f;
+        Inputs[lane * 3u + 1u] = (static_cast<float>(x) + 0.5f) / static_cast<float>(width);
+        Inputs[lane * 3u + 2u] = (static_cast<float>(y) + 0.5f) / static_cast<float>(height);
+    }
+}
+
+void SampleAndAwaitLocked(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& consumer,
+                          float expected, const char* phase, AgcDriver::Graphics::Recorder& recorder,
+                          std::uint64_t submissionsBefore, std::shared_ptr<const AgcDriver::Recipe>* recipe = nullptr) {
+    std::fill_n(Outputs, Threads, -1.0f);
+    device.Dispatch(consumer, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(SampleCode.data()), nullptr, recipe);
+    Require(recorder.Submissions() == submissionsBefore,
+            std::string("depth last-bind: ") + phase + " producer and sampled consumer did not remain in one unsubmitted recorder batch");
+    device.WaitIdle();
+    Require(recorder.Submissions() > submissionsBefore,
+            std::string("depth last-bind: ") + phase + " awaited batch was not submitted");
+    for (std::uint32_t lane = 0; lane < Threads; ++lane) {
+        Require(Outputs[lane] == expected,
+                std::string("depth last-bind: ") + phase + " GPU sample lane " + std::to_string(lane) +
+                    " was " + std::to_string(Outputs[lane]) + ", expected " + std::to_string(expected));
+    }
+}
+
+void DrawAndSample(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& consumer,
+                   void* guest, std::uint32_t width, std::uint32_t height, float value, const char* phase,
+                   std::shared_ptr<const AgcDriver::Recipe>* recipe = nullptr) {
+    SetSamples(width, height);
+    std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+    auto* recorder = AgcDriver::Graphics::Recorder::Active();
+    Require(recorder != nullptr, "depth last-bind: missing active graphics recorder");
+    const auto submissionsBefore = recorder->Submissions();
+    DrawDepth(device, guest, width, height, value);
+    // The draw's positive pixel oracle below proves it recorded its value; this counter boundary
+    // proves neither that producer nor the following consumer submitted before the awaited batch.
+    Require(recorder->Submissions() == submissionsBefore,
+            std::string("depth last-bind: ") + phase + " producer draw submitted before its sampled consumer");
+    SampleAndAwaitLocked(device, consumer, value, phase, *recorder, submissionsBefore, recipe);
+}
+
+void ExpectWrongExtent(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& consumer,
+                       std::uint32_t boundWidth, std::uint32_t boundHeight,
+                       std::uint32_t requestedWidth, std::uint32_t requestedHeight) {
+    try {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        device.Dispatch(consumer, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(SampleCode.data()));
+    } catch (const std::exception& error) {
+        const std::string message(error.what());
+        const auto bound = "(" + std::to_string(boundWidth) + "x" + std::to_string(boundHeight) + ",";
+        const auto requested = "as a " + std::to_string(requestedWidth) + "x" + std::to_string(requestedHeight) + " texture";
+        Require(message.find("depth surface") != std::string::npos && message.find(bound) != std::string::npos &&
+                    message.find(requested) != std::string::npos && message.find("is not implemented") != std::string::npos,
+                std::string("depth last-bind: wrong extent refused for an unrelated reason: ") + error.what());
+        return;
+    }
+    Require(false, "depth last-bind: stale retained depth object accepted a descriptor whose extent was not last bound");
+}
+
+void ReplayRecipeAndAwait(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& consumer,
+                          const std::shared_ptr<const AgcDriver::Recipe>& recipe, float expected) {
+    Require(AgcDriver::VulkanDevice::DispatchRecipes(),
+            "depth last-bind: dispatch recipes are disabled, so the actual cache-reuse gate cannot run");
+    auto hit = device.PrepareRecipe(recipe, false);
+    Require(hit != nullptr, "depth last-bind: retained dispatch recipe did not produce a real cache hit");
+    AgcDriver::VulkanDevice::IndirectOutcome outcome{};
+    AgcDriver::RecipeOutcome recorded;
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        auto* recorder = AgcDriver::Graphics::Recorder::Active();
+        Require(recorder != nullptr, "depth last-bind: missing active recorder for recipe replay");
+        std::fill_n(Outputs, Threads, -1.0f);
+        const auto submissionsBefore = recorder->Submissions();
+        recorded = device.DispatchRecipe(consumer, 1, 1, 1, 0, reinterpret_cast<std::uintptr_t>(SampleCode.data()), hit, outcome);
+        Require(recorded == AgcDriver::RecipeOutcome::Recorded,
+                "depth last-bind: cached resource recipe failed its currentness proof after A rebind");
+        device.WaitIdle();
+        Require(recorder->Submissions() > submissionsBefore,
+                "depth last-bind: recipe replay did not submit its recorded GPU dispatch");
+        for (std::uint32_t lane = 0; lane < Threads; ++lane) {
+            Require(Outputs[lane] == expected,
+                    "depth last-bind: cached recipe returned stale depth at lane " + std::to_string(lane));
+        }
+    }
+}
+
+} // namespace
+
+int main() {
+    try {
+        // Device is declared after guest blocks so it is destroyed first; registered memory remains
+        // live through recorder retirement and depth-image teardown.
+        GuestBlock inputMemory(sizeof(float) * Threads * 3u);
+        GuestBlock outputMemory(sizeof(float) * Threads);
+        GuestBlock guest(2u * 1024u * 1024u);
+        Inputs = reinterpret_cast<float*>(inputMemory.data());
+        Outputs = reinterpret_cast<float*>(outputMemory.data());
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        if (device->Target().subgroupSize < 32u) return VulkanTestSkipped;
+
+        // Stage A and B have the same guest base and native descriptor format/tile shape, with
+        // only extent changing. The 2 MiB registered guest block bounds the fixture comfortably.
+        const auto consumerA = CompileSample(*device, guest.data(), WidthA, HeightA);
+        const auto consumerB = CompileSample(*device, guest.data(), WidthB, HeightB);
+
+        DrawAndSample(*device, consumerA, guest.data(), WidthA, HeightA, 0.25f, "initial A clear and write");
+
+        DrawAndSample(*device, consumerB, guest.data(), WidthB, HeightB, 0.75f, "B write");
+        ExpectWrongExtent(*device, consumerA, WidthB, HeightB, WidthA, HeightA);
+
+        // Reusing the original A object exercises the last-bind lookup. Keep its producer and
+        // consumer in one queue batch; the oracle is read only after WaitIdle completes that batch.
+        std::shared_ptr<const AgcDriver::Recipe> reboundRecipeA;
+        DrawAndSample(*device, consumerA, guest.data(), WidthA, HeightA, 0.5f, "A rebind after B", &reboundRecipeA);
+        Require(reboundRecipeA != nullptr, "depth last-bind: A rebind dispatch did not produce a reusable resource recipe");
+        ReplayRecipeAndAwait(*device, consumerA, reboundRecipeA, 0.5f);
+
+        DrawAndSample(*device, consumerB, guest.data(), WidthB, HeightB, 0.625f, "B rebind after A");
+        ExpectWrongExtent(*device, consumerA, WidthB, HeightB, WidthA, HeightA);
+
+        std::puts("depth last-bind A/B/A GPU content test passed");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}

+std::vector<std::uint32_t> MakeGpuBufferSubwordTestShader(const GpuBufferSubwordCase& test) {
+    using namespace ShaderRecompiler;
+    AgcDriver::Graphics::Require(test.bits == 8u || test.bits == 16u, "invalid GPU buffer subword test width");
+    IrProgram program;
+    program.Resources().stage = IrShaderStage::Compute;
+    program.Info().usesDma = true;
+    program.Info().bdaWrites = test.store;
+    MemoryInfo memory;
+    memory.kind = ResourceKind::Buffer;
+    memory.dataBits = test.bits;
+    memory.offset = test.immediate;
+    memory.gpuDescriptor = true;
+    memory.coherent = true;
+    program.Resources().memoryInfo = {memory};
+    IrBuilder builder(program);
+    auto& block = program.CreateBlock();
+    builder.SetInsertionPoint(block);
+    auto& handle = builder.Emit(IrOpcode::GetBufferResource, IrType::BufferResource, {&builder.Constant(test.descriptor[0]), &builder.Constant(test.descriptor[1]), &builder.Constant(test.descriptor[2]), &builder.Constant(test.descriptor[3])});
+    const auto opcode = test.store ? (test.bits == 8u ? IrOpcode::StoreBufferU8 : IrOpcode::StoreBufferU16) : (test.bits == 8u ? IrOpcode::LoadBufferU8 : IrOpcode::LoadBufferU16);
+    auto& index = builder.Constant(test.index);
+    auto& offset = builder.Constant(test.offset);
+    auto& soffset = builder.Constant(test.soffset);
+    auto& active = builder.ConstantBool(test.active);
+    IrValue& inst = test.store ? builder.Emit(opcode, IrType::Void, {&handle, &index, &offset, &soffset, &(test.bits == 8u ? builder.ConstantU8(static_cast<std::uint8_t>(test.value)) : builder.ConstantU16(static_cast<std::uint16_t>(test.value))), &active}) : builder.Emit(opcode, IrOpcodeType(opcode), {&handle, &index, &offset, &soffset, &active});
+    MemoryFlags flags{};
+    flags.pc = 0x5678;
+    inst.SetFlags(flags);
+    SpirvEmitterState state(program, {});
+    EmitBaseHeader(state.module, program);
+    state.module.EmitCapability(spv::CapabilityGroupNonUniform);
+    const auto define = [&](std::uint32_t binding) {
+        const auto variable = state.module.DefineGlobalVariable(TypeStorageBufferPointer(state), spv::StorageClassStorageBuffer);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationDescriptorSet, 0u);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationBinding, binding);
+        return variable;
+    };
+    state.bdaPagetableVariable = define(0);
+    state.faultBufferVariable = define(1);
+    const auto output = define(2);
+    state.subgroupLocalInvocationIdVariable = state.module.DefineGlobalVariable(TypePointer(state, spv::StorageClassInput, TypeU32(state)), spv::StorageClassInput);
+    state.module.AddAnnotation(spv::OpDecorate, state.subgroupLocalInvocationIdVariable, spv::DecorationBuiltIn, spv::BuiltInSubgroupLocalInvocationId);
+    DefineGetBdaPointer(state);
+    const auto main = state.module.AllocateId();
+    state.module.AddFunction(spv::OpFunction, TypeVoid(state), main, spv::FunctionControlMaskNone, TypeFunction(state));
+    EmitLabel(state, state.module.AllocateId());
+    SpirvValueEmitContext ctx(state);
+    if (test.store) {
+        if (test.bits == 8u) EmitStoreBufferU8(ctx, inst);
+        else EmitStoreBufferU16(ctx, inst);
+    } else {
+        if (test.bits == 8u) EmitLoadBufferU8(ctx, inst);
+        else EmitLoadBufferU16(ctx, inst);
+    }
+    state.module.AddFunction(spv::OpStore, BdaWord(state, output, ConstantU32(state, 0u)), test.store ? ConstantU32(state, 0x12345678u) : ctx.Result(inst));
+    state.module.AddFunction(spv::OpReturn);
+    state.module.AddFunction(spv::OpFunctionEnd);
+    state.module.AddExecutionMode(main, spv::ExecutionModeLocalSize, 1u, 1u, 1u);
+    const std::vector<std::uint32_t> interfaceVariables{state.subgroupLocalInvocationIdVariable};
+    state.module.EmitEntryPoint(spv::ExecutionModelGLCompute, main, "main", interfaceVariables);
+    return state.module.Finalize();
+}

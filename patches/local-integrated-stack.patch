+void importWindowLifetimeTests(const Context& context) {
+    auto gpu = gpuLockIfNeeded();
+    constexpr std::size_t window = 64ull << 20u;
+    constexpr std::size_t bytes = 3 * window;
+    void* block = ::operator new(bytes, std::align_val_t{window});
+    const auto base = reinterpret_cast<std::uintptr_t>(block);
+    auto importing = context;
+    importing.hostImportAlignment = 65536;
+    GuestAllocations::Mutation().Add(block, bytes, true, true);
+    const auto address = base + window + 64;
+    const auto* first = HostImportFor(importing, address, 32);
+    Require(first != nullptr && first->base == base + window && first->bytes == window, "an interior host-import window was not created");
+    const auto buffer = first->buffer;
+    const auto serial = HostImportSerial(importing, address, 32, false);
+    void* other = GuestHeap::GuestHeapAllocate_nid_postfix(64);
+    Require(HostImportFor(importing, address, 32)->buffer == buffer && HostImportSerial(importing, address, 32, false) == serial, "an unrelated registration retired an interior host-import window");
+    GuestHeap::GuestHeapFree_nid_postfix(other);
+    Require(HostImportSerial(importing, address, 32, true) == serial, "an unrelated removal retired an interior host-import window");
+    GuestAllocations::Mutation().Protect(block, bytes, true, false, [] {});
+    Require(HostImportFor(importing, address, 32) != nullptr && HostImportSerial(importing, address, 32, false) != serial, "a replaced registration kept its old host-import window");
+    const auto protectedSerial = HostImportSerial(importing, address, 32, false);
+    GuestAllocations::Mutation().Remove(block);
+    GuestAllocations::Mutation().Add(block, bytes, true, true);
+    Require(HostImportFor(importing, address, 32) != nullptr && HostImportSerial(importing, address, 32, false) != protectedSerial, "a remapped registration kept its old host-import window");
+    GuestAllocations::Mutation().Remove(block);
+    Require(HostImportFor(importing, address, 32) == nullptr && !HostImportCovers(importing, address, 32), "a host-import window outlived its registration");
+    ::operator delete(block, std::align_val_t{window});
+
+    constexpr std::size_t largeBytes = 17 * window;
+    block = ::operator new(largeBytes, std::align_val_t{window});
+    const auto largeBase = reinterpret_cast<std::uintptr_t>(block);
+    GuestAllocations::Mutation().Add(block, largeBytes, true, true);
+    const auto* wide = HostImportFor(importing, largeBase + window - 16, 32);
+    Require(wide != nullptr && wide->base == largeBase && wide->bytes == 2 * window, "a crossing host-import window was not created");
+    const auto wideBuffer = wide->buffer;
+    const auto wideSerial = HostImportSerial(importing, largeBase, 32, false);
+    const auto overlapAddress = largeBase + 2 * window - 16;
+    const auto* overlap = HostImportFor(importing, overlapAddress, 32);
+    const bool groupingEnabled = std::getenv("APS5_IMPORT_SPANS") != nullptr;
+    const auto overlapBuffer = overlap != nullptr ? overlap->buffer : VK_NULL_HANDLE;
+    const auto overlapSerial = HostImportSerial(importing, overlapAddress, 32, false);
+    if (groupingEnabled) {
+        Require(overlap != nullptr && overlap->base == largeBase && overlap->bytes == 3 * window, "pressure did not consolidate adjacent same-owner windows into their union");
+        Require(overlapBuffer != wideBuffer && overlapSerial != 0 && wideSerial != 0, "window consolidation did not replace the previous import identity");
+        const auto* firstQuery = HostImportFor(importing, largeBase + window - 16, 32);
+        Require(firstQuery == overlap && HostImportFor(importing, overlapAddress, 32) == overlap, "alternating queries did not reuse the consolidated import");
+        const HostImport* capped = overlap;
+        for (std::size_t boundary = 3; boundary <= 7; ++boundary) {
+            capped = HostImportFor(importing, largeBase + boundary * window - 16, 32);
+            Require(capped != nullptr && capped->base == largeBase && capped->bytes == (boundary + 1) * window,
+                    "same-owner consolidation did not grow monotonically up to the 512 MiB cap");
+        }
+        const auto cappedSerial = HostImportSerial(importing, largeBase, 32, false);
+        const auto* beyondCap = HostImportFor(importing, largeBase + 8 * window - 16, 32);
+        Require(beyondCap != nullptr && beyondCap->base == largeBase + 7 * window && beyondCap->bytes == 2 * window,
+                "a union over 512 MiB did not fall back to a separate bounded window");
+        const auto bridgeBuffer = beyondCap->buffer;
+        const auto bridgeSerial = HostImportSerial(importing, largeBase + 8 * window - 16, 32, false);
+        Require(HostImportFor(importing, largeBase, 32) == capped && HostImportSerial(importing, largeBase, 32, false) == cappedSerial,
+                "a union over 512 MiB retired the previously valid bounded import");
+        const auto* next = HostImportFor(importing, largeBase + 9 * window - 16, 32);
+        Require(next != nullptr && next->base == largeBase + 8 * window && next->bytes == 2 * window,
+                "the next bounded group did not create its first window");
+        const auto* nextJoined = HostImportFor(importing, largeBase + 10 * window - 16, 32);
+        Require(nextJoined != nullptr && nextJoined->base == largeBase + 8 * window && nextJoined->bytes == 3 * window,
+                "a capped earlier group blocked consolidation of the next bounded group");
+        Require(HostImportFor(importing, largeBase + 8 * window - 16, 32) == beyondCap && beyondCap->buffer == bridgeBuffer &&
+                    HostImportSerial(importing, largeBase + 8 * window - 16, 32, false) == bridgeSerial,
+                "consolidating the next group retired or replaced the crossing bridge");
+        Require(HostImportFor(importing, largeBase, 32) == capped && HostImportSerial(importing, largeBase, 32, false) == cappedSerial,
+                "consolidating the next group retired an earlier bounded import");
+    } else {
+        Require(overlap != nullptr && overlap->base == largeBase + window && overlap->bytes == 2 * window, "the adjacent crossing query did not create its overlapping import window");
+        Require(overlapBuffer != wideBuffer && overlapSerial != 0 && wideSerial != 0, "overlapping import windows did not keep separate identities");
+    }
+    const auto before = AddressSpaceCounters();
+    for (int build = 0; build < 2; ++build) {
+        GuestBufferMemory leased(importing);
+        leased.AcquireRegistered();
+        leased.Upload(true);
+        const auto* firstQuery = HostImportFor(importing, largeBase, 32);
+        const auto* secondQuery = HostImportFor(importing, overlapAddress, 32);
+        if (groupingEnabled) {
+            Require(firstQuery != nullptr && secondQuery != nullptr && firstQuery == secondQuery && firstQuery->base == largeBase && firstQuery->bytes == 8 * window, "address-space coverage did not retain the consolidated same-owner window");
+            const auto serial = HostImportSerial(importing, largeBase, 32, false);
+            Require(serial != 0 && HostImportSerial(importing, overlapAddress, 32, false) == serial, "alternating addresses did not keep one import identity after consolidation");
+        } else {
+            Require(firstQuery->buffer == wideBuffer && HostImportSerial(importing, largeBase, 32, false) == wideSerial, "a narrower address-based region replaced a covering host import");
+            Require(secondQuery->buffer == overlapBuffer && HostImportSerial(importing, overlapAddress, 32, false) == overlapSerial, "a wider address-based region retired a still-valid overlapping import");
+        }
+        leased.WriteBack();
+    }
+    if (before.enabled) Require(AddressSpaceCounters().hits == before.hits + 1, "stable host-import windows did not reuse the address space");
+    GuestAllocations::Mutation().Remove(block);
+    Require(HostImportFor(importing, largeBase, 32) == nullptr, "an address-based host import outlived its registration");
+    ::operator delete(block, std::align_val_t{window});
+}

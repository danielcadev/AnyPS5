+        return state.module.Constant(spv::OpConstantComposite, vector, ConstantU32(state, info.componentCount), ConstantU32(state, widths), ConstantU32(state, offsets), ConstantU32(state, static_cast<std::uint32_t>(info.type) | (info.packedBitfield ? 0x100u : 0u)));

+    if (measured && before.st_blocks >= 0 && after.st_blocks >= 0) {
+        const auto beforeBytes = static_cast<std::uint64_t>(before.st_blocks) * 512u;
+        const auto afterBytes = static_cast<std::uint64_t>(after.st_blocks) * 512u;
+        if (afterBytes >= beforeBytes) dmaPinGrowthBytes.fetch_add(afterBytes - beforeBytes, std::memory_order_relaxed);

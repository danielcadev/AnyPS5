+std::uint32_t DefineRuntimeFormatConversion(SpirvEmitterState& state, const std::vector<SpirvBufferFormatInfo>& formats, bool d16, bool store = false) {
+    const auto u32 = TypeU32(state);
+    const auto function = state.module.AllocateId();
+    state.module.AddName(function, store ? "runtime_buffer_encode" : d16 ? "runtime_buffer_convert_d16" : "runtime_buffer_convert");
+    state.module.AddFunction(spv::OpFunction, u32, function, spv::FunctionControlDontInlineMask, state.module.Type(spv::OpTypeFunction, u32, u32, u32));
+    const auto key = RuntimeFormatParameter(state, u32);
+    const auto raw = RuntimeFormatParameter(state, u32);
+    EmitLabel(state, state.module.AllocateId());
+    std::vector<std::uint32_t> keys;
+    std::vector<std::pair<SpirvBufferFormatInfo, std::uint32_t>> components;
+    for (const auto& info : formats) {
+        for (std::uint32_t component = 0; component < info.componentCount; ++component) {
+            const auto keyValue = (static_cast<std::uint32_t>(info.type) << 8u) | info.componentBits[component];

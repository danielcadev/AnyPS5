+                         static_cast<unsigned>(resource.dimension), resource.mipCount, resource.allocatedMipCount, mip,
+                         resource.baseLevel, resource.lastLevel, resource.baseArray, resource.depthOrLastArray,
+                         static_cast<unsigned long long>(resource.dccAddress), static_cast<unsigned>(resource.tileMode),
+                         static_cast<unsigned long long>(target.address), static_cast<unsigned long long>(target.stencilAddress),
+                         static_cast<unsigned>(target.format), target.extent.width, target.extent.height,
+                         static_cast<unsigned long long>(boundRevision));

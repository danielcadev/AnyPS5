+    bool PrepareColorStorage(const GuestTextureResource& resource, std::uint32_t mip) {
+        if (!IsReusedColorStorage(resource, mip)) return false;
+        const auto bytes = DescribeSurface(resource).guestBytes;
+        if (auto source = colorOwner.lock(); source != nullptr && bytes <= source->GuestBytes() &&
+            CanUseColorOwner(source->Descriptor(), source->GuestBytes())) {
+            const auto& producer = source->Descriptor();
+            if (producer.format != resource.format || producer.tileMode != resource.tileMode ||
+                producer.width != resource.width || producer.height != resource.height) {
+                source->WriteBack();

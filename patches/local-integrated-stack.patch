+        const auto aligned = (reinterpret_cast<std::uintptr_t>(mapping) + 65535u) & ~std::uintptr_t{65535u};
+        block = reinterpret_cast<std::byte*>(aligned);
+        std::fill_n(block, this->bytes, std::byte{0});
+        GuestWriteWatch::GuestWriteWatchRegister_nid_postfix(block, this->bytes);
+        registeredWatch = true;
+        GuestAllocations::Mutation().Add(block, this->bytes, true, true);
+        registeredAllocation = true;
+        Require(GuestWriteWatch::GuestWriteWatchCovers_nid_postfix(reinterpret_cast<std::uintptr_t>(block), this->bytes),
+                "depth/color DCC: write-watch registration does not cover metadata");

+    buffer.read = !test.store;
+    buffer.written = test.store;
+    buffer.descriptorSwizzle = test.descriptorSwizzle;
+    program.Info().buffers = {buffer};
+    IrBuilder builder(program);
+    auto& block = program.CreateBlock();
+    builder.SetInsertionPoint(block);
+    std::array<IrValue*, 7> inputs{};
+    for (auto& input : inputs) input = &builder.Emit(IrOpcode::UndefU32, IrType::U32, {});
+    auto& active = builder.Emit(IrOpcode::UndefU1, IrType::U1, {});
+    auto& handle = builder.Emit(IrOpcode::GetBufferResource, IrType::BufferResource, {inputs[0], inputs[1], inputs[2], inputs[3]});
+    constexpr std::array loads{IrOpcode::LoadBufferU32, IrOpcode::LoadBufferU32x2, IrOpcode::LoadBufferU32x3, IrOpcode::LoadBufferU32x4};
+    constexpr std::array stores{IrOpcode::StoreBufferU32, IrOpcode::StoreBufferU32x2, IrOpcode::StoreBufferU32x3, IrOpcode::StoreBufferU32x4};
+    const auto opcode = (test.store ? stores : loads)[test.components - 1u];
+    std::array<IrValue*, 4> payload{};
+    for (auto& value : payload) value = &builder.Emit(IrOpcode::UndefU32, IrType::U32, {});
+    IrValue* data = payload[0];
+    if (test.store && test.components > 1u) {
+        constexpr std::array constructs{IrOpcode::CompositeConstructU32x2, IrOpcode::CompositeConstructU32x3, IrOpcode::CompositeConstructU32x4};
+        const auto construct = constructs[test.components - 2u];
+        if (test.components == 2u) data = &builder.Emit(construct, IrOpcodeType(construct), {payload[0], payload[1]});
+        if (test.components == 3u) data = &builder.Emit(construct, IrOpcodeType(construct), {payload[0], payload[1], payload[2]});
+        if (test.components == 4u) data = &builder.Emit(construct, IrOpcodeType(construct), {payload[0], payload[1], payload[2], payload[3]});
+    }
+    auto& inst = test.store ? builder.Emit(opcode, IrOpcodeType(opcode), {&handle, inputs[4], inputs[5], inputs[6], data, &active}) : builder.Emit(opcode, IrOpcodeType(opcode), {&handle, inputs[4], inputs[5], inputs[6], &active});
+    MemoryFlags flags{};
+    flags.pc = 0x89abu;
+    inst.SetFlags(flags);
+    // Populate real IR users, so the production used-output analysis can suppress unobserved
+    // components. SPIR-V output below writes exactly those components.
+    if (!test.store && test.components > 1u) {
+        for (std::uint32_t component = 0; component < test.components; ++component) {
+            if ((test.usedMask & (1u << component)) != 0u) builder.CompositeExtract(inst, component);
+        }
+    }
+    SpirvEmitterState state(program, {});
+    EmitBaseHeader(state.module, program);
+    state.module.EmitCapability(spv::CapabilityGroupNonUniform);
+    const auto define = [&](std::uint32_t binding) {
+        const auto variable = state.module.DefineGlobalVariable(TypeStorageBufferPointer(state), spv::StorageClassStorageBuffer);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationDescriptorSet, 0u);
+        state.module.AddAnnotation(spv::OpDecorate, variable, spv::DecorationBinding, binding);
+        return variable;
+    };
+    state.bdaPagetableVariable = define(0u);
+    state.faultBufferVariable = define(1u);
+    const auto io = define(2u);
+    state.subgroupLocalInvocationIdVariable = state.module.DefineGlobalVariable(TypePointer(state, spv::StorageClassInput, TypeU32(state)), spv::StorageClassInput);
+    state.module.AddAnnotation(spv::OpDecorate, state.subgroupLocalInvocationIdVariable, spv::DecorationBuiltIn, spv::BuiltInSubgroupLocalInvocationId);
+    const auto invocation = state.module.DefineGlobalVariable(TypePointer(state, spv::StorageClassInput, TypeU32(state)), spv::StorageClassInput);
+    state.module.AddAnnotation(spv::OpDecorate, invocation, spv::DecorationBuiltIn, spv::BuiltInLocalInvocationIndex);
+    state.bdaStopsInvocations = test.stops;
+    DefineGetBdaPointer(state);
+    if (test.store) DefineGpuFormattedBufferFunctions(state);
+    const auto main = state.module.AllocateId();
+    state.module.AddFunction(spv::OpFunction, TypeVoid(state), main, spv::FunctionControlMaskNone, TypeFunction(state));
+    EmitLabel(state, state.module.AllocateId());
+    SpirvValueEmitContext ctx(state);
+    const auto lane = state.module.AllocateId();
+    state.module.AddFunction(spv::OpLoad, TypeU32(state), lane, invocation);
+    const auto inputWord = [&](std::uint32_t word) {
+        const auto value = state.module.AllocateId();
+        state.module.AddFunction(spv::OpLoad, TypeU32(state), value, BdaWord(state, io, ConstantU32(state, word)));
+        return value;
+    };
+    for (std::uint32_t i = 0; i < inputs.size(); ++i) ctx.Define(*inputs[i], inputWord(16u + i));
+    const auto activeBit = Binary(state, spv::OpShiftLeftLogical, TypeU32(state), ConstantU32(state, 1u), lane);
+    ctx.Define(active, Binary(state, spv::OpINotEqual, TypeBool(state), Binary(state, spv::OpBitwiseAnd, TypeU32(state), inputWord(23u), activeBit), ConstantU32(state, 0u)));
+    if (test.store) {
+        for (std::uint32_t component = 0; component < test.components; ++component) ctx.Define(*payload[component], inputWord(24u + component));
+        if (test.components > 1u) {
+            std::vector<std::uint32_t> arguments;
+            for (std::uint32_t component = 0; component < test.components; ++component) arguments.push_back(ctx.Result(*payload[component]));
+            const auto value = state.module.AllocateId();
+            state.module.AddFunction(spv::OpCompositeConstruct, TypeU32Composite(state, test.components), value, arguments);
+            ctx.Define(*data, value);
+        }
+        switch (test.components) {
+            case 1u: EmitStoreBufferU32(ctx, inst); break;
+            case 2u: EmitStoreBufferU32x2(ctx, inst); break;
+            case 3u: EmitStoreBufferU32x3(ctx, inst); break;
+            case 4u: EmitStoreBufferU32x4(ctx, inst); break;
+        }
+    } else switch (test.components) {
+        case 1u: EmitLoadBufferU32(ctx, inst); break;
+        case 2u: EmitLoadBufferU32x2(ctx, inst); break;
+        case 3u: EmitLoadBufferU32x3(ctx, inst); break;
+        case 4u: EmitLoadBufferU32x4(ctx, inst); break;
+    }
+    if (!test.stops) state.module.AddFunction(spv::OpControlBarrier, ConstantU32(state, spv::ScopeWorkgroup), ConstantU32(state, spv::ScopeWorkgroup), ConstantU32(state, spv::MemorySemanticsAcquireReleaseMask | spv::MemorySemanticsWorkgroupMemoryMask));
+    for (std::uint32_t component = 0; !test.store && component < test.components; ++component) {
+        if ((test.usedMask & (1u << component)) == 0u) continue;
+        auto value = ctx.Result(inst);
+        if (test.components > 1u) {
+            const auto extracted = state.module.AllocateId();
+            state.module.AddFunction(spv::OpCompositeExtract, TypeU32(state), extracted, value, component);
+            value = extracted;
+        }
+        const auto output = Binary(state, spv::OpIAdd, TypeU32(state), Binary(state, spv::OpIMul, TypeU32(state), lane, ConstantU32(state, 4u)), ConstantU32(state, component));

+void gpuEligibilityTests(const Context& context) {
+    constexpr std::size_t bytes = 65536;
+    alignas(65536) std::array<std::byte, bytes> cpuOnly{};
+    alignas(65536) std::array<std::byte, bytes> gpuMapped{};
+    const auto cpuAddress = reinterpret_cast<std::uintptr_t>(cpuOnly.data());
+    const auto gpuAddress = reinterpret_cast<std::uintptr_t>(gpuMapped.data());
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Add(cpuOnly.data(), bytes, true, false, false);
+        mutation.Add(gpuMapped.data(), bytes, true, false, true);
+    }
+    const auto checkBda = [&](bool gpuExpected) {
+        GuestBufferMemory memory(context);
+        memory.AcquireRegistered();
+        memory.Upload(true);
+        const auto ranges = memory.AddressRanges();
+        Require(std::none_of(ranges.begin(), ranges.end(), [&](const auto& range) { return range.begin < cpuAddress + bytes && cpuAddress < range.end; }), "a CPU-only readable range entered the BDA table");
+        const bool present = std::any_of(ranges.begin(), ranges.end(), [&](const auto& range) { return range.begin <= gpuAddress && gpuAddress + bytes <= range.end; });
+        Require(present == gpuExpected, "the BDA table retained stale GPU eligibility after a protection change");
+        memory.WriteBack();
+    };
+    checkBda(true);
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Protect(gpuMapped.data(), bytes, true, false, [] {}, false);
+    }
+    checkBda(false);
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Protect(gpuMapped.data(), bytes, true, false, [] {}, true);
+    }
+    checkBda(true);
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Remove(cpuOnly.data());
+        mutation.Remove(gpuMapped.data());
+    }
+
+    void* remapped = nullptr;
+    Require(DoMapAnon(&remapped, PS5_PAGE_SIZE, 0x12, 0) == 0, "cannot create a GPU-readable mapping for protection tests");
+    const auto registeredGpu = [&] {
+        const auto lease = GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+        const auto found = std::find_if(lease.begin(), lease.end(), [&](const auto& range) { return range->address == reinterpret_cast<std::uintptr_t>(remapped); });
+        Require(found != lease.end(), "the direct-memory mapping is missing from the guest registry");
+        return (*found)->gpu;
+    };
+    Require(registeredGpu(), "GPU protection bits were lost when mapping anonymous memory");
+    Require(DoMapAnon(&remapped, PS5_PAGE_SIZE, 0x02, 0x10) == 0 && !registeredGpu(), "fixed remap did not clear GPU eligibility");
+    Require(DoMprotect(remapped, PS5_PAGE_SIZE, 0x12) == 0 && registeredGpu(), "mprotect did not restore GPU eligibility");
+    Require(DoMunmap(remapped, PS5_PAGE_SIZE) == 0, "cannot unmap the GPU protection test range");
+}

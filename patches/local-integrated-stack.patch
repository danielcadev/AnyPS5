+    fragment.useCache = false;
+    const auto pixelResult = ShaderRecompiler::Recompile(fragment);
+    const std::array<AgcDriver::Graphics::CompiledShader, 2> shaders{{
+        {ShaderStage::Vertex, &result, 0},
+        {ShaderStage::Fragment, &pixelResult, static_cast<std::uint32_t>(result.pushConstants.size())}
+    }};
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, waveSize, waveSize, std::nullopt, std::nullopt};
+    state.depth = AgcDriver::Graphics::DepthTarget{reinterpret_cast<std::uintptr_t>(guest), 0, {ProducerWidth, ProducerHeight}, VK_FORMAT_D32_SFLOAT, 1.0f, 0};
+    state.renderExtent = {ProducerWidth, ProducerHeight};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(ProducerHeight), static_cast<float>(ProducerWidth), -static_cast<float>(ProducerHeight), 0, 1};
+    state.negativeOneToOne = false;
+    state.scissor = {{0, 0}, {ProducerWidth, ProducerHeight}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(triangle.size()), 0, 1, 0, false};
+    std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+    device.Draw(state, draw, shaders);
+}
+
+void SetSamples(std::uint32_t width, std::uint32_t height, bool direct) {
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = direct ? tid % 4u : 126u + tid % 16u;
+        const auto y = direct ? TileHeight + tid / 4u : tid / 16u;
+        Input[tid * 3u] = (static_cast<float>(x) + 0.5f) / static_cast<float>(width);
+        Input[tid * 3u + 1u] = (static_cast<float>(y) + 0.5f) / static_cast<float>(height);
+        Input[tid * 3u + 2u] = 0.5f;
+    }
+}
+
+float HalfValue(const std::byte* bytes) {
+    const auto bits = static_cast<std::uint16_t>(std::to_integer<std::uint8_t>(bytes[0]) |
+                                                  (static_cast<std::uint16_t>(std::to_integer<std::uint8_t>(bytes[1])) << 8u));
+    const auto exponent = (bits >> 10u) & 0x1fu;
+    const auto mantissa = bits & 0x3ffu;
+    const float sign = (bits & 0x8000u) != 0 ? -1.0f : 1.0f;
+    if (exponent == 0) return sign * std::ldexp(static_cast<float>(mantissa), -24);
+    if (exponent == 31) return mantissa == 0 ? sign * std::numeric_limits<float>::infinity() : std::numeric_limits<float>::quiet_NaN();
+    return sign * std::ldexp(1.0f + static_cast<float>(mantissa) / 1024.0f, static_cast<int>(exponent) - 15);
+}
+
+void RequireSampleOracle(const std::vector<std::byte>& expected, std::uint32_t width, std::uint32_t height, bool direct) {
+    bool sawWhite = false;
+    bool sawIntermediate = false;
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = direct ? tid % 4u : 126u + tid % 16u;
+        const auto y = direct ? TileHeight + tid / 4u : tid / 16u;
+        const auto value = HalfValue(expected.data() + SurfaceOffset(width, height, x, y));
+        sawWhite |= value == 1.0f;
+        sawIntermediate |= value > 0.0f && value < 1.0f;
+        Require(std::fabs(Output[tid] - value) < 1e-4f,
+                "depth/color DCC: sampled value differs from the independent half-float byte oracle at " + std::to_string(x) + "," + std::to_string(y));
+    }
+    Require(sawWhite && sawIntermediate,
+            "depth/color DCC: sample oracle did not include both written white and non-binary untouched RGBA16F values");
+}
+
+void RequireRawSampleSpirv(const ShaderRecompiler::RecompileResult& result) {
+    const auto& words = result.spirv.Words();
+    Require(words.size() >= 6u && words[0] == spv::MagicNumber, "depth/color DCC: sample SPIR-V is empty or malformed");
+    bool rawSample = false;
+    for (std::size_t index = 5; index < words.size();) {
+        const auto wordCount = words[index] >> 16u;
+        const auto opcode = static_cast<spv::Op>(words[index] & 0xffffu);
+        Require(wordCount != 0 && wordCount <= words.size() - index, "depth/color DCC: malformed SPIR-V instruction length");
+        Require(opcode != spv::OpImageSampleDrefImplicitLod && opcode != spv::OpImageSampleDrefExplicitLod &&
+                    opcode != spv::OpImageDrefGather,
+                "depth/color DCC: sample SPIR-V unexpectedly performs a depth comparison");
+        rawSample |= opcode == spv::OpImageSampleImplicitLod || opcode == spv::OpImageSampleExplicitLod;
+        index += wordCount;
+    }
+    Require(rawSample, "depth/color DCC: sample SPIR-V contains no non-comparison image sample");
+}
+
+void DispatchAndWait(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result) {
+    std::fill_n(Output, Threads, -1.0f);
+    std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+    device.Dispatch(result, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(SampleCode.data()));
+    device.WaitIdle();
+}
+
+std::shared_ptr<const AgcDriver::Recipe> DispatchThroughResourceProof(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result) {
+    Require(AgcDriver::VulkanDevice::DispatchRecipes(), "depth/color handoff: dispatch recipes are disabled, so the real ShaderResources proof route cannot run");
+    const auto programAddress = reinterpret_cast<std::uintptr_t>(SampleCode.data());
+    std::shared_ptr<const AgcDriver::Recipe> recipe;
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        device.Dispatch(result, 1, 1, 1, {}, programAddress, nullptr, &recipe);
+        device.WaitIdle();
+    }
+    Require(recipe != nullptr, "depth/color handoff: compute dispatch did not produce a reusable resource recipe");
+    auto hit = device.PrepareRecipe(recipe, false);
+    Require(hit != nullptr, "depth/color handoff: actual resource recipe failed its precheck");
+    auto verify = device.PrepareDispatch(result, {});
+    AgcDriver::VulkanDevice::IndirectOutcome outcome{};
+    AgcDriver::RecipeOutcome recorded;
+    {
+        std::lock_guard lock(AgcDriver::GuestMemory::GpuMutex());
+        recorded = device.DispatchRecipe(result, 1, 1, 1, 0, programAddress, hit, outcome, verify);
+        device.WaitIdle();
+    }
+    Require(recorded == AgcDriver::RecipeOutcome::Recorded,
+            "depth/color handoff: ShaderResources::ProveCurrent rejected the completed color publication");
+    return recipe;
+}
+
+bool IsExpectedUnsupportedDepthDiagnostic(const std::string& message, std::uintptr_t address,
+                                          std::uint32_t guestFormat, VkFormat guestVkFormat,
+                                          std::uint32_t tileMode) {
+    char prefix[384];
+    std::snprintf(prefix, sizeof(prefix),
+                  "AGC graphics: sampling the depth plane of depth surface 0x%llx (%ux%u, vk format %d) as a %ux%u texture of guest format %u (vk %d), tile mode %u, dimension %d, levels 0-0, slice 0 is not implemented (T# ",
+                  static_cast<unsigned long long>(address), ProducerWidth, ProducerHeight,
+                  static_cast<int>(VK_FORMAT_D32_SFLOAT), ProducerWidth, ProducerHeight, guestFormat,
+                  static_cast<int>(guestVkFormat), tileMode, static_cast<int>(TextureDimension::k2D));
+    return message.starts_with(prefix);
+}
+
+void RequireRecipeProofRejects(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result,
+                               const std::shared_ptr<AgcDriver::RecipeHit>& hit, const char* label,
+                               std::uintptr_t expectedAddress, std::uint32_t expectedGuestFormat,
+                               VkFormat expectedGuestVkFormat, std::uint32_t expectedTileMode) {
+    Require(hit != nullptr, std::string("depth/color DCC: ") + label + " did not receive a prepared actual recipe hit");
+    AgcDriver::VulkanDevice::IndirectOutcome outcome{};
+    AgcDriver::RecipeOutcome recorded = AgcDriver::RecipeOutcome::Rebuild;
+    constexpr float sentinel = -777.0f;
+    std::exception_ptr dispatchError;
+    std::string dispatchErrorText;
+    std::uint64_t submissionsBefore = 0;
+    std::uint64_t writeGenerationBefore = 0;
+    std::uint64_t publishGenerationBefore = 0;
+    std::uint64_t submissionsAfter = 0;
+    std::uint64_t writeGenerationAfter = 0;
+    std::uint64_t publishGenerationAfter = 0;
+    {
+        std::lock_guard lock(AgcDriver::GuestMemory::GpuMutex());
+        device.WaitIdle();
+        auto* const recorder = AgcDriver::Graphics::Recorder::Active();
+        Require(recorder != nullptr, "depth/color DCC: fixture has no active recorder for recipe rejection proof");
+        submissionsBefore = recorder->Submissions();
+        writeGenerationBefore = AgcDriver::Graphics::Recorder::WriteGeneration();
+        publishGenerationBefore = AgcDriver::Graphics::Recorder::PublishGeneration();
+        std::fill_n(Output, Threads, sentinel);
+        try {
+            recorded = device.DispatchRecipe(result, 1, 1, 1, 0,
+                                             reinterpret_cast<std::uintptr_t>(SampleCode.data()), hit, outcome);
+        } catch (const std::exception& error) {
+            dispatchError = std::current_exception();
+            dispatchErrorText = error.what();
+        } catch (...) {
+            dispatchError = std::current_exception();
+        }
+        // Drain even after a rejection exception so the no-recording assertion also covers any
+        // work that might have been queued before the failure.
+        device.WaitIdle();
+        submissionsAfter = recorder->Submissions();
+        writeGenerationAfter = AgcDriver::Graphics::Recorder::WriteGeneration();
+        publishGenerationAfter = AgcDriver::Graphics::Recorder::PublishGeneration();
+    }
+    const bool exactDepthRefusal = dispatchError && IsExpectedUnsupportedDepthDiagnostic(
+        dispatchErrorText, expectedAddress, expectedGuestFormat, expectedGuestVkFormat, expectedTileMode);
+    if (dispatchError && !exactDepthRefusal) std::rethrow_exception(dispatchError);
+    Require((!dispatchError && recorded == AgcDriver::RecipeOutcome::Rebuild) || exactDepthRefusal,
+            std::string("depth/color DCC: ") + label + " did not reject the stale resource proof");
+    Require(submissionsAfter == submissionsBefore && writeGenerationAfter == writeGenerationBefore &&
+                publishGenerationAfter == publishGenerationBefore,
+            std::string("depth/color DCC: ") + label + " changed recorder submission/write/publish counters");
+    Require(std::all_of(Output, Output + Threads, [](float value) { return value == sentinel; }),
+            std::string("depth/color DCC: ") + label + " changed the result buffer, so stale GPU work may have been recorded");
+}
+
+void ExpectUnsupported(AgcDriver::VulkanDevice& device, const ShaderRecompiler::RecompileResult& result, const char* label) {
+    try {
+        DispatchAndWait(device, result);
+    } catch (const std::exception& error) {
+        Require(std::string_view(error.what()).find("not implemented") != std::string_view::npos,
+                std::string("depth/color handoff: ") + label + " refused for an unrelated reason: " + error.what());
+        return;
+    }
+    Require(false, std::string("depth/color handoff: ") + label + " reused an invalid color owner");
+}
+
+void RunStrictKeyWitnessTest() {
+    AgcDriver::Graphics::GuestTextureResource surface{};
+    surface.width = 192;
+    surface.height = 108;
+    surface.mipCount = 1;
+    surface.tileMode = TextureTileMode::kR64KBX;
+    surface.dimension = TextureDimension::k2D;
+    surface.format = 56; // 4-byte color metadata has a console suffix for this geometry.
+    surface.dccPipeAligned = true;
+    GuestBlock texels(262144u);
+    GuestBlock keys(65536u);
+    surface.baseAddress = reinterpret_cast<std::uintptr_t>(texels.data());
+    surface.dccAddress = reinterpret_cast<std::uintptr_t>(keys.data());
+    const auto surfaceBytes = AgcDriver::Graphics::DescribeSurface(surface).guestBytes;
+    const auto keyCount = AgcDriver::Graphics::DccKeyCount(surface, surfaceBytes);
+    Require(surfaceBytes == 131072u && keyCount == 4096u && keyCount > surfaceBytes / 256u,
+            "depth/color DCC: 4Bpp fixture does not include the console metadata suffix");
+    std::fill_n(keys.data(), keyCount, std::byte{0xff});
+    std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+    auto witness = AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes);
+    Require(witness.has_value() && witness->bytes.size() == keyCount,
+            "depth/color DCC: strict witness did not cover every 4Bpp suffix key");
+    keys.data()[surfaceBytes / 256u] = std::byte{0x00};
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: strict witness ignored a clear key in the console suffix");
+    keys.data()[surfaceBytes / 256u] = std::byte{0xff};
+    const std::array<std::byte, 6> rejectedKeys{std::byte{0x00}, std::byte{0x40}, std::byte{0x80},
+                                                std::byte{0xc0}, std::byte{0x20}, std::byte{0x7f}};
+    for (const auto key : rejectedKeys) {
+        std::fill_n(keys.data(), keyCount, key);
+        Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+                "depth/color DCC: strict witness accepted a clear, register, or unknown uniform key code");
+    }
+    std::fill_n(keys.data(), keyCount, std::byte{0x20});
+    Require(AgcDriver::Graphics::TextureClearKeys(surface, surfaceBytes) == AgcDriver::Graphics::DccKeys::Uncompressed &&
+                !AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: lossy register-key normalization authorized strict ownership");
+    std::fill_n(keys.data(), keyCount, std::byte{0x7f});
+    Require(AgcDriver::Graphics::TextureClearKeys(surface, surfaceBytes) == AgcDriver::Graphics::DccKeys::Uncompressed &&
+                !AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: lossy unknown-key normalization authorized strict ownership");
+    std::fill_n(keys.data(), keyCount, std::byte{0xff});
+    keys.data()[keyCount / 2u] = std::byte{0x01};
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: strict witness accepted mixed metadata keys");
+    keys.data()[keyCount / 2u] = std::byte{0xff};
+    const auto dccAddress = surface.dccAddress;
+    surface.dccAddress = surface.baseAddress;
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: strict witness accepted metadata aliased over texels");
+    surface.dccAddress = dccAddress;
+    surface.baseAddress = 0;
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: strict witness accepted a null texel base");
+    surface.baseAddress = reinterpret_cast<std::uintptr_t>(texels.data());
+    keys.ReRegisterWithoutDepthRebind();
+    auto replaced = AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes);
+    Require(replaced.has_value() && !AgcDriver::Graphics::SameCurrentUncompressedDccWitness(*witness, *replaced),
+            "depth/color DCC: strict witness survived metadata allocation identity replacement");
+    keys.ReRegisterPrefix(surfaceBytes / 256u);
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+            "depth/color DCC: strict witness accepted a registered prefix without the suffix allocation");
+#ifndef _WIN32
+    if (GuestWriteWatch::GuestWriteWatchAvailable_nid_postfix()) {
+        WatchedGuestBlock watchedKeys(262144u);
+        std::fill_n(watchedKeys.data(), keyCount, std::byte{0xff});
+        surface.dccAddress = reinterpret_cast<std::uintptr_t>(watchedKeys.data());
+        std::lock_guard watchedLock(AgcDriver::GuestMemory::GpuMutex());
+        Require(AgcDriver::GuestMemory::Watched(surface.dccAddress, keyCount),
+                "depth/color DCC: registered watched metadata is not visible to GuestMemory");
+        auto watchedWitness = AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes);
+        Require(watchedWitness.has_value() && watchedWitness->generation != 0,
+                "depth/color DCC: strict witness did not retain a real write-watch generation");
+        watchedKeys.data()[65536u] = std::byte{0x5c};
+        const auto unrelatedGeneration = AgcDriver::GuestMemory::CollectWritesUncached(
+            reinterpret_cast<std::uintptr_t>(watchedKeys.data() + 65536u), 1u);
+        Require(unrelatedGeneration > watchedWitness->generation,
+                "depth/color DCC: unrelated write did not advance the tracker watermark");
+        auto unrelatedObserved = AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes);
+        Require(unrelatedObserved.has_value() &&
+                    AgcDriver::Graphics::SameCurrentUncompressedDccWitness(*watchedWitness, *unrelatedObserved),
+                "depth/color DCC: unrelated range write invalidated a still-current metadata witness");
+        watchedKeys.data()[0] = std::byte{0xfe};
+        Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes).has_value(),
+                "depth/color DCC: watched key mutation did not invalidate strict scan");
+        watchedKeys.data()[0] = std::byte{0xff};
+        auto restored = AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, surfaceBytes);
+        Require(restored.has_value() && !AgcDriver::Graphics::SameCurrentUncompressedDccWitness(*watchedWitness, *restored),
+                "depth/color DCC: watched generation did not invalidate an all-ff key witness");
+    }
+#endif
+}
+
+template<typename DccBlock>
+void Run(AgcDriver::VulkanDevice& device, GuestBlock& guest, DccBlock& dcc) {
+    RequireFormat71CrossBlockOffsets();
+    AgcDriver::Graphics::GuestTextureResource producer{};
+    producer.width = ProducerWidth;
+    producer.height = ProducerHeight;
+    producer.mipCount = 1;
+    producer.tileMode = TextureTileMode::kR64KBX;
+    producer.dimension = TextureDimension::k2D;
+    producer.format = FormatRGBA16Float;
+    producer.dccAddress = reinterpret_cast<std::uintptr_t>(dcc.data());
+    producer.dccPipeAligned = true;
+    producer.dccAlphaOnMsb = true;
+    const auto producerBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+    const auto keyCount = AgcDriver::Graphics::DccKeyCount(producer, producerBytes);
+    Require(producerBytes == 262144u && keyCount == 1024u && dcc.size() >= keyCount,
+            "depth/color DCC: fixture does not match 192x108 guest71/VK97 native-shaped storage");
+    // Initialize the full metadata allocation before creating any owner or recipe. Descriptor
+    // mismatch negatives below consume these already-ff bytes and must not mutate watched keys.
+    std::fill_n(dcc.data(), dcc.size(), std::byte{0xff});
+    if (dcc.watched()) Require(AgcDriver::GuestMemory::Watched(producer.dccAddress, keyCount),
+                               "depth/color DCC: watched fixture lost real write-watch coverage before use");
+    std::fill_n(guest.data(), static_cast<std::size_t>(producerBytes), std::byte{0x20});
+    std::fill(guest.data() + producerBytes, guest.data() + guest.size(), std::byte{0x5a});
+    const std::vector<std::byte> baseline(guest.data(), guest.data() + guest.size());
+    std::vector<std::byte> expected = baseline;
+    constexpr std::array<std::byte, 8> whiteHalf{std::byte{0x00}, std::byte{0x3c}, std::byte{0x00}, std::byte{0x3c},
+                                                  std::byte{0x00}, std::byte{0x3c}, std::byte{0x00}, std::byte{0x3c}};
+    for (std::uint32_t y = TileHeight; y < TileHeight + 2u; ++y) {
+        for (std::uint32_t x = 0; x < 2u; ++x) {
+            const auto offset = SurfaceOffset(ProducerWidth, ProducerHeight, x, y);
+            std::copy(whiteHalf.begin(), whiteHalf.end(), expected.begin() + static_cast<std::ptrdiff_t>(offset));
+        }
+    }
+    const auto waveSize = device.Target().subgroupSize >= 64u ? 64u : 32u;
+    const auto changed = SurfaceOffset(ProducerWidth, ProducerHeight, 0, TileHeight);
+    SetSamples(ProducerWidth, ProducerHeight, true);
+    const auto sample = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth, ProducerHeight);
+    RequireRawSampleSpirv(sample);
+    const bool resident = std::getenv("APS5_NO_RESIDENT_TARGETS") == nullptr;
+    if (resident) {
+        // Prime the ordinary Stage-A image before the depth bind. Reusing this consumer after the
+        // bind must take the owner proof rather than returning the pre-bind cached image.
+        DispatchAndWait(device, sample);
+        DrawPartialColor(device, guest.data(), dcc.data(), waveSize, guest.data());
+        Require(guest.data()[changed] == std::byte{0x20}, "depth/color DCC: resident owner wrote guest bytes before sample");
+    } else {
+        RebindDepthOnly(device, guest.data(), waveSize);
+        ExpectUnsupported(device, sample, "depth alias before completed publication");
+        DrawPartialColor(device, guest.data(), dcc.data(), waveSize);
+    }
+
+    DispatchAndWait(device, sample);
+    if (!std::equal(expected.begin(), expected.end(), guest.data())) {
+        std::fprintf(stderr, "[dcc-byte-oracle] producer span mismatch; first differing offsets (actual/expected):\n");
+        std::size_t shown = 0;
+        for (std::size_t offset = 0; offset < expected.size() && shown < 16; ++offset) {
+            if (guest.data()[offset] == expected[offset]) continue;
+            std::fprintf(stderr, "[dcc-byte-oracle] %zu: 0x%02x / 0x%02x\n", offset,
+                         std::to_integer<unsigned int>(guest.data()[offset]),
+                         std::to_integer<unsigned int>(expected[offset]));
+            ++shown;
+        }
+        std::size_t changedTotal = 0;
+        shown = 0;
+        for (std::size_t offset = 0; offset < baseline.size(); ++offset) {
+            if (guest.data()[offset] == baseline[offset]) continue;
+            ++changedTotal;
+            if (shown < 16) {
+                std::fprintf(stderr, "[dcc-byte-oracle] vs initial %zu: 0x%02x / 0x%02x\n", offset,
+                             std::to_integer<unsigned int>(guest.data()[offset]),
+                             std::to_integer<unsigned int>(baseline[offset]));
+                ++shown;
+            }
+        }
+        std::fprintf(stderr, "[dcc-byte-oracle] total bytes changed vs initial guest: %zu / %zu\n",
+                     changedTotal, baseline.size());
+        constexpr std::size_t diagnosticBlockBytes = 65536;
+        for (std::size_t begin = 0; begin < baseline.size(); begin += diagnosticBlockBytes) {
+            const auto end = std::min(begin + diagnosticBlockBytes, baseline.size());
+            std::size_t blockChanged = 0;
+            for (std::size_t offset = begin; offset < end; ++offset) {
+                blockChanged += guest.data()[offset] != baseline[offset];
+            }
+            const auto region = begin < producerBytes ? "producer" : "padding";
+            std::fprintf(stderr, "[dcc-byte-oracle] %s block [%zu,%zu): %zu bytes changed\n",
+                         region, begin, end, blockChanged);
+        }
+        if (Output != nullptr) {
+            std::fprintf(stderr, "[dcc-byte-oracle] first GPU outputs: %.9g %.9g %.9g %.9g\n",
+                         static_cast<double>(Output[0]), static_cast<double>(Output[1]),
+                         static_cast<double>(Output[2]), static_cast<double>(Output[3]));
+        }
+    }
+    Require(std::equal(expected.begin(), expected.end(), guest.data()),
+            "depth/color DCC: complete producer span or padding differs from descriptor-derived byte oracle");
+    RequireSampleOracle(expected, ProducerWidth, ProducerHeight, true);
+    Require(std::all_of(dcc.data(), dcc.data() + keyCount, [](std::byte value) { return value == std::byte{0xff}; }),
+            "depth/color DCC: physical key span is not all 0xff after successful draw");
+    if (dcc.watched()) Require(AgcDriver::GuestMemory::Watched(producer.dccAddress, keyCount),
+                               "depth/color DCC: DCC metadata unexpectedly lost write-watch coverage through rendering");
+
+    const auto wrongExtent = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth - 1u, ProducerHeight);
+    ExpectUnsupported(device, wrongExtent, "same-span but different DCC extent");
+    const auto wrongAddress = CompileSample(device, guest.data(), dcc.data() + 256u, waveSize, ProducerWidth, ProducerHeight);
+    ExpectUnsupported(device, wrongAddress, "different DCC metadata address");
+    const auto wrongPipeAlignment = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth, ProducerHeight,
+                                                 FormatRGBA16Float, false, true);
+    ExpectUnsupported(device, wrongPipeAlignment, "different DCC pipe-alignment descriptor");
+    const auto wrongAlphaPosition = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth, ProducerHeight,
+                                                  FormatRGBA16Float, true, false);
+    ExpectUnsupported(device, wrongAlphaPosition, "different DCC alpha-position descriptor");
+    const auto wrongFormat = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth, ProducerHeight, 56);
+    ExpectUnsupported(device, wrongFormat, "different guest color format");
+
+    const auto recipe = DispatchThroughResourceProof(device, sample);
+    RequireSampleOracle(expected, ProducerWidth, ProducerHeight, true);
+    auto byteMutationHit = device.PrepareRecipe(recipe, false);
+    Require(byteMutationHit != nullptr, "depth/color DCC: valid DCC recipe did not precheck before byte mutation");
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        dcc.data()[0] = std::byte{0x00};
+    }
+    RequireRecipeProofRejects(device, sample, byteMutationHit, "one-byte DCC mutation after owner publication",
+                               reinterpret_cast<std::uintptr_t>(guest.data()), FormatRGBA16Float,
+                               VK_FORMAT_R16G16B16A16_SFLOAT, 7u);
+    ExpectUnsupported(device, sample, "one-byte DCC mutation after owner publication");
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        dcc.data()[0] = std::byte{0xff};
+    }
+    DrawPartialColor(device, guest.data(), dcc.data(), waveSize, guest.data());
+    DispatchAndWait(device, sample);
+    RequireSampleOracle(expected, ProducerWidth, ProducerHeight, true);
+    const auto allocationRecipe = DispatchThroughResourceProof(device, sample);
+    auto allocationMutationHit = device.PrepareRecipe(allocationRecipe, false);
+    Require(allocationMutationHit != nullptr, "depth/color DCC: valid DCC recipe did not precheck before allocation replacement");
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        dcc.ReRegisterWithoutDepthRebind();
+    }
+    RequireRecipeProofRejects(device, sample, allocationMutationHit, "DCC allocation identity replacement after owner publication",
+                               reinterpret_cast<std::uintptr_t>(guest.data()), FormatRGBA16Float,
+                               VK_FORMAT_R16G16B16A16_SFLOAT, 7u);
+    ExpectUnsupported(device, sample, "DCC allocation identity replacement after owner publication");
+}
+
+void RunFourByteSuffixProof(AgcDriver::VulkanDevice& device, GuestBlock& guest, GuestBlock& dcc) {
+    // The no-resident process exercises the separate completed-publication path above; run this
+    // suffix-specific cache regression in the resident process so the ordinary fast lookup and
+    // reusable recipe both see the same owner certificate.
+    if (std::getenv("APS5_NO_RESIDENT_TARGETS") != nullptr) return;
+    AgcDriver::Graphics::GuestTextureResource producer{};
+    producer.baseAddress = reinterpret_cast<std::uintptr_t>(guest.data());
+    producer.width = ProducerWidth;
+    producer.height = ProducerHeight;
+    producer.mipCount = 1;
+    producer.tileMode = TextureTileMode::kR64KBX;
+    producer.dimension = TextureDimension::k2D;
+    producer.format = 56;
+    producer.dccAddress = reinterpret_cast<std::uintptr_t>(dcc.data());
+    producer.dccPipeAligned = true;
+    producer.dccAlphaOnMsb = true;
+    const auto surfaceBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+    const auto keyCount = AgcDriver::Graphics::DccKeyCount(producer, surfaceBytes);
+    Require(surfaceBytes == 131072u && keyCount == 4096u && keyCount > surfaceBytes / 256u,
+            "depth/color DCC: 192x108 4Bpp fixture lost its full 4096-key suffix geometry");
+    std::fill_n(dcc.data(), keyCount, std::byte{0xff});
+    std::fill_n(guest.data(), static_cast<std::size_t>(surfaceBytes), std::byte{0x20});
+    std::fill(guest.data() + surfaceBytes, guest.data() + guest.size(), std::byte{0x5a});
+    const std::vector<std::byte> baseline(guest.data(), guest.data() + guest.size());
+    std::vector<std::byte> expected = baseline;
+    const auto block = AgcDriver::Graphics::ThinBlockLayout(TextureTileMode::kR64KBX, 4);
+    Require(block[0] == 65536u, "depth/color DCC: unexpected R64KBX RGBA8 macro-tile byte size");
+    constexpr std::array<std::byte, 4> white{std::byte{0xff}, std::byte{0xff}, std::byte{0xff}, std::byte{0xff}};
+    for (std::uint32_t y = TileHeight; y < TileHeight + 2u; ++y) {
+        for (std::uint32_t x = 0; x < 2u; ++x) {
+            const auto offset = SurfaceOffsetFor(56, ProducerWidth, ProducerHeight, x, y);
+            std::copy(white.begin(), white.end(), expected.begin() + static_cast<std::ptrdiff_t>(offset));
+        }
+    }
+    const auto waveSize = device.Target().subgroupSize >= 64u ? 64u : 32u;
+    SetSamples(ProducerWidth, ProducerHeight, true);
+    const auto sample = CompileSample(device, guest.data(), dcc.data(), waveSize, ProducerWidth, ProducerHeight, 56);
+    RequireRawSampleSpirv(sample);
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        Require(AgcDriver::Graphics::TextureClearKeys(producer, surfaceBytes) == AgcDriver::Graphics::DccKeys::Uncompressed,
+                "depth/color DCC: prefix keys were not uncompressed before suffix regression");
+    }
+    DispatchAndWait(device, sample); // Prime the ordinary Stage-A image before the depth bind.
+    DrawPartialColor(device, guest.data(), dcc.data(), waveSize, guest.data(), 56);
+    Require(std::equal(baseline.begin(), baseline.end(), guest.data()),
+            "depth/color DCC: resident RGBA8 draw changed guest bytes before the consumer refresh");
+    DispatchAndWait(device, sample);
+    Require(std::equal(expected.begin(), expected.end(), guest.data()),
+            "depth/color DCC: RGBA8 full guest span/padding differs after sample");
+    for (std::uint32_t tid = 0; tid < Threads; ++tid) {
+        const auto x = tid % 4u;
+        const auto y = TileHeight + tid / 4u;
+        const auto offset = SurfaceOffsetFor(56, ProducerWidth, ProducerHeight, x, y);
+        const auto value = static_cast<float>(std::to_integer<std::uint8_t>(expected[offset])) / 255.0f;
+        Require(std::fabs(Output[tid] - value) < 1e-4f,
+                "depth/color DCC: RGBA8 sampled value differs from the physical byte oracle");
+    }
+    const auto recipe = DispatchThroughResourceProof(device, sample);
+    auto suffixMutationHit = device.PrepareRecipe(recipe, false);
+    Require(suffixMutationHit != nullptr, "depth/color DCC: valid 4Bpp recipe did not precheck before suffix mutation");
+    {
+        std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+        dcc.data()[surfaceBytes / 256u] = std::byte{0x00}; // first key beyond the legacy span/256 prefix
+        Require(AgcDriver::Graphics::TextureClearKeys(producer, surfaceBytes) == AgcDriver::Graphics::DccKeys::Uncompressed,
+                "depth/color DCC: suffix mutation unexpectedly changed the legacy prefix classification");
+    }
+    RequireRecipeProofRejects(device, sample, suffixMutationHit, "4Bpp suffix-only key mutation",
+                               reinterpret_cast<std::uintptr_t>(guest.data()), 56u,
+                               VK_FORMAT_R8G8B8A8_UNORM, 7u);
+    ExpectUnsupported(device, sample, "4Bpp suffix-only key mutation");
+}
+
+void RunPendingKeyRegistryTest(AgcDriver::VulkanDevice& device, GuestBlock& guest, GuestBlock& dcc) {
+    AgcDriver::Graphics::GuestTextureResource surface{};
+    surface.baseAddress = reinterpret_cast<std::uintptr_t>(guest.data());
+    surface.width = ProducerWidth;
+    surface.height = ProducerHeight;
+    surface.mipCount = 1;
+    surface.tileMode = TextureTileMode::kR64KBX;
+    surface.dimension = TextureDimension::k2D;
+    surface.format = FormatRGBA16Float;
+    surface.dccAddress = reinterpret_cast<std::uintptr_t>(dcc.data());
+    surface.dccPipeAligned = true;
+    surface.dccAlphaOnMsb = true;
+    const auto bytes = AgcDriver::Graphics::DescribeSurface(surface).guestBytes;
+    const auto keyCount = AgcDriver::Graphics::DccKeyCount(surface, bytes);
+    std::fill_n(dcc.data(), keyCount, std::byte{0xff});
+    std::lock_guard gpuLock(AgcDriver::GuestMemory::GpuMutex());
+    auto* const recorder = AgcDriver::Graphics::Recorder::Active();
+    Require(recorder != nullptr, "depth/color DCC: fixture has no active recorder for pending-write proof");
+    // Queue an uncompressed-fill memo, then a newer writer over the same metadata. The strict
+    // predicate must reject without consuming or syncing either pending range.
+    recorder->NotePendingFill(surface.dccAddress, keyCount, 0xff);
+    AgcDriver::Graphics::NoteKeysFillOnGpu(surface.dccAddress, keyCount, AgcDriver::Graphics::DccKeys::Uncompressed);
+    recorder->NotePendingWrite(surface.dccAddress, keyCount);
+    const auto writeGeneration = AgcDriver::Graphics::Recorder::WriteGeneration();
+    const auto publishGeneration = AgcDriver::Graphics::Recorder::PublishGeneration();
+    Require(recorder->PendingWriteOverlaps(surface.dccAddress, keyCount),
+            "depth/color DCC: pending metadata writer was not recorded by the fixture");
+    Require(!AgcDriver::Graphics::TryReadCurrentUncompressedDccKeys(surface, bytes).has_value(),
+            "depth/color DCC: strict witness trusted a pending own-fill memo or newer overlapping writer");
+    Require(recorder->PendingWriteOverlaps(surface.dccAddress, keyCount) &&
+                AgcDriver::Graphics::Recorder::WriteGeneration() == writeGeneration &&
+                AgcDriver::Graphics::Recorder::PublishGeneration() == publishGeneration,
+            "depth/color DCC: strict witness synchronized, consumed, or changed the pending writer registry");
+    device.WaitIdle();
+    Require(!recorder->PendingWriteOverlaps(surface.dccAddress, keyCount),
+            "depth/color DCC: pending writer fixture did not retire after explicit device drain");
+}
+}
+
+int main() {
+    try {
+#ifdef _WIN32
+        _putenv_s("APS5_CAPTURE_TRACE", "1");
+#else
+        setenv("APS5_CAPTURE_TRACE", "1", 1);
+#endif
+        const char* branch = std::getenv("APS5_DCC_TEST_BRANCH");
+        Require(branch != nullptr && (std::string_view(branch) == "resident" || std::string_view(branch) == "publication"),
+                "depth/color DCC: APS5_DCC_TEST_BRANCH must be explicitly set to resident or publication");
+#ifdef _WIN32
+        _putenv_s("APS5_NO_RESIDENT_TARGETS", std::string_view(branch) == "publication" ? "1" : "");
+#else
+        if (std::string_view(branch) == "publication") setenv("APS5_NO_RESIDENT_TARGETS", "1", 1);
+        else unsetenv("APS5_NO_RESIDENT_TARGETS");
+#endif
+        RunStrictKeyWitnessTest();
+        GuestBlock inputBuffer(sizeof(float) * Threads * 3u);
+        GuestBlock outputBuffer(sizeof(float) * Threads);
+        GuestBlock extraBuffer(sizeof(std::uint32_t) * Threads * 3u);
+        AgcDriver::Graphics::GuestTextureResource producer{};
+        producer.width = ProducerWidth;
+        producer.height = ProducerHeight;
+        producer.mipCount = 1;
+        producer.tileMode = TextureTileMode::kR64KBX;
+        producer.dimension = TextureDimension::k2D;
+        producer.format = FormatRGBA16Float;
+        const auto producerBytes = AgcDriver::Graphics::DescribeSurface(producer).guestBytes;
+        GuestBlock guest(static_cast<std::size_t>(producerBytes) + 65536u);
+        GuestBlock suffixGuest(static_cast<std::size_t>(producerBytes) + 65536u);
+        GuestBlock suffixDcc(65536u);
+        GuestBlock pendingDcc(65536u);
+        GuestBlock dccUnwatched(65536u);
+#ifndef _WIN32
+        std::unique_ptr<WatchedGuestBlock> watchedDcc;
+        if (std::getenv("APS5_DCC_TEST_UNWATCHED") == nullptr && GuestWriteWatch::GuestWriteWatchAvailable_nid_postfix()) {
+            watchedDcc = std::make_unique<WatchedGuestBlock>(65536u);
+        }
+#endif
+        Input = reinterpret_cast<float*>(inputBuffer.data());
+        Output = reinterpret_cast<float*>(outputBuffer.data());
+        Extra = reinterpret_cast<std::uint32_t*>(extraBuffer.data());
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        if (device->Target().subgroupSize < 32u) {
+            std::printf("skipped, subgroup size %u cannot run a wave32 fixture\n", device->Target().subgroupSize);
+            return VulkanTestSkipped;
+        }
+#ifndef _WIN32
+        if (watchedDcc != nullptr) Run(*device, guest, *watchedDcc);
+        else Run(*device, guest, dccUnwatched);
+        RunPendingKeyRegistryTest(*device, guest, pendingDcc);
+        RunFourByteSuffixProof(*device, suffixGuest, suffixDcc);
+#else
+        Run(*device, guest, dccUnwatched);
+#endif
+        std::puts("depth/color DCC owner test passed");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}

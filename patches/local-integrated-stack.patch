+            resource.baseAddress != target.address || resource.format != 1u || resource.tileMode != TextureTileMode::kStandard256B ||
+            resource.dimension != TextureDimension::k2D || resource.mipCount != 1 ||
+            (resource.allocatedMipCount != 0 && resource.allocatedMipCount != 1) || mip != 0 ||
+            resource.baseLevel != 0 || resource.lastLevel != 0 || resource.baseArray != 0 || resource.depthOrLastArray != 0 || resource.dccAddress != 0 ||
+            resource.width == 0 || resource.height == 0 || resource.width > target.extent.width || resource.height > target.extent.height ||
+            (resource.width == target.extent.width && resource.height == target.extent.height)) return false;

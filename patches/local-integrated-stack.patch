+void fragmentedHeapMirrorRefreshTests(Device& device) {
+    using namespace AgcDriver::GuestMemory;
+    constexpr std::size_t mirrorCount = 15000;
+    constexpr std::size_t rangeBytes = 131072;
+    constexpr std::size_t gapBytes = 65536;
+    constexpr std::size_t stride = rangeBytes + gapBytes;
+    constexpr std::size_t residentBytes = 4096;
+    constexpr std::size_t arenaBytes = (mirrorCount * stride + 65535u) & ~std::size_t{65535u};
+    const auto& base = device.GetContext();
+    Require(std::getenv("APS5_WATCH_IMAGE_MIRRORS") != nullptr,
+            "fragmented heap mirror fixture requires APS5_WATCH_IMAGE_MIRRORS=1");
+    Require(GuestWriteWatch::GuestWriteWatchAvailable_nid_postfix(),
+            "fragmented heap mirror fixture requires Linux guest write watching");
+    PrepareImportWatch(base);
+    Require(AddressSpaceCounters().enabled,
+            "fragmented heap mirror regression requires the cached address-space path");
+
+    auto context = base;
+    context.hostImportAlignment = 0; // Force writable registered ranges through heap mirrors.
+    auto* arena = static_cast<std::byte*>(AllocateWatched(arenaBytes, 65536));
+    Require(arena != nullptr, "fragmented heap mirror arena could not be write-watched");
+    bool rangesAdded = false;
+    try {
+        for (std::size_t index = 0; index < mirrorCount; ++index) {
+            auto* range = arena + index * stride;
+            std::memset(range, static_cast<int>(index), residentBytes);
+            Require(Watched(reinterpret_cast<std::uint64_t>(range), rangeBytes),
+                    "fragmented heap mirror range is not covered by guest write watch");
+        }
+        {
+            GuestAllocations::Mutation mutation;
+            for (std::size_t index = 0; index < mirrorCount; ++index)
+                mutation.Add(arena + index * stride, rangeBytes, true, true);
+        }
+        rangesAdded = true;
+
+        const auto runPass = [&](const char* label) {
+            const auto started = std::chrono::steady_clock::now();
+            GuestBufferMemory memory(context);
+            memory.AcquireRegistered();
+            memory.Upload(false);
+            const auto elapsed = std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - started).count();
+            std::cout << "Fragmented heap mirror " << label << " CPU wall=" << elapsed
+                      << " ms ranges=" << mirrorCount << '\n';
+        };
+
+        const auto before = MirrorCounters();
+        BumpCollectEpoch();
+        runPass("initial");
+        const auto initial = MirrorCounters();
+        Require(initial.heapMirrors - before.heapMirrors == mirrorCount &&
+                    initial.heapBytes - before.heapBytes == mirrorCount * rangeBytes,
+                "fragmented heap mirror fixture fell back instead of creating every writable mirror");
+        Require(initial.blocksCopied == before.blocksCopied && initial.heapRefills == before.heapRefills,
+                "initial heap mirror acquisition unexpectedly copied a dirty block");
+
+        const auto cacheBefore = AddressSpaceCounters().hits;
+        BumpCollectEpoch();
+        runPass("unchanged");
+        if (std::getenv("APS5_NO_ADDRESS_SPACE_CACHE") == nullptr)
+            Require(AddressSpaceCounters().hits > cacheBefore, "the fragmented heap fixture missed the cached address-space path");
+        const auto unchanged = MirrorCounters();
+        Require(unchanged.heapMirrors == initial.heapMirrors && unchanged.heapBytes == initial.heapBytes &&
+                    unchanged.blocksCopied == initial.blocksCopied && unchanged.heapRefills == initial.heapRefills,
+                "unchanged heap mirror refresh copied/refilled a block or lost a mirror");
+
+        constexpr std::size_t dirtyIndex = mirrorCount / 2;
+        arena[dirtyIndex * stride + 17] ^= std::byte{0x5a};
+        BumpCollectEpoch();
+        runPass("one-range-dirty");
+        const auto dirty = MirrorCounters();
+        Require(dirty.heapMirrors == initial.heapMirrors && dirty.heapBytes == initial.heapBytes &&
+                    dirty.blocksCopied == unchanged.blocksCopied + 1 && dirty.heapRefills == unchanged.heapRefills + 1,
+                "one dirty guest range did not refresh exactly one heap mirror block");
+
+        constexpr std::uint32_t gpuValue = 0x5a69f00du;
+        constexpr std::uint32_t cpuValue = 0xc001d00du;
+        const auto gpuAddress = reinterpret_cast<std::uint64_t>(arena + dirtyIndex * stride);
+        const auto cpuAddress = gpuAddress + rangeBytes / 2;
+        HeapMirrorShaderProbe shader(context);
+        {
+            GuestBufferMemory memory(context);
+            memory.AcquireRegistered();
+            memory.AddWritable(gpuAddress, sizeof(gpuValue));
+            memory.Upload(false);
+            std::uint32_t adjustment = 0;
+            const auto descriptor = memory.Descriptor(gpuAddress, rangeBytes, adjustment);
+            Require(adjustment == 0, "fragmented heap mirror GPU store is unexpectedly unaligned");
+            shader.Store(descriptor);
+            memory.WriteBack();
+        }
+        Require(*reinterpret_cast<volatile const std::uint32_t*>(gpuAddress) == gpuValue,
+                "real GPU fill was not written back to guest memory");
+        const auto beforeCpuWrite = MirrorCounters();
+        *reinterpret_cast<volatile std::uint32_t*>(cpuAddress) = cpuValue;
+
+        const auto readBackValues = [&](const char* label, bool expectCacheHit) {
+            GuestBufferMemory memory(context);
+            const auto addressSpaceBefore = AddressSpaceCounters();
+            memory.AcquireRegistered();
+            const auto addressSpaceAfter = AddressSpaceCounters();
+            if (expectCacheHit) {
+                Require(addressSpaceAfter.hits > addressSpaceBefore.hits,
+                        std::string("cached heap mirror build missed before ") + label);
+            } else {
+                const bool rebuilt = addressSpaceAfter.rebuiltGeneration > addressSpaceBefore.rebuiltGeneration ||
+                                     addressSpaceAfter.rebuiltFirst > addressSpaceBefore.rebuiltFirst ||
+                                     addressSpaceAfter.rebuiltWaiterDrop > addressSpaceBefore.rebuiltWaiterDrop;
+                Require(addressSpaceAfter.hits == addressSpaceBefore.hits && rebuilt,
+                        std::string("registry remap did not rebuild the address space before ") + label);
+            }
+            memory.Upload(false);
+            std::uint32_t adjustment = 0;
+            const auto descriptor = memory.Descriptor(gpuAddress, rangeBytes, adjustment);
+            Require(adjustment == 0, "fragmented heap mirror readback is unexpectedly unaligned");
+            const auto values = shader.Read(descriptor);
+            Require(values[0] == gpuValue && values[1] == cpuValue,
+                    std::string("cached heap mirror GPU readback failed after ") + label +
+                        ": gpu=" + std::to_string(values[0]) + " cpu=" + std::to_string(values[1]));
+        };
+
+        BumpCollectEpoch();
+        readBackValues("CPU refresh", true);
+        const auto afterCpuRefresh = MirrorCounters();
+        Require(afterCpuRefresh.blocksCopied >= beforeCpuWrite.blocksCopied + 1 &&
+                    afterCpuRefresh.blocksCopied <= beforeCpuWrite.blocksCopied + 2 &&
+                    afterCpuRefresh.heapRefills == beforeCpuWrite.heapRefills + 1,
+                "CPU write after GPU WriteBack copied=" + std::to_string(afterCpuRefresh.blocksCopied - beforeCpuWrite.blocksCopied) +
+                " refilled=" + std::to_string(afterCpuRefresh.heapRefills - beforeCpuWrite.heapRefills));
+
+        auto* const remappedRange = arena + dirtyIndex * stride;
+        {
+            GuestAllocations::Mutation mutation;
+            mutation.Protect(remappedRange, rangeBytes, true, false, [&] {
+                Require(mprotect(remappedRange, rangeBytes, PROT_READ) == 0,
+                        "fragmented heap mirror read-only reprotect failed");
+            });
+            mutation.Protect(remappedRange, rangeBytes, true, true, [&] {
+                Require(mprotect(remappedRange, rangeBytes, PROT_READ | PROT_WRITE) == 0,
+                        "fragmented heap mirror writable reprotect failed");
+            });
+        }
+        BumpCollectEpoch();
+        readBackValues("registry protect/remap", false);
+
+        ClearImageMirrors(context.device);
+        {
+            GuestAllocations::Mutation mutation;
+            for (std::size_t index = 0; index < mirrorCount; ++index)
+                mutation.Remove(arena + index * stride);
+        }
+        ReleaseWatched(arena, arenaBytes);
+        arena = nullptr;
+        std::cout << "Fragmented heap mirror refresh regression passed; CPU writes were detected and one block refreshed\n";
+    } catch (...) {
+        ClearImageMirrors(context.device);
+        if (rangesAdded) {
+            GuestAllocations::Mutation mutation;
+            for (std::size_t index = 0; index < mirrorCount; ++index)
+                mutation.Remove(arena + index * stride);
+        }
+        if (arena != nullptr) ReleaseWatched(arena, arenaBytes);
+        throw;
+    }
+}

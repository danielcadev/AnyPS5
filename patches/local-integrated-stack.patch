+class GuestBlock {
+public:
+    explicit GuestBlock(std::size_t bytes) : bytes((bytes + 65535u) & ~std::size_t{65535u}) {
+#ifdef _WIN32
+        block = static_cast<std::byte*>(GuestArena::GuestArenaAllocate_nid_postfix(this->bytes, 65536));
+        Require(block != nullptr, "depth/color handoff: cannot reserve guest bytes");
+        GuestArena::GuestArenaCommit_nid_postfix(block, this->bytes, PAGE_READWRITE, this->bytes);
+#else
+        block = static_cast<std::byte*>(std::aligned_alloc(65536, this->bytes));
+#endif
+        Require(block != nullptr, "depth/color handoff: cannot allocate aligned guest bytes");
+        std::fill_n(block, this->bytes, std::byte{0});
+        GuestAllocations::Mutation().Add(block, this->bytes, true, true);
+    }
+    ~GuestBlock() {
+        if (registered) GuestAllocations::Mutation().Remove(block);
+#ifdef _WIN32
+        GuestArena::GuestArenaReset_nid_postfix(block, bytes);
+        GuestArena::GuestArenaRelease_nid_postfix(block, bytes);
+#else
+        std::free(block);
+#endif
+    }
+    std::byte* data() const { return block; }
+    std::size_t size() const { return bytes; }
+    bool watched() const { return false; }
+    void ReRegisterWithoutDepthRebind() {
+        Require(registered, "depth/color handoff: allocation unexpectedly unregistered");
+        GuestAllocations::Mutation().Remove(block);
+        registered = false;
+        GuestAllocations::Mutation().Add(block, bytes, true, true);
+        registered = true;
+    }
+    void ReRegisterPrefix(std::size_t prefixBytes) {
+        Require(registered && prefixBytes != 0 && prefixBytes < bytes, "depth/color DCC: invalid prefix allocation fixture");
+        GuestAllocations::Mutation().Remove(block);
+        registered = false;
+        GuestAllocations::Mutation().Add(block, prefixBytes, true, true);
+        registered = true;
+    }
+
+private:
+    std::byte* block = nullptr;
+    std::size_t bytes;
+    bool registered = true;
+};

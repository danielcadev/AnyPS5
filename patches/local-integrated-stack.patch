+    bool PreparePlaneExtentAlias(const GuestTextureResource& resource) {
+        if (target.format != VK_FORMAT_D32_SFLOAT_S8_UINT || target.firstSlice != 0 || target.stencilAddress == 0 ||
+            resource.width == 0 || resource.height == 0 || resource.width > target.extent.width || resource.height > target.extent.height ||
+            (resource.width == target.extent.width && resource.height == target.extent.height)) return false;
+        auto canonical = resource;
+        canonical.width = target.extent.width;
+        canonical.height = target.extent.height;
+        const bool stencil = resource.baseAddress == target.stencilAddress;
+        if (stencil && resource.format != 5u) return false;
+        if (!(stencil ? CanStoreStencil(canonical, 0) : CanStoreDepth(canonical, 0))) return false;
+        const auto bytes = DescribeSurface(resource).guestBytes;
+        const auto depthBytes = DepthSliceBytes(target.extent, 4u);
+        const auto stencilBytes = DepthSliceBytes(target.extent, 1u);
+        const bool overlapsStencil = target.address <= target.stencilAddress
+            ? target.stencilAddress - target.address < depthBytes
+            : target.address - target.stencilAddress < stencilBytes;
+        if (bytes == 0 || bytes > (stencil ? stencilBytes : depthBytes) || overlapsStencil) return false;
+        // A read with a different tile-row stride needs physical guest bytes, not a
+        // scaled/cropped native view. Keep this attachment authoritative for later draws.
+        Require(colorOwner.expired() && !publishedColor.has_value(),
+                "depth/stencil extent alias with a color owner is not implemented");
+        // The validated physical planes are disjoint. Publishing the other plane
+        // adds an unrelated readback; attachment resize still publishes both.
+        const auto owner = stencil ? StorageStencil(canonical, 0) : StorageDepth(canonical, 0);
+        owner->WriteBack();
+        return true;
+    }
+
+    void ReleasePlaneExtentStorage(std::shared_ptr<StorageTexture>& storage) {
+        if (storage == nullptr) return;
+        storage->Flush();
+        for (auto it = textures.begin(); it != textures.end();) {
+            if (it->second->SharedStorageSource() == storage) {
+                it->second->MarkReleased();
+                it = textures.erase(it);
+            } else ++it;
+        }
+        storage.reset();
+    }
+
+    std::shared_ptr<StorageTexture> StoragePlaneExtent(const GuestTextureResource& resource) {
+        auto plane = resource;
+        if (resource.baseAddress == target.stencilAddress && resource.format == 1u && resource.tileMode == TextureTileMode::kR64KBX) {
+            // R8_UNORM uses the same physical S8 bytes with a color swizzle. The
+            // canonical descriptor proves the live plane; the returned image keeps
+            // the consumer's format and layout, including normalized storage writes.
+            const auto bytes = DescribeSurface(resource).guestBytes;
+            if (bytes == 0 || bytes > DepthSliceBytes(target.extent, 1u)) return nullptr;
+            plane.format = 5u;
+            plane.tileMode = TextureTileMode::kZ64KBX;
+        }
+        if (!PreparePlaneExtentAlias(plane)) return nullptr;
+        auto& storage = resource.baseAddress == target.stencilAddress ? stencilExtentStorage : depthExtentStorage;
+        // Refresh of the original owner above publishes any pending smaller writer;
+        // refresh below imports the original owner's physical bytes in the new layout.
+        if (storage != nullptr && !Texture::CanCopyFrom(*storage, resource))
+            ReleasePlaneExtentStorage(storage);
+        if (storage == nullptr) {
+            storage = std::make_shared<StorageTexture>(context, *context.detiler, resource, 0);
+            if (auto* recorder = RecorderFor(context)) recorder->Keep(storage);
+        } else storage->Refresh();
+        return storage;
+    }
+
+    void AdoptResizedStorage(std::shared_ptr<StorageTexture> depth, std::shared_ptr<StorageTexture> stencil,
+                             VkImageAspectFlags cleared) {
+        Require(depthStorage == nullptr && stencilStorage == nullptr && depth != nullptr && stencil != nullptr &&
+                    CanStoreDepth(depth->Descriptor(), 0) && depth->StorageFormat() == VK_FORMAT_R32_SFLOAT &&
+                    CanStoreStencil(stencil->Descriptor(), 0) && stencil->StorageFormat() == VK_FORMAT_R8_UINT,
+                "resized depth/stencil storage does not match the attachment");
+        depth->Refresh();
+        stencil->Refresh();
+        const auto depthRange = CurrentPlaneAllocation(depth);
+        const auto stencilRange = CurrentPlaneAllocation(stencil);
+        Require(depthRange != nullptr && stencilRange != nullptr,
+                "resized depth/stencil storage has no live writable guest allocation");
+        const auto pixels = static_cast<std::size_t>(target.extent.width) * target.extent.height;
+        auto depthCopy = std::make_shared<DeviceBuffer>(context, pixels * 4u, VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+        auto stencilCopy = std::make_shared<DeviceBuffer>(context, pixels, VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT);

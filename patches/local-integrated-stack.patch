+void verifyFiniteImageDescriptorWeb() {
+    using namespace ShaderRecompiler;
+    const auto track = [](bool mismatchedCondition, bool mismatchedMask, bool unknownSource, bool pcSource, bool movingBallot) {
+        IrProgram program;
+        program.SetWaveSize(64u);
+        program.Resources().stage = IrShaderStage::Compute;
+        program.Resources().srtPlanComplete = true;
+        auto& entry = program.CreateBlock();
+        auto& left = program.CreateBlock();
+        auto& right = program.CreateBlock();
+        auto& join = program.CreateBlock();
+        program.SetEntryBlock(entry);
+        entry.AddBranch(&left);
+        entry.AddBranch(&right);
+        if (movingBallot) entry.AddBranch(&entry);
+        left.AddBranch(&join);
+        right.AddBranch(&join);
+
+        IrBuilder builder(program);
+        builder.SetInsertionPoint(entry);
+        IrValue& lane = builder.Emit(IrOpcode::LaneId, IrType::U32, {});
+        IrValue& entryActive = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(47u)});
+        IrValue& ballot = builder.Emit(IrOpcode::Ballot, IrType::Vec4U32, {&entryActive});
+        IrValue& low = builder.Emit(IrOpcode::CompositeExtractU32x4, IrType::U32, {&ballot, &builder.Constant(0u)});
+        IrValue& high = builder.Emit(IrOpcode::CompositeExtractU32x4, IrType::U32, {&ballot, &builder.Constant(1u)});
+        IrValue& lowerHalf = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(32u)});
+        IrValue& selectedWord = builder.Emit(IrOpcode::SelectU32, IrType::U32, {&lowerHalf, &low, &high});
+        IrValue& laneBit = builder.Emit(IrOpcode::BitwiseAnd32, IrType::U32, {&lane, &builder.Constant(31u)});
+        IrValue& shifted = builder.Emit(IrOpcode::ShiftRightLogical32, IrType::U32, {&selectedWord, &laneBit});
+        IrValue& bit = builder.Emit(IrOpcode::BitwiseAnd32, IrType::U32, {&shifted, &builder.Constant(1u)});
+        IrValue& entryMask = builder.Emit(IrOpcode::INotEqual32, IrType::Bool, {&bit, &builder.Constant(0u)});
+        IrValue& familyOne = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(16u)});
+        IrValue& familyTwo = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(32u)});
+        IrValue& familyThree = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(48u)});
+        IrValue& narrowMask = builder.Emit(IrOpcode::ULessThan32, IrType::Bool, {&lane, &builder.Constant(32u)});
+        std::array<std::array<IrValue*, 8>, 4> descriptors{};
+        for (std::uint32_t family = 0; family < descriptors.size(); family++) {
+            for (std::uint32_t dword = 0; dword < descriptors[family].size(); dword++) {
+                IrValue& reg = program.CreateValue(IrOpcode::Void, IrType::ScalarReg);
+                reg.SetRegister({RegisterBank::Scalar, family * 8u + dword});
+                IrValue& source = program.CreateValue(IrOpcode::GetUserData, IrType::U32);
+                source.AddArgument(&reg);
+                entry.AppendInstruction(&source);
+                descriptors[family][dword] = &source;
+            }
+        }
+        if (unknownSource) {
+            IrValue& unknown = program.CreateValue(IrOpcode::LoadBufferU32, IrType::U32);
+            descriptors[3][7] = &unknown;
+        } else if (pcSource) {
+            IrValue& shaderBase = builder.Emit(IrOpcode::GetShaderBase, IrType::U64, {});
+            IrValue& lowAddress = builder.Emit(IrOpcode::CompositeExtractU64, IrType::U32, {&shaderBase, &builder.Constant(0u)});
+            descriptors[3][7] = &lowAddress;
+        }
+
+        const auto zero = &builder.Constant(0u);
+        std::array<IrValue*, 8> leftTuple{}, rightTuple{};
+        builder.SetInsertionPoint(left);
+        for (std::uint32_t dword = 0; dword < 8u; dword++) {
+            IrValue* condition = mismatchedCondition && dword == 7u ? &familyThree : &familyOne;
+            IrValue& selected = builder.Emit(IrOpcode::SelectU32, IrType::U32, {condition, descriptors[0][dword], descriptors[1][dword]});
+            leftTuple[dword] = &builder.Emit(IrOpcode::SelectU32, IrType::U32, {&entryMask, &selected, zero});
+        }
+        builder.SetInsertionPoint(right);
+        for (std::uint32_t dword = 0; dword < 8u; dword++) {
+            IrValue& selected = builder.Emit(IrOpcode::SelectU32, IrType::U32, {&familyTwo, descriptors[2][dword], descriptors[3][dword]});
+            rightTuple[dword] = &builder.Emit(IrOpcode::SelectU32, IrType::U32, {&entryMask, &selected, zero});
+        }
+
+        std::array<IrValue*, 8> laneTuple{};
+        for (std::uint32_t dword = 0; dword < 8u; dword++) {
+            IrValue& phi = program.CreateValue(IrOpcode::Phi, IrType::U32);
+            phi.AddPhiOperand(&left, leftTuple[dword]);
+            phi.AddPhiOperand(&right, rightTuple[dword]);
+            join.InsertInstructionBefore(nullptr, &phi);
+            laneTuple[dword] = &phi;
+        }
+        IrValue& maskPhi = program.CreateValue(IrOpcode::Phi, IrType::Bool);
+        maskPhi.AddPhiOperand(&left, &entryMask);
+        maskPhi.AddPhiOperand(&right, &entryMask);
+        join.InsertInstructionBefore(nullptr, &maskPhi);
+
+        std::array<IrValue*, 8> firstLane{};
+        for (std::uint32_t dword = 0; dword < 8u; dword++) {
+            IrValue& mask = mismatchedMask && dword == 7u ? narrowMask : maskPhi;
+            firstLane[dword] = &program.CreateValue(IrOpcode::ReadFirstLane, IrType::U32);
+            firstLane[dword]->AddArgument(laneTuple[dword]);
+            firstLane[dword]->AddArgument(&mask);
+            join.AppendInstruction(firstLane[dword]);
+        }
+        IrValue& image = program.CreateValue(IrOpcode::GetImageResource, IrType::ImageResource);
+        for (IrValue* value : firstLane) image.AddArgument(value);
+        join.AppendInstruction(&image);
+        IrValue& sampler = program.CreateValue(IrOpcode::GetSamplerResource, IrType::SamplerResource);
+        for (const auto value : std::array<std::uint32_t, 4>{0x92u, 0x00fff000u, 0x05500000u, 0u}) sampler.AddArgument(&builder.Constant(value));
+        join.AppendInstruction(&sampler);
+        IrValue& address = program.CreateValue(IrOpcode::MakeImageAddress, IrType::ImageAddress);
+        join.AppendInstruction(&address);
+        MemoryInfo imageMemory;
+        imageMemory.kind = ResourceKind::Image;
+        imageMemory.imageDimension = RdnaImageDimension::Dim2D;
+        program.Resources().memoryInfo.push_back(imageMemory);
+        MemoryFlags flags{0u, 0x66cu};
+        IrValue& sample = program.CreateValue(IrOpcode::ImageSampleRaw, IrType::U32x4);
+        sample.SetFlags(flags);
+        sample.AddArgument(&image);
+        sample.AddArgument(&sampler);
+        sample.AddArgument(&address);
+        sample.AddArgument(&maskPhi);
+        join.AppendInstruction(&sample);
+
+        ResourceTracker{}.Track(program);
+        return program.Resources().info.images.size();
+    };
+
+    require(track(false, false, false, false, false) == 4u, "finite image descriptor web: coherent 8-word selection created a Cartesian resource cross product or retained the inactive zero tuple");
+    expectFailure([&] { static_cast<void>(track(true, false, false, false, false)); }, "GetImageResource dword 0 is not a valid runtime value", "finite image descriptor web: mismatched Select conditions were accepted");
+    expectFailure([&] { static_cast<void>(track(false, true, false, false, false)); }, "GetImageResource dword 0 is not a valid runtime value", "finite image descriptor web: mismatched ReadFirstLane masks were accepted");
+    expectFailure([&] { static_cast<void>(track(false, false, true, false, false)); }, "GetImageResource dword 0 is not a valid runtime value", "finite image descriptor web: unknown tuple source was accepted");
+    expectFailure([&] { static_cast<void>(track(false, false, false, true, false)); }, "GetImageResource dword 0 is not a valid runtime value", "finite image descriptor web: program-counter-derived tuple source was accepted");
+    expectFailure([&] { static_cast<void>(track(false, false, false, false, true)); }, "GetImageResource dword 0 is not a valid runtime value", "finite image descriptor web: loop-varying ballot was accepted as an entry mask");
+}
